{
	"name": "codegen",
	"description": "Silver's LLVM backend: textual IR generation and linking with clang.",
	"targetType": "library",
	"dependencies": {
		"silver:ast": "*",
		"silver:core": "*",
		"silver:sema": "*"
	},
	"preGenerateCommands-posix": ["\"$DUB\" build :runtime --root=\"$PACKAGE_DIR..\" --build=plain && \"$PACKAGE_DIR../ship.sh\" runtime/libsilver_rt.a runtime/libphobos2.a"],
	"preGenerateCommands-windows": ["\"$DUB\" build :runtime --root=\"$PACKAGE_DIR..\" --build=plain && \"$PACKAGE_DIR..\\ship.cmd\" runtime\\silver_rt.lib runtime\\phobos64.lib runtime\\mingw"],
	"configurations": [
		{ "name": "library" },
		{
			"name": "unittest",
			"targetPath": "../build",
			"dependencies": {
				"silver:testrunner": "*",
				"fluent-asserts": "~>2.1",
				"silver:loader": "*"
			},
			"libs-windows": ["psapi"],
			"lflags-windows": ["/STACK:67108864"]
		}
	]
}
