{
	"authors": [
		"Jason Yegge"
	],
	"subPackages": [
		"./ast/",
		"./syntax/",
		"./loader/",
		"./sema/",
		"./core/",
		"./interpreter/",
		"./runtime/",
		"./codegen/",
		"./testing/",
		"./conformance/",
		"./frontend/",
		"./stampversion/",
		"./testrunner/"
	],
	"license": "MIT",
	"copyright": "Copyright © 2026, Jason Yegge",
	"name": "silver",
	"description": "A simple experimental programming language.",
	"dependencies": {
		"silver:core": "*",
		"silver:interpreter": "*",
		"silver:sema": "*",
		"silver:loader": "*",
		"silver:codegen": "*",
		"silver:testing": "*"
	},
	"targetType": "executable",
	"stringImportPaths": ["generated"],
	"targetPath": "build",
	"configurations": [
		{
			"name": "application",
			"targetName": "silverc",
			"postBuildCommands-posix": ["\"$PACKAGE_DIR./ship.sh\" silver silverc"],
			"postBuildCommands-windows": ["\"$PACKAGE_DIR.\\ship.cmd\" silver.exe silverc.exe"],
			"preGenerateCommands-posix": ["\"$DUB\" build :frontend --root=\"$PACKAGE_DIR.\""],
			"preGenerateCommands-windows": ["\"$DUB\" build :frontend --root=\"$PACKAGE_DIR.\""]
		},
		{
			"name": "unittest",
			"targetName": "silver-test-application",
			"preGenerateCommands-posix": ["\"$DUB\" build :stampversion --root=\"$PACKAGE_DIR.\" && \"$PACKAGE_DIR./build/stampversion\" \"$PACKAGE_DIR./generated/version.txt\" \"$PACKAGE_DIR.\""],
			"preGenerateCommands-windows": ["\"$DUB\" build :stampversion --root=\"$PACKAGE_DIR.\" && \"$PACKAGE_DIR.\\build\\stampversion.exe\" \"$PACKAGE_DIR.\\generated\\version.txt\" \"$PACKAGE_DIR.\""],
			"dependencies": {
				"fluent-asserts": "~>2.1"
			}
		}
	],
	"lflags-windows": ["/STACK:67108864"]
}