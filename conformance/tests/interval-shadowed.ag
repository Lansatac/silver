// A module's own `Interval` and `contains` don't change what `a..b` builds or what it calls.
type Interval(low: Int, high: Int)

def contains(r: Interval, value: Int): Bool => value >= r.low && value <= r.high

def opIndex<T>(values: [T], r: Interval): [T] => values[r.low..r.high + 1]

def main(): Unit {
    val mine = Interval(1, 3)
    printl(mine.contains(3))
    printl([10, 20, 30, 40][mine])

    val built = 1..3
    printl(built.contains(3))
    printl(length(built))
    printl([10, 20, 30, 40][built])
}
