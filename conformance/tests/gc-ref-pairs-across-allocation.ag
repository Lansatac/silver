// Two `Ref`s are loaded from an array nothing else holds, kept while a great deal is allocated,
// and then stored. Their cells have to survive every collection in between.
import std.ref

type Link(a: Ref<Int>, b: Ref<Int>)

def noise(seed: Int, count: Int): Int {
    mutable val keep: [Ref<Int>] = []
    for i in 0..count { keep = [Ref(seed + i), Ref(i)] }
    keep[0].get() - seed - count + 1
}

def pick(xs: [Link], seed: Int, count: Int): [Link] {
    val l = xs[0]
    val zero = noise(seed, count)
    [l]
}

def one(i: Int): [Link] => [Link(Ref(i), Ref(i + 1))]

def main(): Unit {
    mutable val wrong = 0
    for i in 0..8 {
        val got = pick(one(i), i, 40000)
        if got[0].a.get() != i || got[0].b.get() != i + 1 { wrong += 1 }
    }
    printl(wrong)
}
