type Point(x: Int, y: Int)

def main(): Unit {
    val t = (1, "a")
    printl(t == (1, "a"))
    printl(t != (1, "a"))
    printl(t == (2, "a"))
    printl(t == (1, "b"))
    printl((1, "a") == t)

    val bytes: (UInt8, UInt8) = (1, 2)
    printl(bytes == (1, 2))
    printl(bytes == (2, 1))

    printl(((1, 2), 3) == ((1, 2), 3))
    printl(((1, 2), 3) == ((1, 9), 3))
    printl((Some(1), 1 == 1) == (Some(1), true))
    val maybe: (Int, Int?) = (1, None)
    printl(maybe == (1, None))
    printl(maybe == (1, Some(2)))
    printl(([1, 2], "x") == ([1, 2], "x"))
    printl(([1, 2], "x") == ([1], "x"))
    printl((Point(1, 2), 3) == (Point(1, 2), 3))
    printl((Point(1, 2), 3) == (Point(2, 1), 3))
    printl(((), 1) == ((), 1))
    printl(((), ()) == ((), ()))

    val some: (Int, Int)? = (1, 2)
    printl(some == (1, 2))
    printl(some == None)
    printl([(1, 2), (3, 4)] == [(1, 2), (3, 4)])
    printl([(1, 2), (3, 4)] == [(1, 2), (3, 5)])

    // NaN isn't equal to itself, in a tuple too.
    val zero = 0.0
    printl((zero / zero, 1) == (zero / zero, 1))
    printl((zero / zero, 1) != (zero / zero, 1))
}
