// `x[a..b] = v` is `x = opIndexAssign(x, a..b, v)`, as `x[r] = v` is with the interval held.
type Cells(items: [Int])

def opIndex(c: Cells, part: Interval<Int>): Cells => Cells(c.items[part])

def opIndexAssign(c: Cells, part: Interval<Int>, value: Cells): Cells =>
    Cells(c.items[..part.from] ~ value.items ~ c.items[part.to..])

def main(): Unit {
    mutable val held = Cells([1, 2, 3, 4])
    val r = 1..3
    held[r] = Cells([9])
    printl(held)

    mutable val written = Cells([1, 2, 3, 4])
    written[1..3] = Cells([9])
    printl(written)
}
