// A collection that isn't a range says which range steps it, and `for` loops over that.
type Shelf(books: [String])
type Books(left: [String])

def next(b: Books): (String, Books)? =>
    if length(b.left) == 0 => None else (b.left[0], Books(b.left[1..]))
conform Books: Range<String>

def iterate(shelf: Shelf): Books {
    printl("iterate")
    Books(shelf.books)
}
conform Shelf: Iterable<Books>

// One that gives an array, and a generic one that gives pairs.
type Row(cells: [Int])
def iterate(row: Row): [Int] => row.cells
conform Row: Iterable<[Int]>

type Table<K, V>(keys: [K], values: [V])
type Entries<K, V>(table: Table<K, V>, at: Int)
def next<K, V>(e: Entries<K, V>): ((K, V), Entries<K, V>)? =>
    if e.at >= length(e.table.keys) => None
    else ((e.table.keys[e.at], e.table.values[e.at]), Entries(e.table, e.at + 1))
conform Entries<K, V>: Range<(K, V)>
def iterate<K, V>(t: Table<K, V>): Entries<K, V> => Entries(t, 0)
conform Table<K, V>: Iterable<Entries<K, V>>

// Every range is an `Iterable` of itself.
type Countdown(from: Int)
def next(c: Countdown): (Int, Countdown)? => if c.from == 0 => None else (c.from, Countdown(c.from - 1))
conform Countdown: Range<Int>

def total<C: Iterable<R>, R: Range<Int>>(items: C): Int {
    mutable val sum = 0
    for item in items {
        sum += item
    }
    sum
}

def names<C: Iterable<R>, R: Range<(String, V)>, V>(items: C): [String] {
    mutable val found: [String] = []
    for (name, _) in items {
        found ~= [name]
    }
    found
}

def main(): Unit {
    val shelf = Shelf(["a", "b", "c"])
    for book in shelf {
        print(book)
    }
    printl("")
    for book in shelf {
        if book == "b" { continue }
        if book == "c" { break }
        printl(book)
    }
    for _ in Shelf([]) {
        printl("never")
    }

    for cell in Row([1, 2, 3]) {
        print(cell)
    }
    printl("")

    val table = Table(["x", "y"], [10, 20])
    for (key, value) in table {
        printl("{key}={value}")
    }
    printl(table.iterate().map(entry => {
        val (_, value) = entry
        value + 1
    }).array())

    for n in Countdown(3) {
        print(n)
    }
    printl("")
    printl(total(Countdown(4)))
    printl(total([1, 2, 3]))
    printl(total(1..4))
    printl(names([("a", 1), ("b", 2)]))

    // So a function over ranges takes a collection as it takes a range.
    printl(table.map(((key, value)) => "{key}{value}").array())
    printl(table.filter(((_, value)) => value > 10).count())
    printl(Shelf(["a", "b", "c"]).drop(1).array())
    printl(Row([3, 1, 2]).sorted())
    printl(Row([3, 1, 2]).zip(Shelf(["x", "y"])).array())
    printl(Row([]).isEmpty())
    printl(Row([5, 6]).fold(0, (a, b) => a + b))

    printl(total(Row([4, 5, 6])))
    printl(names(table))
}
