module queries_support.lib

interface Sized { def length(x: Self): Int }

type Plain(n: Int)
// Only this module sees that a Plain has a length.
private def length(p: Plain): Int => p.n

def width<T>(x: T): String => "unknown width"
def width<T: Sized>(x: T): String => "width {length(x)}"

def measure<T>(x: T): String => width(x)
def measureHere(p: Plain): String => measure(p)
