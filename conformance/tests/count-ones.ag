// `countOnes` counts the bits of a `UInt` that are 1.
import std.math

def slow(value: UInt): Int {
    mutable val left = value
    mutable val count = 0
    while left != 0 {
        left = left & (left - 1)
        count += 1
    }
    count
}

def main(): Unit {
    printl(countOnes(0))
    printl(countOnes(1))
    printl(countOnes(0xFF))
    printl(countOnes(0x8000000000000000))
    printl(countOnes(0xFFFFFFFFFFFFFFFF))
    val mask: UInt = 0xF0F0
    printl(countOnes(mask & 0x0FF0))

    // The index of a child in a node that keeps only the children it has.
    val bitmap: UInt = 0b101101
    val one: UInt = 1
    val bit = one << 3
    printl(countOnes(bitmap & (bit - 1)))

    mutable val agrees = true
    mutable val x: UInt = 1
    for i in 0..200 {
        if countOnes(x) != slow(x) { agrees = false }
        x = (x << 7) ^ (x >> 3) ^ UInt(i)
    }
    printl(agrees)

    val count = countOnes
    printl(count(7))
    printl([1, 3, 7].map(n => countOnes(UInt(n))).array())
}
