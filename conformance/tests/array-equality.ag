type Point(x: Int, xs: [Int])

def main(): Unit {
    val xs = [1, 2]
    printl(xs == [1, 2])
    printl(xs != [1, 2])
    printl([1, 2] == xs)
    printl(xs == [1])
    printl(xs == [1, 3])
    printl(xs == [])
    printl([] == xs)
    val empty: [Int] = []
    printl(empty == [])
    printl(["a"] == ["a"])
    printl(["a"] == ["b"])
    printl([[1], [2]] == [[1], [2]])
    printl([[1], [2]] == [[1], [3]])
    printl([Some(1), None] == [Some(1), None])
    printl(Point(1, [2]) == Point(1, [2]))
    printl(Point(1, [2]) == Point(1, [3]))
    val bytes: [UInt8] = [255]
    printl(bytes == [255])
    val maybe: [Int]? = [1]
    printl(maybe == [1])
    printl(maybe == None)
    printl(maybe == Some([1]))
    // NaN isn't equal to itself, in an array too.
    val zero = 0.0
    printl([zero / zero] == [zero / zero])
    printl(xs[0..1] == [1])
}
