module overloading_support.shapes

type Square(side: Int)
type Circle(radius: Int)

def area(s: Square): Int => s.side * s.side
def area(c: Circle): Int => 3 * c.radius * c.radius

def label(s: Square): String => "square"
private def label(c: Circle): String => "circle"

def encode(s: Square): String => "square {s.side}"
