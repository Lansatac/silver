// gc-derived-pointer-across-allocation, with the array passed as a mutable parameter. Once `walk`
// is inlined, the caller's slot is no longer in memory, so optimized code can keep only xs - 8k
// across the loop's allocations, as it does for a local.
def make(n: Int): [Int] {
    mutable val xs: [Int] = []
    for i in 0..n { xs ~= [i] }
    xs
}

def noise(i: Int): Int {
    if i % 2000 != 0 { return 0 }
    mutable val junk = [-1]
    for j in 0..10 { junk = junk ~ junk }
    mutable val more: [Int] = []
    for j in 0..200 { more ~= junk }
    more[0] + 1
}

def walk(mutable xs: [Int], n: Int, k: Int): Int {
    mutable val sum = 0
    for i in k..n + k { sum += xs[i - k] + noise(i) }
    sum
}

def run(n: Int, k: Int): Int {
    mutable val xs = make(n)
    walk(mutable xs, n, k)
}

def main(): Unit {
    mutable val wrong = 0
    for round in 0..4 {
        if run(20000, 300000000) != 20000 * 19999 / 2 { wrong += 1 }
    }
    printl(wrong)
}
