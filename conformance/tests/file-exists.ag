// exists is true for a file or a directory, and false for nothing, including where a write failed.
import std.file

def main(): Unit ! IoError {
    printl(exists("here.txt"))
    writeFile("here.txt", "")?
    printl(exists("here.txt"))
    printl(exists("."))
    printl(exists("./here.txt"))
    printl(exists("missing"))
    printl(exists("missing/here.txt"))
    printl(exists(""))
    // Cut short at the NUL, the path would name a file that's there.
    writeFile("a", "")?
    printl(exists("a\u{0}b"))
    printl(exists("here.txt/"))
    printl(exists("./"))
    printl(isError(writeFile("missing/here.txt", "x")))
    printl(exists("missing"))
}

def isError(result: Unit ! WriteFailed): Bool => match result {
    Ok(_) => false
    Error(_) => true
}
