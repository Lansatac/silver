static import imports_support.shapes
static import imports_support.labels
import imports_support.labels : twice

// Not ambiguous: neither module's `area` or `describe` is visible unqualified.
def area(n: Int): Int => n + 1
def describe(): String => "own"

def main(): Unit {
    val square: imports_support.shapes.Shape = imports_support.shapes.Square(3.0)
    printl(imports_support.shapes.area(square))
    printl(imports_support.labels.area())
    printl(imports_support.shapes.describe(imports_support.shapes.sides))
    printl(imports_support.labels.describe("x"))
    printl(area(1))
    printl(describe())
    printl(twice(4))
    printl(imports_support.labels.twice(5))
}
