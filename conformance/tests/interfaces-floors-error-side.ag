// The errors after an interface name are written out, so what a body gives for them is checked
// as in any function returning an error union: a literal adapts, and a sum's member fits.

import interfaces_support.floors

type Parse = Empty | BadDigit(at: Int)

def ratio(xs: [Int]): Range<Int> ! Float => if length(xs) == 0 => Error(1) else xs

def parsed(xs: [Int]): Range<Int> ! Parse {
    if length(xs) == 0 { return Error(Empty) }
    if xs[0] < 0 {
        Error(BadDigit(0))
    } else {
        Ok(xs.map(x => x * 10))
    }
}

def main(): Unit {
    match ratio([]) {
        Ok(items) => printl(items)
        Error(part) => printl(part / 2)
    }
    printl(ratio([1]))
    printl(parsed([]))
    printl(parsed([-1]))
    val tens = parsed([2])!
    printl(tens.array())

    val counted = (xs: [Int]): Range<Int> ! UInt8 => if length(xs) > 1 => Error(200) else Ok(xs)
    printl(counted([1, 2]))
    printl(counted([3]))
    val held: [Int] ! Parse = if length(tens.array()) == 0 => Error(BadDigit(7)) else Ok([4])
    printl(held)
}
