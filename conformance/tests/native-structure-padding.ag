// A native structure's padding is zero when C reads its raw bytes, in a register and in memory, though the
// stack the call's frame reuses held other bytes.
import native_structures_support.silverstructs

def dirty(depth: Int): Int => if depth == 0 { 0 } else { -1 + dirty(depth - 1) }

def probe(count: Int32): Unit {
    printl(flagsBytes(Flags(true, false, count)))
    printl(wideBytes(Wide(1, 5, 2, 6)))
}

def main(): Unit {
    printl(dirty(200))
    probe(7)
}
