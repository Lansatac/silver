// A native structure's padding is zero when C reads it: llabs takes the 8 bytes of Flags as the
// integer it is passed as, so garbage in the three padding bytes would change the result.
native type Flags(on: Bool, count: Int32)

native def llabs(flags: Flags): Int64

// Leaves 0xFFFFFFFF-filled stack below the caller for the next call's frame to reuse.
def dirty(depth: Int): Int => if depth == 0 { 0 } else { -1 + dirty(depth - 1) }

def probe(count: Int32): Int64 => llabs(Flags(true, count))

def main(): Unit {
    printl(dirty(200))
    printl(probe(7))
}
