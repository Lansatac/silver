val tag: String = "line: "

def main(): Unit {
    val first = read()! ?? "missing"
    val second = read()! ?? "missing"
    val third = read()! ?? "missing"

    printl(tag ~ first)
    printl(second ~ tag ~ first)
    printl(first == "first")
    printl(first < second)
    printl(second > "é")
    printl(second < third)
    printl("[" ~ third ~ "]")

    // The input ran out
    val end = read()!
    printl(end == None)
    printl(end)
    printl(end ?? "fallback")
    if val text = end {
        printl(text)
    } else {
        printl("done")
    }
    printl(read())
}
