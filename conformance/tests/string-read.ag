val tag: String = "line: "

def main(): Unit {
    val first = read() ?? "missing"
    val second = read() ?? "missing"
    val third = read() ?? "missing"

    print(tag ~ first)
    print(second ~ tag ~ first)
    printl(first == "first\n")
    printl(first < second)
    printl(second > "é")
    printl(second < third)
    print("[" ~ third ~ "]")
    printl("")

    // The input ran out
    val end = read()
    printl(end == None)
    printl(end)
    printl(end ?? "fallback")
    if val text = end {
        printl(text)
    } else {
        printl("done")
    }
    printl(read())
}
