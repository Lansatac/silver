// Integer division truncates toward zero and the remainder takes the dividend's sign,
// whatever the operands' signs
def main(): Unit {
    val a = -7
    val b = 2
    printl(a / b)
    printl(a % b)
    printl(7 / -2)
    printl(7 % -2)
    printl(-7 / -2)
    printl(-7 % -2)
    printl(1 / 3)
    printl(-1 / 3)

    printl(-2 * 3)
    printl(-2 * -3)
    printl(a * b)

    // Unary minus binds looser than power, so -2 ^ 2 is -(2 ^ 2)
    printl(-2 ^ 2)
    printl((-2) ^ 3)
    printl(2 ^ 10)
    printl(2 ^ 0)

    printl(-1 < 1)
    printl(-1 > -2)
    printl(a < b)
    printl(-0 == 0)

    // Float results that are exactly representable, so the printed form isn't in question
    printl(-7.0 / 2.0)
    printl(1.5 * -2.0)
    printl(-1.5 ^ 2)
    printl(10.0 / 4)
}
