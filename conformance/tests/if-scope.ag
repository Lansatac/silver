// Calling a function twice re-declares its block locals each time
def g(): Int => if true {
    val local = 3
    local
} else 0

def main(): Unit {
    // Each block gets its own scope, so a sibling block may declare the same name again
    val a = if true {
        val t = 1
        t
    } else 0
    printl(a)

    val b = if true {
        val t = 2
        t
    } else 0
    printl(b)

    printl(g() + g())

    // Assigning to an outer mutable from inside a block updates the outer binding
    mutable val count = 0
    val c = if true {
        count = count + 5
        count
    } else 0
    printl(c)
    printl(count)
}
