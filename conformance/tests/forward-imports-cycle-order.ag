// In a cycle of forwards each module's own function hides one of the same parameters it gets back
// around the cycle, whichever order the modules are checked in: a, b, c and z, y, x are the same
// cycle named in opposite orders.
import cycle_support.b : who
import cycle_support.y

def main(): Unit {
    printl(who(1))
    printl(cycle_support.y.who(1))
    printl(cycle_support.b.who(1))
}
