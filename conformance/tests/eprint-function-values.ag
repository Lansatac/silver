// eprint and eprintl are functions like any other: they can be passed, stored, compared and printed.
type Point(x: Int, y: Int)
type Printer(name: String, write: (Point) -> Unit)

def each<T>(values: [T], f: (T) -> Unit): Unit {
    for value in values { f(value) }
}

def twice(f: (String) -> Unit, text: String): Unit {
    f(text)
    f(text)
}

def main(): Unit {
    each([1, 2, 3], eprintl)
    each(["a", "b", "c"], eprint)
    eprintl()
    each([Some(Point(1, 2)), None], eprintl)
    twice(eprint, "ab")
    twice(eprintl, "cd")

    val line: (Float) -> Unit = eprintl
    line(0.5)
    val writers: [(Int) -> Unit] = [eprint, eprintl]
    for write in writers { write(9) }
    val printer = Printer("lines", eprintl)
    printer.write(Point(3, 4))
    eprintl(printer)

    val f = eprint<Int>
    f(1)
    eprintl()
    eprintl(f)
    val g: (Int) -> Unit = eprint
    eprintl(f == g)
    val h: (String) -> Unit = eprint
    eprintl(h)
    val l: (Bool) -> Unit = eprintl
    eprintl(l)
    printl("standard output")
}
