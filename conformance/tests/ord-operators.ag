// `<`, `<=`, `>` and `>=` on a type that isn't a number, a String or a Char call the `compare` of
// its conformance to `Ord`.
type Card(rank: Int, suit: Int)
def compare(a: Card, b: Card): Ordering => compare((a.rank, a.suit), (b.rank, b.suit))
conform Card: Ord

type Box<T>(value: T)
def compare<T: Ord>(a: Box<T>, b: Box<T>): Ordering => compare(a.value, b.value)
conform Box<T>: Ord when T: Ord

def smaller<T: Ord>(a: T, b: T): T => if a < b => a else b
def largest<T: Ord>(values: [T], start: T): T {
    mutable val best = start
    for v in values {
        if v > best { best = v }
    }
    best
}
def between<T: Ord>(low: T, value: T, high: T): Bool => low <= value && value <= high

val constant: Bool = false < true
val other: Bool = true <= false

def main(): Unit {
    printl(Card(1, 2) < Card(1, 3))
    printl(Card(1, 2) <= Card(1, 2))
    printl(Card(1, 2) > Card(1, 3))
    printl(Card(1, 2) >= Card(1, 3))
    printl(Box(Card(2, 0)) > Box(Card(1, 9)))

    printl(false < true)
    printl(true < true)
    printl(constant)
    printl(other)

    printl((1, "b") <= (1, "a"))
    printl((1, 2.5, 'x') < (1, 2.5, 'y'))
    printl([1, 2] < [1, 2, 0])
    printl([[3]] > [[2, 9]])
    val none: [Int] = []
    printl(none < [0])

    val n: Int? = None
    printl(n < Some(1))
    printl(Some(2) > n)
    printl(n >= None)
    val small: UInt8? = 5
    printl(small < Some(6))
    printl(small < Some(4))
    val pair: (UInt8, Int8) = (1, 2)
    printl(pair < (1, 3))

    printl(smaller(Card(2, 1), Card(1, 9)))
    printl(smaller("pear", "apple"))
    printl(largest([Box(1), Box(7), Box(3)], Box(0)))
    printl(between(1, 5, 9))
    printl(between((0, 0), (0, 1), (0, 0)))

    // Outside generic code a Float's `<` is the machine's, which is false beside a NaN. Through a
    // bound it's the total order, with NaN last.
    val zero = 0.0
    val nan = zero / zero
    printl(nan < 1.0)
    printl(1.0 < nan)
    printl(smaller(nan, 1.0))
    printl(smaller(1.0, nan))
    printl(between(-0.0, 0.0, -0.0))
}
