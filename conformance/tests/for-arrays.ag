type Point(x: Int, y: Int)

def sum(xs: [Int]): Int {
    mutable val total = 0
    for x in xs {
        total += x
    }
    return total
}

def firstNegative(xs: [Int]): Int? {
    for x in xs {
        if x < 0 {
            return x
        }
    }
    return None
}

def firstSome(xs: [Int?]): Int? {
    for x in xs {
        return Some(x?)
    }
    return None
}

def noisy(): [Int] {
    printl("evaluated")
    return [1, 2]
}

def main(): Unit {
    printl(sum([1, 2, 3]))
    printl(sum([]))

    for s in ["a", "b"] {
        printl(s)
    }
    for p in [Point(1, 2), Point(3, 4)] {
        printl(p.x + p.y)
    }
    for o in [Some(1), None] {
        printl(o)
    }
    for row in [[1, 2], [], [3]] {
        printl(row)
    }

    // Slices and fields work like any other array.
    val xs = [10, 20, 30, 40]
    for x in xs[1..3] {
        printl(x)
    }

    // What's looped over is evaluated once.
    for x in noisy() {
        printl(x)
    }

    // Rebinding doesn't change what's being looped over.
    mutable val growing = [1, 2]
    for x in growing {
        growing ~= [x * 10]
    }
    printl(growing)

    // Elements with no stored value still count.
    mutable val units = 0
    val nothing: [Unit] = [(), (), ()]
    for u in nothing {
        printl(u)
        units += 1
    }
    printl(units)
    val never: [Never] = []
    for n in never {
        printl("unreachable")
    }

    // `_` binds nothing, and can be repeated.
    mutable val count = 0
    for _ in xs {
        for _ in xs {
            count += 1
        }
    }
    printl(count)

    // The same name in sibling loops.
    for x in [1] {
        printl(x)
    }
    for x in ["one"] {
        printl(x)
    }

    printl(firstNegative([1, -2, -3]))
    printl(firstNegative([1]))
    printl(firstSome([Some(5)]))
    printl(firstSome([None, Some(5)]))

    val unit = for x in [1] { x }
    printl(unit)
}
