// The function standing in for another asks questions of its own, through wrapped types and
// through indexing.
interface Sized { def size(x: Self): Int }
interface Named { def name(x: Self): String }
type A(n: Int)
def size(a: A): Int => a.n
def name(a: A): String => "a"
type B(n: Int)
def size(b: B): Int => b.n

def label<T>(x: T): String => "unnamed"
def label<T: Named>(x: T): String => "named {name(x)}"

// The rung's own body asks a further question.
def count<T>(x: T): String => "any"
def count<T: Sized>(x: T): String => "sized {size(x)} " ~ label(x)
def busy<T>(x: T): String => count(x)

// Each level wraps the last, and whether the wrapped type is Sized is settled where it is written.
type Wrap<T>(inner: T)
def size<T: Sized>(w: Wrap<T>): Int => size(w.inner) + 1
def deep0<T>(x: T): String => count(Wrap(x))
def deep<T>(x: T): String => deep0(Wrap(x))

// Indexing chooses by the real type too.
type Grid<T>(item: T)
def opIndex<T>(g: Grid<T>, i: Int): String => "plain"
def opIndex<T: Named>(g: Grid<T>, i: Int): String => "named"
def peek<T>(x: T): String => Grid(x)[0]

def main(): Unit {
    printl(busy(A(1)))
    printl(busy(B(2)))
    printl(busy(true))
    printl(deep(A(1)))
    printl(deep(1))
    printl(peek(A(1)))
    printl(peek(B(1)))
}
