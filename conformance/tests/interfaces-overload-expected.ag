// What the expected type binds decides which bounds hold while an overload is chosen, and has to
// suit the arguments too: it never ranks, but a function it makes unable to take an argument
// doesn't fit.

interface A { def fa(v: Self): Int }
interface B { def fb(v: Self): Int }
def fa(x: Int): Int => 1
def fa(x: Float): Int => 1
def fa(x: String): Int => 1
def fa(x: [Int]): Int => 1
def fb(x: Float): Int => 2
def fb(x: String): Int => 2
def fb(x: [Int]): Int => 2

// Only the expected type says what `T` is.
def pick<T: A>(): [T] { printl("pick: A"); [] }
def pick<T: A & B>(): [T] { printl("pick: A and B"); [] }

def make<T: A>(n: Int): T? { printl("make: A"); None }
def make<T: A & B>(n: Int): T? { printl("make: A and B"); None }

// The stronger one binds `T` to the whole expected type, which the literal can't be.
def conv<T: A>(x: T): [T] { printl("conv: A"); [x] }
def conv<T: A & B>(x: T): T { printl("conv: A and B"); x }

def twice<T: A>(x: T): T { printl("twice: A"); x }
def twice<T: A & B>(x: T): T { printl("twice: A and B"); x }

def wrap<T>(x: T): [T] { printl("wrap: anything"); [x] }
def wrap<T: A>(x: T): T { printl("wrap: A"); x }

def main(): Unit {
    val ints: [Int] = pick()
    val floats: [Float] = pick()
    printl(length(ints) + length(floats))

    val i: Int? = make(1)
    val s: String? = make(1)
    printl(i)
    printl(s)

    val xs: [Int] = conv(1)
    printl(xs)
    val fs: [Float] = conv(1)
    printl(fs)
    val f: Float = conv(1)
    printl(f)
    val ys: [Int] = conv([1])
    printl(ys)
    printl(conv(1))

    val k: Int = twice(1)
    printl(k)
    val r: Float = twice(1)
    printl(r)
    printl(1.twice())

    val ws: [Int] = wrap(1)
    printl(ws)
    val w: [Int] = wrap([1])
    printl(w)
    printl(wrap(2))
}
