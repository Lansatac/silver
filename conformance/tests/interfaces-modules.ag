// A module can make a library type conform, and the conformance holds wherever the type is used,
// with the functions it found where it's declared.

import interfaces_support.things
import interfaces_support.json
import interfaces_support.pretty : pretty, prettyAll

// The module that declares Foo wrote no toJson, so this one makes it a Json.
def toJson(f: Foo): String => "foo#{f.id}"
conform Foo: Json
// Bar's toJson is its module's, which doesn't know Json.
conform Bar: Json

def report<T: Json>(label: String, item: T): String => label ~ " " ~ encode(item)

def main(): Unit {
    val foo = Foo(7)
    printl(foo.toJson())
    printl(encode(foo))
    // Another module with a `toJson` of its own for Foo still encodes it by the conformance.
    printl(pretty(foo))

    // A conformance with a `when` holds for the types its `when` does.
    printl(encode([foo, Foo(8)]))
    printl(prettyAll([foo]))
    val maybe: Foo? = foo
    printl(encode(maybe))

    printl(encode(Bar(1)))
    printl(encode([1, 2]))
    printl(report("got", foo))
    printl(report("got", [Bar(2)]))
}
