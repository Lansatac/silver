// A bare Error passed where a generic function takes a bare T takes its type from the
// expected error union, as it did when Error bound T to the failure.
def id<T>(x: T): T => x
def first<T>(a: T, b: T): T => a

def main(): Unit {
    val r: Int ! String = id(Error("x"))
    printl(r)
    val s: Int ! String = first(Error("y"), Error("z"))
    printl(s)
}
