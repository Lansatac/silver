// A conformance's functions are found before bodies are checked, and a function whose result is
// worked out from its body is checked then. Its body still sees what the functions it calls return.
interface Source<R> { def src(v: Self): R }

type OutOfRange(v: Int)
type Percent(value: Int)

def percent(value: Int): Percent ! OutOfRange => if 0 <= value && value <= 100 => Percent(value) else Error(OutOfRange(value))

type Bag(n: Int)
conform Bag: Source<[Int]>
def src(b: Bag): Range<Int> {
    val p = percent(b.n)!
    [p.value]
}

def first<S: Source<R>, R: Range<Int>>(s: S): Int {
    for x in src(s) { return x }
    0
}

def main(): Unit {
    printl(first(Bag(5)))
}
