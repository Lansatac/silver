// The invariant of a value a generic function builds or changes is needed at that value's type
// arguments. Here those don't grow, so the instances are finite.
type Bad

type W<T>(items: [T], n: Int) invariant ok(items, n) else Bad
type Holder<T>(w: W<[T]>?)

def ok<U>(xs: [U], n: Int): Bool => n > 0 || length(xs) > 0

// The `with` needs `W<[U]>`'s invariant, which needs `ok<[U]>`, which needs nothing more.
def poke<U>(h: Holder<U>): Bool => match h.w {
    None => false
    Some(w) => match w with (n = 0) {
        Ok(_) => true
        Error(_) => false
    }
}

// An inline member's invariant takes only the sum's parameters it mentions, and `A` grows.
type S<A, B> = M(b: [B]) invariant (always(b)) else (Bad) | Stop(a: A)

def always<V>(xs: [V]): Bool => true

def grows<A>(a: A, n: Int): Int {
    if n == 0 { return 0 }
    val s: S<[A], Int> ! Bad = M([1])
    1 + grows(a, n - 1)
}

def main(): Unit {
    printl(poke(Holder<Int>(None)))
    match W([[1, 2]], 1) {
        Ok(w) => printl(poke(Holder(w)))
        Error(_) => printl("bad")
    }
    printl(grows("a", 3))
}
