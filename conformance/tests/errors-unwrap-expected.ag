// What's expected of `x!` or `x?` reaches `x`: it binds type arguments, through branches too.
type Oops

def parsed<T>(fallback: T, ok: Bool): T ! Oops => if ok => fallback else Error(Oops)
def found<T>(value: T, present: Bool): T? => if present => Some(value) else None
def none<T>(): T? => None
def zero<T>(): T? ! Oops => Ok(None)

def doubled(ok: Bool): Int ! Oops {
    val n: Int = parsed(21, ok)?
    n * 2
}

def first(present: Bool): Int? {
    val n: Int = found(7, present)?
    Some(n + 1)
}

def main(): Unit {
    val b = true
    val c: Int = (if b => found(3, true) else none())!
    printl(c)
    val m: [Int] = (match b {
        true => { found([5], true) }
        false => none()
    })!
    printl(m)
    printl(doubled(true))
    printl(doubled(false))
    printl(first(true))
    printl(first(false))
    val inner: Int? = zero()!
    printl(inner)
}
