// `Ok(x)` in a body whose result type is an interface name on the success side of an error union,
// as in any function returning an error union.

import interfaces_support.floors

type NotFound(code: Int)

def whole(xs: [Int]): Range<Int> ! NotFound => Ok(xs)

def later(xs: [Int]): Range<Int> ! NotFound {
    if length(xs) == 0 { return Error(NotFound(1)) }
    return Ok(xs.map(x => x + 1))
}

def main(): Unit {
    printl(whole([1]))
    printl(later([]))
    val mapped = later([1, 2])!
    printl(mapped.array())
    val kept: [Int] ! NotFound = Ok([7])
    printl(kept)
}
