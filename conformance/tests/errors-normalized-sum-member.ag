// A sum declared before the sum it names can have a member whose error list lists both that sum
// and one of its members; the member is the same type as the list without it, whichever sum is
// declared first.

type Bad(n: Int)
type Empty
type Wrapped = :String | :(Int ! ParseError | Bad)
type ParseError = :Bad | :Empty

def kept(r: Int ! ParseError): String => match r {
    Ok(v) => "ok {v}"
    Error(Bad(n)) => "bad {n}"
    Error(Empty) => "empty"
}

def described(w: Wrapped): String => match w {
    s: String => "text {s}"
    r: Int ! ParseError => kept(r)
}

def main(): Unit {
    printl(described("hi"))
    val failed: Int ! ParseError = Error(Bad(3))
    printl(described(failed))
}