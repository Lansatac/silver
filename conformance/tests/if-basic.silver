// Brace-less if expressions: `=>` introduces a single expression

val a = if true => 1 else 2
printl(a)
val b = if false => 1 else 2
printl(b)

// `else` takes any expression, so else-if chains need no special rule
def sign(n: Int): Int => if n < 0 => -1 else if n == 0 => 0 else 1
printl(sign(-5))
printl(sign(0))
printl(sign(7))

// Dangling else binds to the nearest if
val c = if true => if false => 1 else 2 else 3
printl(c)

// Function arguments are full expressions, so no parentheses are needed
printl(if 1 < 2 => 10 else 20)
