// A float literal that adapts to a Float32 is rounded once, from its text. The text just above a
// midpoint between two Float32s reads as the midpoint as a Float, and rounding that again would
// tie to even; Float32(text) is a Float first, so it does round twice.
val constant: Float32 = 1.00000005960464477539062500000001
val constantBelow: Float32 = 1.00000005960464477539062499999999
val largest: Float32 = 340282356779733661637539395458142568447.0
val negativeConstant: Float32 = -1.00000005960464477539062500000001

def main(): Unit {
    // 1 + 2^-24 is the midpoint between 1 and the next Float32.
    val above: Float32 = 1.00000005960464477539062500000001
    val tie: Float32 = 1.000000059604644775390625
    val below: Float32 = 1.00000005960464477539062499999999
    printl(above)
    printl(tie)
    printl(below)
    printl(-above)
    val negative: Float32 = -1.00000005960464477539062500000001
    printl(negative)
    printl(above == tie)

    // 1 + 3 × 2^-24 is the midpoint between an odd neighbour and an even one, so the tie rounds up.
    val oddAbove: Float32 = 1.00000017881393432617187500000001
    val oddTie: Float32 = 1.000000178813934326171875
    val oddBelow: Float32 = 1.00000017881393432617187499999999
    printl(oddAbove)
    printl(oddTie)
    printl(oddBelow)

    // The literal is a Float first in a conversion, so it rounds twice and ties to even.
    printl(Float32(1.00000005960464477539062500000001))

    // The largest Float32 stops being the nearest at (2 - 2^-24) × 2^127.
    val nearMax: Float32 = 340282356779733661637539395458142568447.0
    printl(nearMax)
    printl(nearMax == 3.4028235e38)

    // Subnormals: 2^-150 is the midpoint between zero and the smallest Float32.
    val zero: Float32 = 7.00649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015625e-46
    val smallest: Float32 = 7.00649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015626e-46
    printl(zero)
    printl(smallest)

    printl(constant)
    printl(constantBelow)
    printl(negativeConstant)
    printl(largest)
    printl(constant == above)
}
