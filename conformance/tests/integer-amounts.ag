def main(): Unit {
    val amount: UInt8 = 4
    val signedAmount: Int8 = 3
    val wideAmount: UInt64 = 7
    printl(1 << amount)
    printl(256 >> signedAmount)

    val byte: UInt8 = 1
    printl(byte << wideAmount)
    val negative: Int8 = -128
    printl(negative >> wideAmount)
    val top: UInt64 = 0x8000000000000000
    printl(top >> amount)

    mutable val running: UInt16 = 1
    running <<= amount
    printl(running)
}
