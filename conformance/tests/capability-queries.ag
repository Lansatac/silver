// Of functions differing only in their bounds, the one chosen inside a generic function is the
// one asking for most that the real type satisfies, and the question is carried to its callers.
import queries_support.lib

interface Steps<T> { def next(r: Self): (T, Self)? }
interface Counted { def size(r: Self): Int }
interface Named { def name(x: Self): String }

def next(xs: [Int]): (Int, [Int])? => if xs.length() == 0 => None else (xs[0], xs[1..])
def size(xs: [Int]): Int => xs.length()

type Countdown(from: Int)
def length(c: Countdown): Int => c.from
def next(c: Countdown): (Int, Countdown)? => if c.from == 0 => None else (c.from, Countdown(c.from - 1))

// A type built from R: whether it's Counted is settled here, which leaves "is R Counted?".
type Doubled<R>(source: R)
def next<R: Steps<Int>>(d: Doubled<R>): (Int, Doubled<R>)? {
    val (item, rest) = next(d.source)?
    (item * 2, Doubled(rest))
}
def size<R: Counted>(d: Doubled<R>): Int => size(d.source)

def count<R: Steps<Int>>(r: R): String => "stepped"
def count<R: Steps<Int> & Counted>(r: R): String => "sized {size(r)}"

def busy<R: Steps<Int>>(r: R): String => count(Doubled(r))
// Nothing is written here, and the question still reaches the caller.
def outer<R: Steps<Int>>(r: R): String => "outer " ~ busy(r)
def unbounded<R>(r: R, how: (R) -> String): String => how(r)

// A function asking more that returns a different type is chosen only where the call is written.
def kind<T>(x: T): String => "any"
def kind<T: Named>(x: T): Int => 1
def kindOf<T>(x: T): String => kind(x)

// An optional step: a pair, one with a default, asked once each.
interface Frees { def free(a: Self, block: String): String }
interface Owns { def owns(a: Self, block: String): Bool }

type Bump(name: String)
type Heap(name: String)
def free(a: Heap, block: String): String => "{a.name} frees {block}"
def owns(a: Heap, block: String): Bool => block == a.name

type Fallback<A, B>(primary: A, other: B)

def freeIfCan<A>(a: A, block: String): String => "nothing to do"
def freeIfCan<A: Frees>(a: A, block: String): String => free(a, block)
def ownsOrGuess<A>(a: A, block: String): Bool => true
def ownsOrGuess<A: Owns>(a: A, block: String): Bool => owns(a, block)

def release<A, B>(f: Fallback<A, B>, block: String): String =>
    if ownsOrGuess(f.primary, block) => freeIfCan(f.primary, block) else freeIfCan(f.other, block)

// A bound's witness is chosen the same way: `Box<T>` describes itself by what `T` can do.
interface Describe { def describe(x: Self): String }
type Box<T>(item: T)
def describe<T>(b: Box<T>): String => "a box"
def describe<T: Named>(b: Box<T>): String => "a box of {name(b.item)}"
def show<T: Describe>(x: T): String => describe(x)
def wrapped<T>(x: T): String => show(Box(x))

type Row(items: [Int])
def name(r: Row): String => "row"

// Recursion: what a function asks of itself is asked of its callers.
def countdown<R: Steps<Int>>(r: R, n: Int): String => if n == 0 => count(r) else countdown(r, n - 1)

// `for` loops by index where the real type has `length` and `opIndex`, and steps otherwise.
type Noisy(n: Int)
def next(x: Noisy): (Int, Noisy)? { printl("  step"); if x.n == 0 => None else (x.n, Noisy(x.n - 1)) }
type Listed(items: [Int])
def next(x: Listed): (Int, Listed)? { printl("  step"); if x.items.length() == 0 => None else (x.items[0], Listed(x.items[1..])) }
def length(x: Listed): Int => x.items.length()
def opIndex(x: Listed, i: Int): Int { printl("  index {i}"); x.items[i] }

def sum<R: Steps<Int>>(r: R): Int {
    mutable val total = 0
    for item in r { total += item }
    total
}

def main(): Unit {
    printl(count(Doubled([1, 2, 3])))
    printl(busy([1, 2, 3]))
    printl(busy(Countdown(3)))
    printl(outer([1, 2]))
    printl(outer(Countdown(2)))

    // A function value keeps the answers from where it was made.
    val f: ([Int]) -> String = busy
    val g: (Countdown) -> String = busy
    printl(unbounded([1], f))
    printl(unbounded(Countdown(1), g))

    printl(kindOf(Row([1])))

    printl(release(Fallback(Heap("h"), Bump("b")), "h"))
    printl(release(Fallback(Bump("b"), Heap("h")), "h"))
    printl(release(Fallback(Heap("h"), Heap("g")), "other"))

    printl(wrapped(Row([1])))
    printl(wrapped(1))

    printl(countdown([1, 2, 3, 4], 3))
    printl(countdown(Countdown(4), 3))

    // A library function asks too, and the answer comes from here.
    printl(measure(Countdown(3)))
    printl(measure(Plain(3)))
    printl(measureHere(Plain(3)))

    printl("noisy:")
    printl(sum(Noisy(2)))
    printl("listed:")
    printl(sum(Listed([4, 5])))
}
