// An interface name as a result type, or on a `val`, is a floor: the type is the body's or the
// value's, checked to satisfy the interface, and it keeps everything it can do.

import interfaces_support.floors
import std.range : Filtered

type Box<T>(value: T)
type Deck(cards: [Int])

def main(): Unit {
    // The result is a Mapped<[Int], Int, Int>, so it's still indexed.
    val mapped = squares([1, 2, 3])
    printl(mapped[1])
    printl(length(mapped))
    printl(mapped.source)
    // Over a Countdown it's a range and nothing more.
    printl(squares(Countdown(3)).array())
    for n in squares(Countdown(2)) { printl(n) }
    // A filter isn't indexed, and is still what the caller gets.
    printl(odds([1, 2, 3, 4, 5]).array())
    printl(odds([7, 8]).source)

    // A module checked before the one whose function it calls.
    printl(labelled(4))

    // Declared after its caller, and built on another floor.
    printl(evenSquares([1, 2, 3, 4]).array())
    // Several interfaces joined.
    val both = shifted([10, 20])
    printl(both[1])
    printl(length(both))
    // A hidden type parameter for the argument, and a floor for the result.
    printl(same(Countdown(2)).from)
    printl(same(["a", "b"])[1])
    printl(firstTwo(["x", "y", "z"]).array())

    // Inside a tuple, an option, an array and a type argument.
    val (head, rest) = split([5, 6, 7])
    printl(head)
    printl(rest.array())
    printl(length(rest))
    printl(nonEmpty([]))
    printl(nonEmpty([1]))
    printl(early([]))
    if val added = early([2, 3]) { printl(added[1]) }
    printl(rows([1, 2])[1][0])
    printl(boxed([4]).value[0])
    printl(nested([8, 9])[1])
    printl(length(nested([8, 9])))

    // The same name with other parameters isn't the function itself.
    printl(cards(Deck([3, 1])).array())

    // A function with a floor as a value has its real type.
    val f = shifted
    printl(f([1])[0])
    val g: ([Int]) -> [Int]? = nonEmpty
    printl(g([6]))
    val h = squares<Countdown>
    printl(h(Countdown(2)).array())
    printl(apply(odds, [1, 2, 3]).array())

    // On a `val`, the binding has the value's type.
    val xs: Range<Int> = [1, 2, 3]
    printl(xs[0])
    val ys: Range<Int> & Indexed<Int> = squares(xs)
    printl(ys[2])
    val zs: Range<Int> = odds(xs)
    printl(zs.array())
    val pair: (String, Range<Int>)? = ("p", Countdown(1))
    printl(pair)
    val held: Box<Range<String>> = Box(["s"])
    printl(held.value[0])
    mutable val changing: Range<Int> = [1]
    changing = [2, 3]
    printl(changing)

    // A nested def and a lambda.
    def halves(source: [Int]): Range<Int> => source.map(x => x / 2)
    printl(halves([4, 6])[1])
    val negate = (source: [Int]): Range<Int> & Indexed<Int> => source.map(x => 0 - x)
    printl(negate([5])[0])
}

def evenSquares(xs: [Int]): Range<Int> => squares(xs).filter(x => x % 2 == 0)

def shifted(xs: [Int]): Range<Int> & Indexed<Int> => xs.map(x => x + 1)

def same<T>(r: Range<T>): Range<T> => r

def firstTwo<T>(xs: [T]): Range<T> & Indexed<T> => xs[0..2]

def split(xs: [Int]): (Int, Range<Int>) => (xs[0], xs[1..].map(x => x * 10))

def nonEmpty(xs: [Int]): Range<Int>? => if length(xs) == 0 => None else xs

def early(xs: [Int]): (Range<Int> & Indexed<Int>)? {
    if length(xs) == 0 { return None }
    xs.map(x => x + 100)
}

def rows(xs: [Int]): [Range<Int>] => [xs, xs.map(x => x + 1).array()]

def boxed(xs: [Int]): Box<Range<Int>> => Box(xs)

def nested(xs: [Int]): Range<Range<Int>> => [xs, xs]

def cards(d: Deck): Range<Int> => cards(d.cards)
def cards(xs: [Int]): Filtered<[Int], Int> => xs.filter(x => x > 1)

def apply<R: Range<Int>>(make: ([Int]) -> R, xs: [Int]): Range<Int> => make(xs)
