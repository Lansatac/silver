module forward_support.arrays

def first<T>(xs: [T]): T? => if length(xs) == 0 => None else xs[0]

type Stack(items: [Int])

def length(s: Stack): Int => length(s.items)
def opIndex(s: Stack, index: Int): Int => s.items[index] * 10
def next(s: Stack): (Int, Stack)? => if length(s.items) == 0 => None else Some((s.items[0] * 10, Stack(s.items[1..])))
conform Stack: Range<Int>

val limit: Int = 3

def unlisted(): String => "arrays.unlisted"
private def hidden(): Int => 0
