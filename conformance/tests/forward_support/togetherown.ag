module forward_support.togetherown

forward import forward_support.arrays
forward import forward_support.ranges

type Bag(size: Int)

def count(b: Bag): Int => b.size
conform Bag: Counted
def count<T>(xs: [T]): Int => length(xs)

// Its own `first` is one more overload beside the forwarded ones, which still rank as one group inside.
def first(text: String): String => "own {text}"

def firsts(): String => "{first([4, 5])} {front(Bag(3))} {first("x")}"
