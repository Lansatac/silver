module forward_support.together

forward import forward_support.arrays
forward import forward_support.ranges

type Bag(size: Int)

def count(b: Bag): Int => b.size
conform Bag: Counted
def count<T>(xs: [T]): Int => length(xs)

// Its forwards are ranked as one group here, as they are for its importers.
def firsts(): String => "{first([4, 5])} {first(Bag(3))}"
