// A generic function with bounds that calls itself: its type arguments there are its own type
// parameters, passed along or swapped, and its bounds hold for them.

interface Steps<T> { def step(r: Self): (T, Self)? }

def step(xs: [Int]): (Int, [Int])? => if xs.length() == 0 => None else (xs[0], xs[1..xs.length()])

type Countdown(from: Int)

def step(c: Countdown): (Int, Countdown)? => if c.from == 0 => None else (c.from, Countdown(c.from - 1))

def total<R: Steps<Int>>(r: R, sum: Int): Int => match step(r) {
    None => sum
    Some((x, rest)) => total(rest, sum + x)
}

// `T` is found from the bound at the call, as at any other.
def count<R: Steps<T>, T>(r: R): Int => match step(r) {
    None => 0
    Some((_, rest)) => 1 + count(rest)
}

// Each step takes from the other one.
def alternate<A: Steps<Int>, B: Steps<Int>>(a: A, b: B): [Int] => match step(a) {
    None => []
    Some((x, rest)) => [x] ~ alternate(b, rest)
}

def main(): Unit {
    printl(total([1, 2, 3], 0))
    printl(total(Countdown(4), 0))
    printl(count(Countdown(5)))
    printl(alternate([1, 2, 3], Countdown(3)))
}
