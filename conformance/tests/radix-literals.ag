// Hex and binary literals are 64-bit patterns, so values above Int.max wrap to negatives
def main(): Unit {
    printl(0x1F)
    printl(0xff)
    printl(0b101)
    printl(0b1010_0101)
    printl(-0x10)
    printl(0x7FFFFFFFFFFFFFFF)
    printl(0x8000000000000000)
    printl(0xFFFFFFFFFFFFFFFF)
    printl(0x9E3779B97F4A7C15)
    printl(0x10 + 0b10)
}
