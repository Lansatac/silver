// A slice can leave out a bound: `xs[a..]` runs to the end, and `xs[..b]` starts at 0.

def made(): [Int] {
    printl("made once")
    [1, 2, 3, 4]
}

def main(): Unit {
    val xs = [10, 20, 30, 40]
    printl(xs[1..])
    printl(xs[..2])
    printl(xs[0..])
    printl(xs[4..])
    printl(xs[..0])
    printl(xs[..4])
    printl(xs[length(xs) - 1..])
    printl(xs[..length(xs) - 1])

    // Bounds of any integer type, as in any slice.
    val i: UInt8 = 2
    printl(xs[i..])
    printl(xs[..i])

    // The array is evaluated once, even though the end is its length.
    printl(made()[2..])

    // Chained, and on a literal.
    printl(xs[1..][..2])
    printl([1, 2, 3][1..])

    // Dropping the first element until nothing is left.
    mutable val rest = xs
    while length(rest) > 0 {
        print(rest[0])
        rest = rest[1..]
    }
    printl("")
}
