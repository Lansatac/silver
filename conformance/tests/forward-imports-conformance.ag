// A wrapper library that forwards an interface's module and a type that conforms to it:
// importing the wrapper is enough to use the type where the interface is a bound.
import forward_support.wrapper

type Mine(label: String)

def toJson(mine: Mine): String => "mine {mine.label}"
conform Mine: Json

def main(): Unit {
    printl(report(1))
    printl(report(Thing(2)))
    printl(report([Thing(3), Thing(4)]))
    printl(report(Mine("five")))
    printl(encode([1, 2]))
    val json: Json = Thing(6)
    printl(toJson(json))
}
