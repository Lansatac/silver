// An alias names an error list as it's written, so one that lists a sum and its member is the
// same type as the list without the member, and a match over it is exhaustive with the member's
// arms. Aliases are resolved before sums' members are declared.

type Bad(n: Int)
type Empty
alias Failure = Int ! ParseError | Bad
type ParseError = :Bad | :Empty

def parsed(x: Int): Int ! ParseError => if x > 0 => x else if x == 0 => Error(Empty) else Error(Bad(x))

def viaAlias(x: Int): Failure => parsed(x)

def described(r: Failure): String => match r {
    Ok(v) => "ok {v}"
    Error(Bad(n)) => "bad {n}"
    Error(Empty) => "empty"
}

def main(): Unit {
    printl(described(viaAlias(1)))
    printl(described(viaAlias(0)))
    printl(described(viaAlias(-2)))
}