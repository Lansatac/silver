module interfaces_support.pretty

import interfaces_support.things : Foo
import interfaces_support.json

// This module's own `toJson` for a Foo isn't the one its conformance found, so `encode` doesn't use it.
def toJson(f: Foo): String => "Foo \{ id: {f.id} \}"

def pretty(f: Foo): String => encode(f)
def prettyAll(fs: [Foo]): String => encode(fs)
