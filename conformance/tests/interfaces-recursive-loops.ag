// A loop in a generic function steps by the conformance its bound gives it, and a conformance
// with a `when` holds for each instance whose type argument meets it.
interface Counted { def size(r: Self): Int }

def size(xs: [Int]): Int => xs.length()

type Doubled<R>(source: R)

def next<R: Range<Int>>(d: Doubled<R>): (Int, Doubled<R>)? {
    val (item, rest) = next(d.source)?
    (item * 2, Doubled(rest))
}
def size<R: Counted>(d: Doubled<R>): Int => size(d.source)

conform [Int]: Counted
conform Doubled<R>: Range<Int> when R: Range<Int>
conform Doubled<R>: Counted when R: Counted

def count<R: Range<Int>>(r: R): Int {
    mutable val k = 0
    for _ in Doubled(r) { k += 1 }
    k
}

def twice<R: Range<Int>>(r: R): Int => count(Doubled(r))

def main(): Unit {
    printl(count([1, 2]))
    printl(twice([1, 2, 3]))
    printl(size(Doubled([4, 5])))
}
