// A Float32 prints as the shortest text that reads back as the same Float32, in the format a Float
// has: a `.` when written out, an exponent below 1e-4 and from 1e16, and a zero's sign.
def main(): Unit {
    val zero = Float32(0.0)
    val tenth = Float32(0.1)
    printl(tenth)
    printl(Float(tenth))
    printl(Float32(1.0) / Float32(3.0))
    printl(Float32(123456789.0))
    printl(Float32(0.3))
    printl(Float32(10.0000105))
    printl(Float(Float32(10.0000105)))
    printl(Float32(16777216.0))
    printl(Float32(8388608.5))
    printl(Float32(3.4028235e38))
    printl(Float32(1.17549435e-38))
    printl(Float32(1e-45))
    printl(Float32(1.0))
    printl(Float32(1024.0))
    printl(Float32(0.5))
    printl(Float32(0.0001))
    printl(Float32(0.00001))
    printl(Float32(1.5e-7))
    printl(Float32(1e15))
    printl(Float32(1e16))
    printl(Float32(1e20))
    printl(Float32(1e38))
    printl(-zero)
    printl(zero)
    printl(Float32(1.0) / zero)
    printl(-Float32(1.0) / zero)
    printl(zero / zero)
    printl(-(zero / zero))
    printl("{tenth * Float32(3.0)} {[Float32(1.0), Float32(2.5)]} {Some(Float32(2.0))}")
    printl(String(tenth) ~ "|" ~ String(Float(tenth)))
    print(tenth)
    print(" ")
    printl(Float32(1e16))
}
