// An array of String is a Range<String>, by the `next` that takes it.
interface Range<T> { def next(range: Self): (T, Self)? }
def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])
def total(range: Range<Int>): Int => 0

def main(): Unit {
    printl(total(["a", "b"]))
}
