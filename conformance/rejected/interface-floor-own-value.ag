// Inside its own body an overloaded function has no type yet, so the example shows another's.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])

type Deck(cards: [Int])

def cards(d: Deck): Range<Int> {
    val f = cards
    d.cards
}
def cards(xs: [Int]): Range<Int> => xs

def main(): Unit {
    printl(cards(Deck([1])))
}
