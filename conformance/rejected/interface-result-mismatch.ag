// The function is chosen by its argument, and its result then has to be the interface's.
interface Json { def toJson(value: Self): String }
def toJson(x: Int): String => "{x}"
def encode<T: Json>(item: T): String => toJson(item)
type Plain(n: Int)
def toJson(p: Plain): Int => p.n

def main(): Unit {
    printl(encode(Plain(1)))
}
