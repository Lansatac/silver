// A private type inside the type a public function returns through an interface name.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])

private type Steps(from: Int)
private def next(s: Steps): (Int, Steps)? => if s.from == 0 => None else (s.from, Steps(s.from - 1))

def pair(from: Int): (Int, Range<Int>)? => (from, Steps(from))

def main(): Unit {
    printl(pair(2))
}
