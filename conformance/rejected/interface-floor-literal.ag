// Nothing is passed down beside a floor, so a literal has its default type.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])

def main(): Unit {
    val halves: Range<Float> = [1, 2]
    printl(halves)
}
