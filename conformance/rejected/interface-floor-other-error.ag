// The errors after an interface name are the ones a `?` in the body can pass on.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])

type Missing
type Other

def find(xs: [Int]): [Int] ! Missing => if length(xs) == 0 => Error(Missing) else xs

def found(xs: [Int]): Range<Int> ! Other => find(xs)?

def main(): Unit {
    printl(found([1]))
}
