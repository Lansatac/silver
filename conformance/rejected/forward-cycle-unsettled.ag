// Each of `swinga` and `swingb` lists `x` from the other and blanket forwards a different `x`
// (`swingf`'s function, `swingv`'s value), so what either passes on depends on what the other
// does and the rounds alternate. Taking whatever the last round left gives importers `swingv`'s
// value while `swinga` itself means `swingf`'s function by `x`. Only the forwarding modules can
// break the cycle, so it's an error at the forward.
import forward_support.swinga

def main(): Unit {
    printl(x)
}
