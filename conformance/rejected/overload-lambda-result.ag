// Functions that differ in their bounds, where only a lambda's result would say which hold, are tied.
interface A { def fa(v: Self): Int }
def fa(x: Int): Int => 1
def ap<T>(x: Int, g: (Int) -> T): String { printl("ap: anything"); "{g(x)}" }
def ap<T: A>(x: Int, g: (Int) -> T): String { printl("ap: A"); "{g(x)}" }
def main(): Unit {
    printl(ap(1, n => "s"))
}
