// `A & B` is a parameter's whole type, and isn't a type inside one.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])

def firsts(items: [Range<Int> & Indexed<Int>]): Int => 1

def main(): Unit {
    printl(1)
}
