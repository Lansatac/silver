// A top-level constant is a primitive, so an interface name there has nothing to stand for.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])

val numbers: Range<Int> = 1

def main(): Unit {
    printl(1)
}
