// A value returned beside a floor can only be an error that's written.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])

type Missing
type Other

def found(xs: [Int]): Range<Int> ! Other {
    if length(xs) == 0 { return Error(Missing) }
    xs
}

def main(): Unit {
    printl(found([1]))
}
