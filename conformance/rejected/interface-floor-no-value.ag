// With no value, nothing says what the interface name stands for.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])

def main(): Unit {
    mutable val held: (Int, Range<Int> & Indexed<Int>)?
    printl(held)
}
