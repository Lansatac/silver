// A function with no body has no type for an interface name to stand for.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])

native def numbers(count: Int): Range<Int>

def main(): Unit {
    printl(1)
}
