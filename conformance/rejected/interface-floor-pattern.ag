// A binding in a pattern has its part of the value's type, which is written out or left off.

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

conform [T]: Indexed<T>

def main(): Unit {
    val (first: Range<Int>, second) = ([1], 2)
    printl(second)
}
