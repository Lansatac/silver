// A body that only returns errors doesn't say what the interface name stands for.

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

conform [T]: Indexed<T>

type Missing

def found(xs: [Int]): Range<Int> ! Missing => Error(Missing)

def main(): Unit {
    printl(found([1]))
}
