// `?` binds tighter than `&`, so an option of `A & B` needs parentheses.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])

def some(xs: [Int]): Range<Int> & Indexed<Int>? => xs

def main(): Unit {
    printl(1)
}
