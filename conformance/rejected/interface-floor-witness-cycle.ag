// The function a bound finds is the one whose result is being worked out.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])

interface Source<R> { def items(source: Self): R }
type Bag(xs: [Int])
def pull<S: Source<R>, R>(source: S): R => items(source)

def items(b: Bag): Range<Int> => pull(b)

def main(): Unit {
    printl(items(Bag([1])))
}
