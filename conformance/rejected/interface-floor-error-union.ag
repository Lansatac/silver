// Only the success side of an error union that's the whole result type.

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

conform [T]: Indexed<T>

def load(xs: [Int]): (Int, Range<Int> ! String) => (1, xs)

def main(): Unit {
    printl(load([1]))
}
