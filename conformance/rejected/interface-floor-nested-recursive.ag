// A nested def that uses itself, from a lambda in its body, before its result type is known.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

def next<T>(xs: [T]): (T, [T])? => if length(xs) == 0 => None else (xs[0], xs[1..])

def main(): Unit {
    def walk(n: Int): Range<Int> {
        val again = () => walk(n - 1)
        [n]
    }
    printl(walk(2))
}
