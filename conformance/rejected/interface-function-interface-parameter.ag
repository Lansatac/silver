// An interface's function has no type parameters of its own for an interface name to stand for.

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

conform [T]: Indexed<T>

interface Zip {
    def zip(value: Self, other: Range<Int>): Int
}

def main(): Unit {
    printl(1)
}
