// A function has one result type, so two branches that build different ranges are a mismatch.

interface Indexed<T> {
    def length(value: Self): Int
    def opIndex(value: Self, index: Int): T
}

conform [T]: Indexed<T>

type Filtered<R, T>(source: R, keep: (T) -> Bool)
def filter<R: Range<T>, T>(source: R, keep: (T) -> Bool): Filtered<R, T> => Filtered(source, keep)
def next<R: Range<T>, T>(f: Filtered<R, T>): (T, Filtered<R, T>)? => None
conform Filtered<R, T>: Range<T> when R: Range<T>

def pick(all: Bool, xs: [Int]): Range<Int> => if all => xs else xs.filter(x => x > 1)

def main(): Unit {
    printl(pick(true, [1]))
}
