}

test "invalid/local-date/mday-under" {
    expect(rejects("# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 based on\u{a}#                           ; month/year\u{a}d = 2006-01-00\u{a}"))
