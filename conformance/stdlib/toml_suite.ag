test "valid/array/array-subtables" {
    expect(reads("[[arr]]\u{a}[arr.subtab]\u{a}val=1\u{a}\u{a}[[arr]]\u{a}[arr.subtab]\u{a}val=2\u{a}", "\{\u{a}    \"arr\": [\u{a}        \{\u{a}            \"subtab\": \{\u{a}                \"val\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}            \}\u{a}        \},\u{a}        \{\u{a}            \"subtab\": \{\u{a}                \"val\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}            \}\u{a}        \}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/array" {
    expect(reads("ints = [1, 2, 3, ]\u{a}floats = [1.1, 2.1, 3.1]\u{a}strings = [\"a\", \"b\", \"c\"]\u{a}dates = [\u{a}\u{9}1987-07-05T17:45:00Z,\u{a}\u{9}1979-05-27T07:32:00,\u{a}\u{9}2006-06-01,\u{a}\u{9}11:00:00,\u{a}]\u{a}comments = [\u{a}         1,\u{a}         2, #this is ok\u{a}]\u{a}", "\{\u{a}    \"comments\": [\u{a}        \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    ],\u{a}    \"dates\": [\u{a}        \{\"type\": \"datetime\", \"value\": \"1987-07-05T17:45:00Z\"\},\u{a}        \{\"type\": \"datetime-local\", \"value\": \"1979-05-27T07:32:00\"\},\u{a}        \{\"type\": \"date-local\", \"value\": \"2006-06-01\"\},\u{a}        \{\"type\": \"time-local\", \"value\": \"11:00:00\"\}\u{a}    ],\u{a}    \"floats\": [\u{a}        \{\"type\": \"float\", \"value\": \"1.1\"\},\u{a}        \{\"type\": \"float\", \"value\": \"2.1\"\},\u{a}        \{\"type\": \"float\", \"value\": \"3.1\"\}\u{a}    ],\u{a}    \"ints\": [\u{a}        \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}    ],\u{a}    \"strings\": [\u{a}        \{\"type\": \"string\", \"value\": \"a\"\},\u{a}        \{\"type\": \"string\", \"value\": \"b\"\},\u{a}        \{\"type\": \"string\", \"value\": \"c\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/bool" {
    expect(reads("a = [true, false]\u{a}", "\{\u{a}    \"a\": [\u{a}        \{\"type\": \"bool\", \"value\": \"true\"\},\u{a}        \{\"type\": \"bool\", \"value\": \"false\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/empty" {
    expect(reads("thevoid = [[[[[]]]]]\u{a}", "\{\u{a}    \"thevoid\": [[[[[]]]]]\u{a}\}\u{a}"))
}

test "valid/array/hetergeneous" {
    expect(reads("mixed = [[1, 2], [\"a\", \"b\"], [1.1, 2.1]]\u{a}", "\{\u{a}    \"mixed\": [\u{a}        [\u{a}            \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}        ],\u{a}        [\u{a}            \{\"type\": \"string\", \"value\": \"a\"\},\u{a}            \{\"type\": \"string\", \"value\": \"b\"\}\u{a}        ],\u{a}        [\u{a}            \{\"type\": \"float\", \"value\": \"1.1\"\},\u{a}            \{\"type\": \"float\", \"value\": \"2.1\"\}\u{a}        ]\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/mixed-int-array" {
    expect(reads("arrays-and-ints =  [1, [\"Arrays are not integers.\"]]\u{a}", "\{\u{a}    \"arrays-and-ints\": [\u{a}        \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        [\{\"type\": \"string\", \"value\": \"Arrays are not integers.\"\}]\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/mixed-int-float" {
    expect(reads("ints-and-floats = [1, 1.1]\u{a}", "\{\u{a}    \"ints-and-floats\": [\u{a}        \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \{\"type\": \"float\", \"value\": \"1.1\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/mixed-int-string" {
    expect(reads("strings-and-ints = [\"hi\", 42]\u{a}", "\{\u{a}    \"strings-and-ints\": [\u{a}        \{\"type\": \"string\", \"value\": \"hi\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"42\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/mixed-string-table" {
    expect(reads("contributors = [\u{a}  \"Foo Bar <foo@example.com>\",\u{a}  \{ name = \"Baz Qux\", email = \"bazqux@example.com\", url = \"https://example.com/bazqux\" \}\u{a}]\u{a}\u{a}# Start with a table as the first element. This tests a case that some libraries\u{a}# might have where they will check if the first entry is a table/map/hash/assoc\u{a}# array and then encode it as a table array. This was a reasonable thing to do\u{a}# before TOML 1.0 since arrays could only contain one type, but now it's no\u{a}# longer.\u{a}mixed = [\{k=\"a\"\}, \"b\", 1]\u{a}", "\{\u{a}    \"contributors\": [\u{a}        \{\"type\": \"string\", \"value\": \"Foo Bar \\u003cfoo@example.com\\u003e\"\},\u{a}        \{\u{a}            \"email\": \{\"type\": \"string\", \"value\": \"bazqux@example.com\"\},\u{a}            \"name\":  \{\"type\": \"string\", \"value\": \"Baz Qux\"\},\u{a}            \"url\":   \{\"type\": \"string\", \"value\": \"https://example.com/bazqux\"\}\u{a}        \}\u{a}    ],\u{a}    \"mixed\": [\u{a}        \{\u{a}            \"k\": \{\"type\": \"string\", \"value\": \"a\"\}\u{a}        \},\u{a}        \{\"type\": \"string\", \"value\": \"b\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/nested-double" {
    expect(reads("nest = [\u{a}\u{9}[\u{a}\u{9}\u{9}[\"a\"],\u{a}\u{9}\u{9}[1, 2, [3]]\u{a}\u{9}]\u{a}]\u{a}", "\{\u{a}    \"nest\": [[\u{a}        [\{\"type\": \"string\", \"value\": \"a\"\}],\u{a}        [\u{a}            \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}            [\{\"type\": \"integer\", \"value\": \"3\"\}]\u{a}        ]\u{a}    ]]\u{a}\}\u{a}"))
}

test "valid/array/nested-inline-table" {
    expect(reads("a = [ \{ b = \{\} \} ]\u{a}", "\{\u{a}    \"a\": [\{\u{a}        \"b\": \{\}\u{a}    \}]\u{a}\}\u{a}"))
}

test "valid/array/nested" {
    expect(reads("nest = [[\"a\"], [\"b\"]]\u{a}", "\{\u{a}    \"nest\": [\u{a}        [\{\"type\": \"string\", \"value\": \"a\"\}],\u{a}        [\{\"type\": \"string\", \"value\": \"b\"\}]\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/nospaces" {
    expect(reads("ints = [1,2,3]\u{a}", "\{\u{a}    \"ints\": [\u{a}        \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/open-parent-table" {
    expect(reads("[[parent-table.arr]]\u{a}[[parent-table.arr]]\u{a}[parent-table]\u{a}not-arr = 1\u{a}", "\{\u{a}    \"parent-table\": \{\u{a}        \"not-arr\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \"arr\": [\u{a}            \{\},\u{a}            \{\}\u{a}        ]\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/array/string-quote-comma-01" {
    expect(reads("title = [\u{a}\"Client: \\\"XXXX\\\", Job: XXXX\",\u{a}\"Code: XXXX\"\u{a}]\u{a}", "\{\u{a}    \"title\": [\u{a}        \{\"type\": \"string\", \"value\": \"Client: \\\"XXXX\\\", Job: XXXX\"\},\u{a}        \{\"type\": \"string\", \"value\": \"Code: XXXX\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/string-quote-comma-02" {
    expect(reads("title = [ \" \\\", \",]\u{a}", "\{\u{a}    \"title\": [\{\"type\": \"string\", \"value\": \" \\\", \"\}]\u{a}\}\u{a}"))
}

test "valid/array/string-with-comma-01" {
    expect(reads("title = [\u{a}\"Client: XXXX, Job: XXXX\",\u{a}\"Code: XXXX\"\u{a}]\u{a}", "\{\u{a}    \"title\": [\u{a}        \{\"type\": \"string\", \"value\": \"Client: XXXX, Job: XXXX\"\},\u{a}        \{\"type\": \"string\", \"value\": \"Code: XXXX\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/string-with-comma-02" {
    expect(reads("title = [\u{a}\"\"\"Client: XXXX,\u{a}Job: XXXX\"\"\",\u{a}\"Code: XXXX\"\u{a}]\u{a}", "\{\u{a}    \"title\": [\u{a}        \{\"type\": \"string\", \"value\": \"Client: XXXX,\\nJob: XXXX\"\},\u{a}        \{\"type\": \"string\", \"value\": \"Code: XXXX\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/strings" {
    expect(reads("string_array = [ \"all\", 'strings', \"\"\"are the same\"\"\", '''type''']\u{a}", "\{\u{a}    \"string_array\": [\u{a}        \{\"type\": \"string\", \"value\": \"all\"\},\u{a}        \{\"type\": \"string\", \"value\": \"strings\"\},\u{a}        \{\"type\": \"string\", \"value\": \"are the same\"\},\u{a}        \{\"type\": \"string\", \"value\": \"type\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/array/table-array-string-backslash" {
    expect(reads("foo = [ \{ bar=\"\\\"\{\{baz\}\}\\\"\"\} ]\u{a}", "\{\u{a}    \"foo\": [\{\u{a}        \"bar\": \{\"type\": \"string\", \"value\": \"\\\"\{\{baz\}\}\\\"\"\}\u{a}    \}]\u{a}\}\u{a}"))
}

test "valid/array/trailing-comma" {
    expect(reads("arr-1 = [1,]\u{a}\u{a}arr-2 = [2,3,]\u{a}\u{a}arr-3 = [4,\u{a}]\u{a}\u{a}arr-4 = [\u{a}\u{9}5,\u{a}\u{9}6,\u{a}]\u{a}", "\{\u{a}    \"arr-1\": [\{\"type\": \"integer\", \"value\": \"1\"\}],\u{a}    \"arr-3\": [\{\"type\": \"integer\", \"value\": \"4\"\}],\u{a}    \"arr-2\": [\u{a}        \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}    ],\u{a}    \"arr-4\": [\u{a}        \{\"type\": \"integer\", \"value\": \"5\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"6\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/bool/bool" {
    expect(reads("t = true\u{a}f = false\u{a}", "\{\u{a}    \"f\": \{\"type\": \"bool\", \"value\": \"false\"\},\u{a}    \"t\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}\}\u{a}"))
}

test "valid/comment/after-literal-no-ws" {
    expect(reads("inf=inf#infinity\u{a}nan=nan#not a number\u{a}true=true#true\u{a}false=false#false\u{a}", "\{\u{a}    \"false\": \{\"type\": \"bool\", \"value\": \"false\"\},\u{a}    \"inf\":   \{\"type\": \"float\", \"value\": \"inf\"\},\u{a}    \"nan\":   \{\"type\": \"float\", \"value\": \"nan\"\},\u{a}    \"true\":  \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}\}\u{a}"))
}

test "valid/comment/at-eof" {
    expect(reads("# This is a full-line comment\u{a}key = \"value\" # This is a comment at the end of a line\u{a}", "\{\u{a}    \"key\": \{\"type\": \"string\", \"value\": \"value\"\}\u{a}\}\u{a}"))
}

test "valid/comment/at-eof2" {
    expect(reads("# This is a full-line comment\u{a}key = \"value\" # This is a comment at the end of a line\u{a}", "\{\u{a}    \"key\": \{\"type\": \"string\", \"value\": \"value\"\}\u{a}\}\u{a}"))
}

test "valid/comment/everywhere" {
    expect(reads("# Top comment.\u{a}  # Top comment.\u{a}# Top comment.\u{a}\u{a}# [no-extraneous-groups-please]\u{a}\u{a}[group] # Comment\u{a}answer = 42 # Comment\u{a}# no-extraneous-keys-please = 999\u{a}# Inbetween comment.\u{a}more = [ # Comment\u{a}  # What about multiple # comments?\u{a}  # Can you handle it?\u{a}  #\u{a}          # Evil.\u{a}# Evil.\u{a}  42, 42, # Comments within arrays are fun.\u{a}  # What about multiple # comments?\u{a}  # Can you handle it?\u{a}  #\u{a}          # Evil.\u{a}# Evil.\u{a}# ] Did I fool you?\u{a}] # Hopefully not.\u{a}\u{a}# Make sure the space between the datetime and \"#\" isn't lexed.\u{a}dt = 1979-05-27T07:32:12-07:00  # c\u{a}d = 1979-05-27 # Comment\u{a}\u{a}[[aot]] # Comment\u{a}k = 98 # Comment\u{a}[[aot]]# Comment\u{a}k = 99# Comment\u{a}", "\{\u{a}    \"aot\": [\u{a}        \{\u{a}            \"k\": \{\"type\": \"integer\", \"value\": \"98\"\}\u{a}        \},\u{a}        \{\u{a}            \"k\": \{\"type\": \"integer\", \"value\": \"99\"\}\u{a}        \}\u{a}    ],\u{a}    \"group\": \{\u{a}        \"answer\": \{\"type\": \"integer\", \"value\": \"42\"\},\u{a}        \"d\":      \{\"type\": \"date-local\", \"value\": \"1979-05-27\"\},\u{a}        \"dt\":     \{\"type\": \"datetime\", \"value\": \"1979-05-27T07:32:12-07:00\"\},\u{a}        \"more\": [\u{a}            \{\"type\": \"integer\", \"value\": \"42\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"42\"\}\u{a}        ]\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/comment/noeol" {
    expect(reads("# single comment without any eol characters", "\{\}\u{a}"))
}

test "valid/comment/nonascii" {
    expect(reads("# ~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\u{a}", "\{\}\u{a}"))
}

test "valid/comment/tricky" {
    expect(reads("[section]#attached comment\u{a}#[notsection]\u{a}one = \"11\"#cmt\u{a}two = \"22#\"\u{a}three = '#'\u{a}\u{a}four = \"\"\"# no comment\u{a}# nor this\u{a}#also not comment\"\"\"#is_comment\u{a}\u{a}five = 5.5#66\u{a}six = 6#7\u{a}8 = \"eight\"\u{a}#nine = 99\u{a}ten = 10e2#1\u{a}eleven = 1.11e1#23\u{a}\u{a}[\"hash#tag\"]\u{a}\"#!\" = \"hash bang\"\u{a}arr3 = [ \"#\", '#', \"\"\"###\"\"\" ]\u{a}arr4 = [ 1,# 9, 9,\u{a}2#,9\u{a},#9\u{a}3#]\u{a},4]\u{a}arr5 = [[[[#[\"#\"],\u{a}[\"#\"]]]]#]\u{a}]\u{a}tbl1 = \{ \"#\" = '\}#'\}#\}\}\u{a}\u{a}\u{a}", "\{\u{a}    \"hash#tag\": \{\u{a}        \"#!\":   \{\"type\": \"string\", \"value\": \"hash bang\"\},\u{a}        \"arr5\": [[[[[\{\"type\": \"string\", \"value\": \"#\"\}]]]]],\u{a}        \"arr3\": [\u{a}            \{\"type\": \"string\", \"value\": \"#\"\},\u{a}            \{\"type\": \"string\", \"value\": \"#\"\},\u{a}            \{\"type\": \"string\", \"value\": \"###\"\}\u{a}        ],\u{a}        \"arr4\": [\u{a}            \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"3\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"4\"\}\u{a}        ],\u{a}        \"tbl1\": \{\u{a}            \"#\": \{\"type\": \"string\", \"value\": \"\}#\"\}\u{a}        \}\u{a}    \},\u{a}    \"section\": \{\u{a}        \"8\":      \{\"type\": \"string\", \"value\": \"eight\"\},\u{a}        \"eleven\": \{\"type\": \"float\", \"value\": \"11.1\"\},\u{a}        \"five\":   \{\"type\": \"float\", \"value\": \"5.5\"\},\u{a}        \"four\":   \{\"type\": \"string\", \"value\": \"# no comment\\n# nor this\\n#also not comment\"\},\u{a}        \"one\":    \{\"type\": \"string\", \"value\": \"11\"\},\u{a}        \"six\":    \{\"type\": \"integer\", \"value\": \"6\"\},\u{a}        \"ten\":    \{\"type\": \"float\", \"value\": \"1000.0\"\},\u{a}        \"three\":  \{\"type\": \"string\", \"value\": \"#\"\},\u{a}        \"two\":    \{\"type\": \"string\", \"value\": \"22#\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/datetime/datetime" {
    expect(reads("space = 1987-07-05 17:45:00Z\u{a}\u{a}# ABNF is case-insensitive, both \"Z\" and \"z\" must be supported.\u{a}lower = 1987-07-05t17:45:00z\u{a}", "\{\u{a}    \"lower\": \{\"type\": \"datetime\", \"value\": \"1987-07-05T17:45:00Z\"\},\u{a}    \"space\": \{\"type\": \"datetime\", \"value\": \"1987-07-05T17:45:00Z\"\}\u{a}\}\u{a}"))
}

test "valid/datetime/edge" {
    expect(reads("first-offset = 0001-01-01 00:00:00Z\u{a}first-local  = 0001-01-01 00:00:00\u{a}first-date   = 0001-01-01\u{a}\u{a}last-offset = 9999-12-31 23:59:59Z\u{a}last-local  = 9999-12-31 23:59:59\u{a}last-date   = 9999-12-31\u{a}", "\{\u{a}    \"first-date\":   \{\"type\": \"date-local\", \"value\": \"0001-01-01\"\},\u{a}    \"first-local\":  \{\"type\": \"datetime-local\", \"value\": \"0001-01-01T00:00:00\"\},\u{a}    \"first-offset\": \{\"type\": \"datetime\", \"value\": \"0001-01-01T00:00:00Z\"\},\u{a}    \"last-date\":    \{\"type\": \"date-local\", \"value\": \"9999-12-31\"\},\u{a}    \"last-local\":   \{\"type\": \"datetime-local\", \"value\": \"9999-12-31T23:59:59\"\},\u{a}    \"last-offset\":  \{\"type\": \"datetime\", \"value\": \"9999-12-31T23:59:59Z\"\}\u{a}\}\u{a}"))
}

test "valid/datetime/invalid-date-in-string" {
    expect(reads("s = '2020-01-01x'\u{a}", "\{\u{a}    \"s\": \{\"type\": \"string\", \"value\": \"2020-01-01x\"\}\u{a}\}\u{a}"))
}

test "valid/datetime/leap-year" {
    expect(reads("2000-datetime       = 2000-02-29 15:15:15Z\u{a}2000-datetime-local = 2000-02-29 15:15:15\u{a}2000-date           = 2000-02-29\u{a}\u{a}2024-datetime       = 2024-02-29 15:15:15Z\u{a}2024-datetime-local = 2024-02-29 15:15:15\u{a}2024-date           = 2024-02-29\u{a}", "\{\u{a}    \"2000-date\":           \{\"type\": \"date-local\", \"value\": \"2000-02-29\"\},\u{a}    \"2000-datetime\":       \{\"type\": \"datetime\", \"value\": \"2000-02-29T15:15:15Z\"\},\u{a}    \"2000-datetime-local\": \{\"type\": \"datetime-local\", \"value\": \"2000-02-29T15:15:15\"\},\u{a}    \"2024-date\":           \{\"type\": \"date-local\", \"value\": \"2024-02-29\"\},\u{a}    \"2024-datetime\":       \{\"type\": \"datetime\", \"value\": \"2024-02-29T15:15:15Z\"\},\u{a}    \"2024-datetime-local\": \{\"type\": \"datetime-local\", \"value\": \"2024-02-29T15:15:15\"\}\u{a}\}\u{a}"))
}

test "valid/datetime/local-date" {
    expect(reads("bestdayever = 1987-07-05\u{a}", "\{\u{a}    \"bestdayever\": \{\"type\": \"date-local\", \"value\": \"1987-07-05\"\}\u{a}\}\u{a}"))
}

test "valid/datetime/local-time" {
    expect(reads("besttimeever = 17:45:00\u{a}milliseconds = 10:32:00.555\u{a}", "\{\u{a}    \"besttimeever\": \{\"type\": \"time-local\", \"value\": \"17:45:00\"\},\u{a}    \"milliseconds\": \{\"type\": \"time-local\", \"value\": \"10:32:00.555\"\}\u{a}\}\u{a}"))
}

test "valid/datetime/local" {
    expect(reads("local = 1987-07-05T17:45:00\u{a}milli = 1977-12-21T10:32:00.555\u{a}space = 1987-07-05 17:45:00\u{a}", "\{\u{a}    \"local\": \{\"type\": \"datetime-local\", \"value\": \"1987-07-05T17:45:00\"\},\u{a}    \"milli\": \{\"type\": \"datetime-local\", \"value\": \"1977-12-21T10:32:00.555\"\},\u{a}    \"space\": \{\"type\": \"datetime-local\", \"value\": \"1987-07-05T17:45:00\"\}\u{a}\}\u{a}"))
}

test "valid/datetime/milliseconds" {
    expect(reads("utc1  = 1987-07-05T17:45:56.123Z\u{a}utc2  = 1987-07-05T17:45:56.6Z\u{a}wita1 = 1987-07-05T17:45:56.123+08:00\u{a}wita2 = 1987-07-05T17:45:56.6+08:00\u{a}", "\{\u{a}    \"utc1\":  \{\"type\": \"datetime\", \"value\": \"1987-07-05T17:45:56.123Z\"\},\u{a}    \"utc2\":  \{\"type\": \"datetime\", \"value\": \"1987-07-05T17:45:56.600Z\"\},\u{a}    \"wita1\": \{\"type\": \"datetime\", \"value\": \"1987-07-05T17:45:56.123+08:00\"\},\u{a}    \"wita2\": \{\"type\": \"datetime\", \"value\": \"1987-07-05T17:45:56.600+08:00\"\}\u{a}\}\u{a}"))
}

test "valid/datetime/no-seconds" {
    expect(reads("# Seconds are optional in date-time and time.\u{a}without-seconds-1 = 13:37\u{a}without-seconds-2 = 1979-05-27 07:32Z\u{a}without-seconds-3 = 1979-05-27 07:32-07:00\u{a}without-seconds-4 = 1979-05-27T07:32\u{a}", "\{\u{a}    \"without-seconds-1\": \{\"type\": \"time-local\", \"value\": \"13:37:00\"\},\u{a}    \"without-seconds-2\": \{\"type\": \"datetime\", \"value\": \"1979-05-27T07:32:00Z\"\},\u{a}    \"without-seconds-3\": \{\"type\": \"datetime\", \"value\": \"1979-05-27T07:32:00-07:00\"\},\u{a}    \"without-seconds-4\": \{\"type\": \"datetime-local\", \"value\": \"1979-05-27T07:32:00\"\}\u{a}\}\u{a}"))
}

test "valid/datetime/timezone" {
    expect(reads("utc  = 1987-07-05T17:45:56Z\u{a}pdt  = 1987-07-05T17:45:56-05:00\u{a}nzst = 1987-07-05T17:45:56+12:00\u{a}nzdt = 1987-07-05T17:45:56+13:00  # DST\u{a}", "\{\u{a}    \"nzdt\": \{\"type\": \"datetime\", \"value\": \"1987-07-05T17:45:56+13:00\"\},\u{a}    \"nzst\": \{\"type\": \"datetime\", \"value\": \"1987-07-05T17:45:56+12:00\"\},\u{a}    \"pdt\":  \{\"type\": \"datetime\", \"value\": \"1987-07-05T17:45:56-05:00\"\},\u{a}    \"utc\":  \{\"type\": \"datetime\", \"value\": \"1987-07-05T17:45:56Z\"\}\u{a}\}\u{a}"))
}

test "valid/empty-crlf" {
    expect(reads("\u{d}\u{a}", "\{\}\u{a}"))
}

test "valid/empty-lf" {
    expect(reads("\u{a}", "\{\}\u{a}"))
}

test "valid/empty-nothing" {
    expect(reads("", "\{\}\u{a}"))
}

test "valid/empty-space" {
    expect(reads(" ", "\{\}\u{a}"))
}

test "valid/empty-tab" {
    expect(reads("\u{9}", "\{\}\u{a}"))
}

test "valid/example" {
    expect(reads("best-day-ever = 1987-07-05T17:45:00Z\u{a}\u{a}[numtheory]\u{a}boring = false\u{a}perfection = [6, 28, 496]\u{a}", "\{\u{a}    \"best-day-ever\": \{\"type\": \"datetime\", \"value\": \"1987-07-05T17:45:00Z\"\},\u{a}    \"numtheory\": \{\u{a}        \"boring\": \{\"type\": \"bool\", \"value\": \"false\"\},\u{a}        \"perfection\": [\u{a}            \{\"type\": \"integer\", \"value\": \"6\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"28\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"496\"\}\u{a}        ]\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/float/exponent-upper" {
    expect(reads("# Both upper- and lower-case \"e\" is valid, so repeat the exponent.toml test with\u{a}# upper-case.\u{a}exp        = 3E2\u{a}pos-exp    = 3E+2\u{a}neg-exp    = 3E-2\u{a}zero-exp   = 3E0\u{a}frac       = 3.1E2\u{a}neg        = -1E-1\u{a}zero       = 0E2\u{a}zero-plus = +0E2\u{a}", "\{\u{a}    \"exp\":       \{\"type\": \"float\", \"value\": \"300\"\},\u{a}    \"frac\":      \{\"type\": \"float\", \"value\": \"310\"\},\u{a}    \"neg\":       \{\"type\": \"float\", \"value\": \"-0.1\"\},\u{a}    \"neg-exp\":   \{\"type\": \"float\", \"value\": \"0.03\"\},\u{a}    \"pos-exp\":   \{\"type\": \"float\", \"value\": \"300\"\},\u{a}    \"zero\":      \{\"type\": \"float\", \"value\": \"0\"\},\u{a}    \"zero-exp\":  \{\"type\": \"float\", \"value\": \"3\"\},\u{a}    \"zero-plus\": \{\"type\": \"float\", \"value\": \"0\"\}\u{a}\}\u{a}"))
}

test "valid/float/exponent" {
    expect(reads("# Please keep exponent-upper.toml in sync with this.\u{a}\u{a}exp       = 3e2\u{a}pos-exp   = 3e+2\u{a}neg-exp   = 3e-2\u{a}zero-exp  = 3e0\u{a}frac      = 3.1e2\u{a}neg       = -1e-1\u{a}zero      = 0e2\u{a}zero-plus = +0e2\u{a}", "\{\u{a}    \"exp\":       \{\"type\": \"float\", \"value\": \"300\"\},\u{a}    \"frac\":      \{\"type\": \"float\", \"value\": \"310\"\},\u{a}    \"neg\":       \{\"type\": \"float\", \"value\": \"-0.1\"\},\u{a}    \"neg-exp\":   \{\"type\": \"float\", \"value\": \"0.03\"\},\u{a}    \"pos-exp\":   \{\"type\": \"float\", \"value\": \"300\"\},\u{a}    \"zero\":      \{\"type\": \"float\", \"value\": \"0\"\},\u{a}    \"zero-exp\":  \{\"type\": \"float\", \"value\": \"3\"\},\u{a}    \"zero-plus\": \{\"type\": \"float\", \"value\": \"0\"\}\u{a}\}\u{a}"))
}

test "valid/float/float" {
    expect(reads("pi = 3.14\u{a}pospi = +3.14\u{a}negpi = -3.14\u{a}zero-intpart = 0.123\u{a}leading-zero-fractional = 0.0123\u{a}", "\{\u{a}    \"negpi\":                   \{\"type\": \"float\", \"value\": \"-3.14\"\},\u{a}    \"pi\":                      \{\"type\": \"float\", \"value\": \"3.14\"\},\u{a}    \"pospi\":                   \{\"type\": \"float\", \"value\": \"3.14\"\},\u{a}    \"zero-intpart\":            \{\"type\": \"float\", \"value\": \"0.123\"\},\u{a}    \"leading-zero-fractional\": \{\"type\": \"float\", \"value\": \"0.0123\"\}\u{a}\}\u{a}"))
}

test "valid/float/inf-and-nan" {
    expect(reads("# We don't encode +nan and -nan back with the signs; many languages don't\u{a}# support a sign on NaN (it doesn't really make much sense).\u{a}nan = nan\u{a}nan_neg = -nan\u{a}nan_plus = +nan\u{a}infinity = inf\u{a}infinity_neg = -inf\u{a}infinity_plus = +inf\u{a}", "\{\u{a}    \"infinity\":      \{\"type\": \"float\", \"value\": \"inf\"\},\u{a}    \"infinity_neg\":  \{\"type\": \"float\", \"value\": \"-inf\"\},\u{a}    \"infinity_plus\": \{\"type\": \"float\", \"value\": \"inf\"\},\u{a}    \"nan\":           \{\"type\": \"float\", \"value\": \"nan\"\},\u{a}    \"nan_neg\":       \{\"type\": \"float\", \"value\": \"nan\"\},\u{a}    \"nan_plus\":      \{\"type\": \"float\", \"value\": \"nan\"\}\u{a}\}\u{a}"))
}

test "valid/float/long" {
    expect(reads("longpi = 3.141592653589793\u{a}neglongpi = -3.141592653589793\u{a}", "\{\u{a}    \"longpi\":    \{\"type\": \"float\", \"value\": \"3.141592653589793\"\},\u{a}    \"neglongpi\": \{\"type\": \"float\", \"value\": \"-3.141592653589793\"\}\u{a}\}\u{a}"))
}

test "valid/float/max-int" {
    expect(reads("# Maximum and minimum safe natural numbers.\u{a}max_float =  9_007_199_254_740_991.0\u{a}min_float = -9_007_199_254_740_991.0\u{a}", "\{\u{a}    \"max_float\": \{\"type\": \"float\", \"value\": \"9007199254740991\"\},\u{a}    \"min_float\": \{\"type\": \"float\", \"value\": \"-9007199254740991\"\}\u{a}\}\u{a}"))
}

test "valid/float/underscore" {
    expect(reads("before = 3_141.5927\u{a}after = 3141.592_7\u{a}exponent = 3e1_4\u{a}", "\{\u{a}    \"after\":    \{\"type\": \"float\", \"value\": \"3141.5927\"\},\u{a}    \"before\":   \{\"type\": \"float\", \"value\": \"3141.5927\"\},\u{a}    \"exponent\": \{\"type\": \"float\", \"value\": \"3.0e14\"\}\u{a}\}\u{a}"))
}

test "valid/float/zero" {
    expect(reads("zero = 0.0\u{a}signed-pos = +0.0\u{a}signed-neg = -0.0\u{a}exponent = 0e0\u{a}exponent-two-0 = 0e00\u{a}exponent-signed-pos = +0e0\u{a}exponent-signed-neg = -0e0\u{a}", "\{\u{a}    \"exponent\":            \{\"type\": \"float\", \"value\": \"0\"\},\u{a}    \"exponent-signed-neg\": \{\"type\": \"float\", \"value\": \"-0\"\},\u{a}    \"exponent-signed-pos\": \{\"type\": \"float\", \"value\": \"0\"\},\u{a}    \"exponent-two-0\":      \{\"type\": \"float\", \"value\": \"0\"\},\u{a}    \"signed-neg\":          \{\"type\": \"float\", \"value\": \"-0\"\},\u{a}    \"signed-pos\":          \{\"type\": \"float\", \"value\": \"0\"\},\u{a}    \"zero\":                \{\"type\": \"float\", \"value\": \"0\"\}\u{a}\}\u{a}"))
}

test "valid/implicit-and-explicit-after" {
    expect(reads("[a.b.c]\u{a}answer = 42\u{a}\u{a}[a]\u{a}better = 43\u{a}", "\{\u{a}    \"a\": \{\u{a}        \"better\": \{\"type\": \"integer\", \"value\": \"43\"\},\u{a}        \"b\": \{\u{a}            \"c\": \{\u{a}                \"answer\": \{\"type\": \"integer\", \"value\": \"42\"\}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/implicit-and-explicit-before" {
    expect(reads("[a]\u{a}better = 43\u{a}\u{a}[a.b.c]\u{a}answer = 42\u{a}", "\{\u{a}    \"a\": \{\u{a}        \"better\": \{\"type\": \"integer\", \"value\": \"43\"\},\u{a}        \"b\": \{\u{a}            \"c\": \{\u{a}                \"answer\": \{\"type\": \"integer\", \"value\": \"42\"\}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/implicit-groups" {
    expect(reads("[a.b.c]\u{a}answer = 42\u{a}", "\{\u{a}    \"a\": \{\u{a}        \"b\": \{\u{a}            \"c\": \{\u{a}                \"answer\": \{\"type\": \"integer\", \"value\": \"42\"\}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/array-01" {
    expect(reads("arr = [ \{'a'= 1\}, \{'a'= 2\} ]\u{a}\u{a}people = [\{first_name = \"Bruce\", last_name = \"Springsteen\"\},\u{a}          \{first_name = \"Eric\", last_name = \"Clapton\"\},\u{a}          \{first_name = \"Bob\", last_name = \"Seger\"\}]\u{a}", "\{\u{a}    \"arr\": [\u{a}        \{\u{a}            \"a\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \},\u{a}        \{\u{a}            \"a\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}        \}\u{a}    ],\u{a}    \"people\": [\u{a}        \{\u{a}            \"first_name\": \{\"type\": \"string\", \"value\": \"Bruce\"\},\u{a}            \"last_name\":  \{\"type\": \"string\", \"value\": \"Springsteen\"\}\u{a}        \},\u{a}        \{\u{a}            \"first_name\": \{\"type\": \"string\", \"value\": \"Eric\"\},\u{a}            \"last_name\":  \{\"type\": \"string\", \"value\": \"Clapton\"\}\u{a}        \},\u{a}        \{\u{a}            \"first_name\": \{\"type\": \"string\", \"value\": \"Bob\"\},\u{a}            \"last_name\":  \{\"type\": \"string\", \"value\": \"Seger\"\}\u{a}        \}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/inline-table/array-02" {
    expect(reads("# \"No newlines are allowed between the curly braces unless they are valid within\u{a}# a value\"\u{a}\u{a}a = \{ a = [\u{a}]\}\u{a}", "\{\u{a}    \"a\": \{\"a\": []\}\u{a}\}\u{a}"))
}

test "valid/inline-table/array-03" {
    expect(reads("b = \{ a = [\u{a}\u{9}\u{9}1,\u{a}\u{9}\u{9}2,\u{a}\u{9}], b = [\u{a}\u{9}\u{9}3,\u{a}\u{9}\u{9}4,\u{a}\u{9}]\}\u{a}", "\{\u{a}    \"b\": \{\u{a}        \"a\": [\u{a}            \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}        ],\u{a}        \"b\": [\u{a}            \{\"type\": \"integer\", \"value\": \"3\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"4\"\}\u{a}        ]\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/bool" {
    expect(reads("a = \{a = true, b = false\}\u{a}", "\{\u{a}    \"a\": \{\u{a}        \"a\": \{\"type\": \"bool\", \"value\": \"true\"\},\u{a}        \"b\": \{\"type\": \"bool\", \"value\": \"false\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/empty" {
    expect(reads("empty1 = \{\}\u{a}empty2 = \{ \}\u{a}empty_in_array = [ \{ not_empty = 1 \}, \{\} ]\u{a}empty_in_array2 = [\{\},\{not_empty=1\}]\u{a}many_empty = [\{\},\{\},\{\}]\u{a}nested_empty = \{\"empty\"=\{\}\}\u{a}with_cmt =\{            \}#nothing here\u{a}", "\{\u{a}    \"empty1\":   \{\},\u{a}    \"empty2\":   \{\},\u{a}    \"with_cmt\": \{\},\u{a}    \"empty_in_array\": [\u{a}        \{\u{a}            \"not_empty\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \},\u{a}        \{\}\u{a}    ],\u{a}    \"empty_in_array2\": [\u{a}        \{\},\u{a}        \{\u{a}            \"not_empty\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    ],\u{a}    \"many_empty\": [\u{a}        \{\},\u{a}        \{\},\u{a}        \{\}\u{a}    ],\u{a}    \"nested_empty\": \{\u{a}        \"empty\": \{\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/end-in-bool" {
    expect(reads("black = \{ python=\">3.6\", version=\">=18.9b0\", allow_prereleases=true \}\u{a}", "\{\u{a}    \"black\": \{\u{a}        \"allow_prereleases\": \{\"type\": \"bool\", \"value\": \"true\"\},\u{a}        \"python\":            \{\"type\": \"string\", \"value\": \"\\u003e3.6\"\},\u{a}        \"version\":           \{\"type\": \"string\", \"value\": \"\\u003e=18.9b0\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/inline-table" {
    expect(reads("name        = \{ first = \"Tom\", last = \"Preston-Werner\" \}\u{a}point       = \{ x = 1, y = 2 \}\u{a}simple      = \{ a = 1 \}\u{a}str-key     = \{ \"a\" = 1 \}\u{a}table-array = [\{ \"a\" = 1 \}, \{ \"b\" = 2 \}]\u{a}", "\{\u{a}    \"name\": \{\u{a}        \"first\": \{\"type\": \"string\", \"value\": \"Tom\"\},\u{a}        \"last\":  \{\"type\": \"string\", \"value\": \"Preston-Werner\"\}\u{a}    \},\u{a}    \"point\": \{\u{a}        \"x\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \"y\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    \},\u{a}    \"simple\": \{\u{a}        \"a\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \},\u{a}    \"str-key\": \{\u{a}        \"a\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \},\u{a}    \"table-array\": [\u{a}        \{\u{a}            \"a\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \},\u{a}        \{\u{a}            \"b\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}        \}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/inline-table/key-dotted-01" {
    expect(reads("a = \{   a.b  =  1   \}\u{a}b = \{   \"a\".\"b\"  =  1   \}\u{a}c = \{   a   .   b  =  1   \}\u{a}d = \{   'a'   .   \"b\"  =  1   \}\u{a}e = \{a.b=1\}\u{a}", "\{\u{a}    \"a\": \{\u{a}        \"a\": \{\u{a}            \"b\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    \},\u{a}    \"b\": \{\u{a}        \"a\": \{\u{a}            \"b\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    \},\u{a}    \"c\": \{\u{a}        \"a\": \{\u{a}            \"b\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    \},\u{a}    \"d\": \{\u{a}        \"a\": \{\u{a}            \"b\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    \},\u{a}    \"e\": \{\u{a}        \"a\": \{\u{a}            \"b\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/key-dotted-02" {
    expect(reads("many.dots.here.dot.dot.dot = \{a.b.c = 1, a.b.d = 2\}\u{a}", "\{\u{a}    \"many\": \{\u{a}        \"dots\": \{\u{a}            \"here\": \{\u{a}                \"dot\": \{\u{a}                    \"dot\": \{\u{a}                        \"dot\": \{\u{a}                            \"a\": \{\u{a}                                \"b\": \{\u{a}                                    \"c\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}                                    \"d\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}                                \}\u{a}                            \}\u{a}                        \}\u{a}                    \}\u{a}                \}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/key-dotted-03" {
    expect(reads("[tbl]\u{a}a.b.c = \{d.e=1\}\u{a}\u{a}[tbl.x]\u{a}a.b.c = \{d.e=1\}\u{a}", "\{\u{a}    \"tbl\": \{\u{a}        \"a\": \{\u{a}            \"b\": \{\u{a}                \"c\": \{\u{a}                    \"d\": \{\u{a}                        \"e\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}                    \}\u{a}                \}\u{a}            \}\u{a}        \},\u{a}        \"x\": \{\u{a}            \"a\": \{\u{a}                \"b\": \{\u{a}                    \"c\": \{\u{a}                        \"d\": \{\u{a}                            \"e\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}                        \}\u{a}                    \}\u{a}                \}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/key-dotted-04" {
    expect(reads("[[arr]]\u{a}t = \{a.b=1\}\u{a}T = \{a.b=1\}\u{a}\u{a}[[arr]]\u{a}t = \{a.b=2\}\u{a}T = \{a.b=2\}\u{a}", "\{\u{a}    \"arr\": [\u{a}        \{\u{a}            \"T\": \{\u{a}                \"a\": \{\u{a}                    \"b\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}                \}\u{a}            \},\u{a}            \"t\": \{\u{a}                \"a\": \{\u{a}                    \"b\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}                \}\u{a}            \}\u{a}        \},\u{a}        \{\u{a}            \"T\": \{\u{a}                \"a\": \{\u{a}                    \"b\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}                \}\u{a}            \},\u{a}            \"t\": \{\u{a}                \"a\": \{\u{a}                    \"b\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}                \}\u{a}            \}\u{a}        \}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/inline-table/key-dotted-05" {
    expect(reads("arr-1 = [\{a.b = 1\}]\u{a}arr-2 = [\"str\", \{a.b = 1\}]\u{a}\u{a}arr-3 = [\{a.b = 1\}, \{a.b = 2\}]\u{a}arr-4 = [\"str\", \{a.b = 1\}, \{a.b = 2\}]\u{a}", "\{\u{a}    \"arr-1\": [\{\u{a}        \"a\": \{\u{a}            \"b\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    \}],\u{a}    \"arr-2\": [\u{a}        \{\"type\": \"string\", \"value\": \"str\"\},\u{a}        \{\u{a}            \"a\": \{\u{a}                \"b\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}            \}\u{a}        \}\u{a}    ],\u{a}    \"arr-3\": [\u{a}        \{\u{a}            \"a\": \{\u{a}                \"b\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}            \}\u{a}        \},\u{a}        \{\u{a}            \"a\": \{\u{a}                \"b\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}            \}\u{a}        \}\u{a}    ],\u{a}    \"arr-4\": [\u{a}        \{\"type\": \"string\", \"value\": \"str\"\},\u{a}        \{\u{a}            \"a\": \{\u{a}                \"b\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}            \}\u{a}        \},\u{a}        \{\u{a}            \"a\": \{\u{a}                \"b\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}            \}\u{a}        \}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/inline-table/key-dotted-06" {
    expect(reads("top.dot.dot = [\u{a}\u{9}\{dot.dot.dot = 1\},\u{a}\u{9}\{dot.dot.dot = 2\},\u{a}]\u{a}", "\{\u{a}    \"top\": \{\u{a}        \"dot\": \{\u{a}            \"dot\": [\u{a}                \{\u{a}                    \"dot\": \{\u{a}                        \"dot\": \{\u{a}                            \"dot\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}                        \}\u{a}                    \}\u{a}                \},\u{a}                \{\u{a}                    \"dot\": \{\u{a}                        \"dot\": \{\u{a}                            \"dot\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}                        \}\u{a}                    \}\u{a}                \}\u{a}            ]\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/key-dotted-07" {
    expect(reads("arr = [\u{a}\u{9}\{a.b = [\{c.d = 1\}]\}\u{a}]\u{a}", "\{\u{a}    \"arr\": [\{\u{a}        \"a\": \{\"b\": [\{\u{a}            \"c\": \{\u{a}                \"d\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}            \}\u{a}        \}]\}\u{a}    \}]\u{a}\}\u{a}"))
}

test "valid/inline-table/multiline" {
    expect(reads("tbl_multiline = \{ a = 1, b = \"\"\"\u{a}multiline\u{a}\"\"\", c = \"\"\"and yet\u{a}another line\"\"\", d = 4 \}\u{a}", "\{\u{a}    \"tbl_multiline\": \{\u{a}        \"a\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \"b\": \{\"type\": \"string\", \"value\": \"multiline\\n\"\},\u{a}        \"c\": \{\"type\": \"string\", \"value\": \"and yet\\nanother line\"\},\u{a}        \"d\": \{\"type\": \"integer\", \"value\": \"4\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/nest" {
    expect(reads("tbl_tbl_empty = \{ tbl_0 = \{\} \}\u{a}tbl_tbl_val   = \{ tbl_1 = \{ one = 1 \} \}\u{a}tbl_arr_tbl   = \{ arr_tbl = [ \{ one = 1 \} ] \}\u{a}arr_tbl_tbl   = [ \{ tbl = \{ one = 1 \} \} ]\u{a}\u{a}# Array-of-array-of-table is interesting because it can only\u{a}# be represented in inline form.\u{a}arr_arr_tbl_empty = [ [ \{\} ] ]\u{a}arr_arr_tbl_val = [ [ \{ one = 1 \} ] ]\u{a}arr_arr_tbls  = [ [ \{ one = 1 \}, \{ two = 2 \} ] ]\u{a}", "\{\u{a}    \"arr_arr_tbl_empty\": [[\{\}]],\u{a}    \"arr_arr_tbl_val\":   [[\{\u{a}        \"one\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \}]],\u{a}    \"arr_arr_tbls\":      [[\u{a}        \{\u{a}            \"one\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \},\u{a}        \{\u{a}            \"two\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}        \}\u{a}    ]],\u{a}    \"arr_tbl_tbl\":       [\{\u{a}        \"tbl\": \{\u{a}            \"one\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    \}],\u{a}    \"tbl_arr_tbl\":       \{\"arr_tbl\": [\{\u{a}        \"one\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \}]\},\u{a}    \"tbl_tbl_empty\": \{\u{a}        \"tbl_0\": \{\}\u{a}    \},\u{a}    \"tbl_tbl_val\": \{\u{a}        \"tbl_1\": \{\u{a}            \"one\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/newline-comment" {
    expect(reads("# Identical to newline.toml, but with comments that shouldn't affect the\u{a}# results.\u{a}\u{a}trailing-comma-1 = \{#comment\u{a}\u{9}# comment\u{a}\u{9}c = 1,#comment\u{a}\u{9}#comment\u{a}\}#comment\u{a}trailing-comma-2 = \{ c = 1, \}#comment\u{a}\u{a}tbl-1 = \{#comment\u{a}\u{9}hello = \"world\",#comment\u{a}\u{9}1     = 2,#comment\u{a}\u{9}arr   = [1,#comment\u{a}\u{9}         2,#comment\u{a}\u{9}         3,#comment\u{a}\u{9}        ],#comment\u{a}\u{9}tbl = \{#comment\u{a}\u{9}\u{9} k = 1,#comment\u{a}\u{9}\}#comment\u{a}\}#comment\u{a}\u{a}tbl-2 = \{#comment\u{a}\u{9}k = \"\"\"\u{a}\u{9}Hello\u{a}\u{9}\"\"\"#comment\u{a}\}#comment\u{a}", "\{\u{a}    \"tbl-1\": \{\u{a}        \"1\":     \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}        \"hello\": \{\"type\": \"string\", \"value\": \"world\"\},\u{a}        \"arr\": [\u{a}            \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}        ],\u{a}        \"tbl\": \{\u{a}            \"k\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    \},\u{a}    \"tbl-2\": \{\u{a}        \"k\": \{\"type\": \"string\", \"value\": \"\\tHello\\n\\t\"\}\u{a}    \},\u{a}    \"trailing-comma-1\": \{\u{a}        \"c\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \},\u{a}    \"trailing-comma-2\": \{\u{a}        \"c\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/newline" {
    expect(reads("# TOML 1.1 supports newlines in inline tables and trailing commas.\u{a}\u{a}trailing-comma-1 = \{\u{a}\u{9}c = 1,\u{a}\}\u{a}trailing-comma-2 = \{ c = 1, \}\u{a}\u{a}tbl-1 = \{\u{a}\u{9}hello = \"world\",\u{a}\u{9}1     = 2,\u{a}\u{9}arr   = [1,\u{a}\u{9}         2,\u{a}\u{9}         3,\u{a}\u{9}        ],\u{a}\u{9}tbl = \{\u{a}\u{9}\u{9} k = 1,\u{a}\u{9}\}\u{a}\}\u{a}\u{a}tbl-2 = \{\u{a}\u{9}k = \"\"\"\u{a}\u{9}Hello\u{a}\u{9}\"\"\"\u{a}\}\u{a}\u{a}no-newline-before-brace = \{\u{a}a = 1,\u{a}b = 2\}\u{a}\u{a}no-newline-before-brace-with-comma = \{\u{a}a = 1,\u{a}b = 2,\}\u{a}", "\{\u{a}    \"no-newline-before-brace\": \{\u{a}        \"a\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \"b\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    \},\u{a}    \"no-newline-before-brace-with-comma\": \{\u{a}        \"a\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \"b\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    \},\u{a}    \"tbl-1\": \{\u{a}        \"1\":     \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}        \"hello\": \{\"type\": \"string\", \"value\": \"world\"\},\u{a}        \"arr\": [\u{a}            \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}        ],\u{a}        \"tbl\": \{\u{a}            \"k\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    \},\u{a}    \"tbl-2\": \{\u{a}        \"k\": \{\"type\": \"string\", \"value\": \"\\tHello\\n\\t\"\}\u{a}    \},\u{a}    \"trailing-comma-1\": \{\u{a}        \"c\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \},\u{a}    \"trailing-comma-2\": \{\u{a}        \"c\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/inline-table/spaces" {
    expect(reads("# https://github.com/toml-lang/toml-test/issues/146\u{a}clap-1 = \{ version = \"4\"  , features = [\"derive\", \"cargo\"] \}\u{a}\u{a}# Contains some literal tabs!\u{a}clap-2 = \{ version = \"4\"\u{9}   \u{9},\u{9}  \u{9}features = [   \"derive\" \u{9}  ,  \u{9}  \"cargo\"   ]   , nest   =   \{  \u{9}  \"a\"   =   'x'  , \u{9}  'b'   = [ 1.5    ,   9.0  ]  \}  \}\u{a}", "\{\u{a}    \"clap-1\": \{\u{a}        \"version\": \{\"type\": \"string\", \"value\": \"4\"\},\u{a}        \"features\": [\u{a}            \{\"type\": \"string\", \"value\": \"derive\"\},\u{a}            \{\"type\": \"string\", \"value\": \"cargo\"\}\u{a}        ]\u{a}    \},\u{a}    \"clap-2\": \{\u{a}        \"version\": \{\"type\": \"string\", \"value\": \"4\"\},\u{a}        \"features\": [\u{a}            \{\"type\": \"string\", \"value\": \"derive\"\},\u{a}            \{\"type\": \"string\", \"value\": \"cargo\"\}\u{a}        ],\u{a}        \"nest\": \{\u{a}            \"a\": \{\"type\": \"string\", \"value\": \"x\"\},\u{a}            \"b\": [\u{a}                \{\"type\": \"float\", \"value\": \"1.5\"\},\u{a}                \{\"type\": \"float\", \"value\": \"9\"\}\u{a}            ]\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/integer/float64-max" {
    expect(reads("# Maximum and minimum safe float64 natural numbers. Mainly here for\u{a}# -int-as-float.\u{a}max_int =  9_007_199_254_740_991\u{a}min_int = -9_007_199_254_740_991\u{a}", "\{\u{a}    \"max_int\": \{\"type\": \"integer\", \"value\": \"9007199254740991\"\},\u{a}    \"min_int\": \{\"type\": \"integer\", \"value\": \"-9007199254740991\"\}\u{a}\}\u{a}"))
}

test "valid/integer/integer" {
    expect(reads("answer = 42\u{a}posanswer = +42\u{a}neganswer = -42\u{a}zero = 0\u{a}", "\{\u{a}    \"answer\":    \{\"type\": \"integer\", \"value\": \"42\"\},\u{a}    \"neganswer\": \{\"type\": \"integer\", \"value\": \"-42\"\},\u{a}    \"posanswer\": \{\"type\": \"integer\", \"value\": \"42\"\},\u{a}    \"zero\":      \{\"type\": \"integer\", \"value\": \"0\"\}\u{a}\}\u{a}"))
}

test "valid/integer/literals" {
    expect(reads("bin1 = 0b11010110\u{a}bin2 = 0b1_0_1\u{a}\u{a}oct1 = 0o01234567\u{a}oct2 = 0o755\u{a}oct3 = 0o7_6_5\u{a}\u{a}hex1 = 0xDEADBEEF\u{a}hex2 = 0xdeadbeef\u{a}hex3 = 0xdead_beef\u{a}hex4 = 0x00987\u{a}", "\{\u{a}    \"bin1\": \{\"type\": \"integer\", \"value\": \"214\"\},\u{a}    \"bin2\": \{\"type\": \"integer\", \"value\": \"5\"\},\u{a}    \"hex1\": \{\"type\": \"integer\", \"value\": \"3735928559\"\},\u{a}    \"hex2\": \{\"type\": \"integer\", \"value\": \"3735928559\"\},\u{a}    \"hex3\": \{\"type\": \"integer\", \"value\": \"3735928559\"\},\u{a}    \"hex4\": \{\"type\": \"integer\", \"value\": \"2439\"\},\u{a}    \"oct1\": \{\"type\": \"integer\", \"value\": \"342391\"\},\u{a}    \"oct2\": \{\"type\": \"integer\", \"value\": \"493\"\},\u{a}    \"oct3\": \{\"type\": \"integer\", \"value\": \"501\"\}\u{a}\}\u{a}"))
}

test "valid/integer/long" {
    expect(reads("# int64 \"should\" be supported, but is not mandatory. It's fine to skip this\u{a}# test.\u{a}int64-max     = 9223372036854775807\u{a}int64-max-neg = -9223372036854775808\u{a}", "\{\u{a}    \"int64-max\":     \{\"type\": \"integer\", \"value\": \"9223372036854775807\"\},\u{a}    \"int64-max-neg\": \{\"type\": \"integer\", \"value\": \"-9223372036854775808\"\}\u{a}\}\u{a}"))
}

test "valid/integer/underscore" {
    expect(reads("kilo = 1_000\u{a}x = 1_1_1_1\u{a}", "\{\u{a}    \"kilo\": \{\"type\": \"integer\", \"value\": \"1000\"\},\u{a}    \"x\":    \{\"type\": \"integer\", \"value\": \"1111\"\}\u{a}\}\u{a}"))
}

test "valid/integer/zero" {
    expect(reads("d1 = 0\u{a}d2 = +0\u{a}d3 = -0\u{a}\u{a}h1 = 0x0\u{a}h2 = 0x00\u{a}h3 = 0x00000\u{a}\u{a}o1 = 0o0\u{a}a2 = 0o00\u{a}a3 = 0o00000\u{a}\u{a}b1 = 0b0\u{a}b2 = 0b00\u{a}b3 = 0b00000\u{a}", "\{\u{a}    \"a2\": \{\"type\": \"integer\", \"value\": \"0\"\},\u{a}    \"a3\": \{\"type\": \"integer\", \"value\": \"0\"\},\u{a}    \"b1\": \{\"type\": \"integer\", \"value\": \"0\"\},\u{a}    \"b2\": \{\"type\": \"integer\", \"value\": \"0\"\},\u{a}    \"b3\": \{\"type\": \"integer\", \"value\": \"0\"\},\u{a}    \"d1\": \{\"type\": \"integer\", \"value\": \"0\"\},\u{a}    \"d2\": \{\"type\": \"integer\", \"value\": \"0\"\},\u{a}    \"d3\": \{\"type\": \"integer\", \"value\": \"0\"\},\u{a}    \"h1\": \{\"type\": \"integer\", \"value\": \"0\"\},\u{a}    \"h2\": \{\"type\": \"integer\", \"value\": \"0\"\},\u{a}    \"h3\": \{\"type\": \"integer\", \"value\": \"0\"\},\u{a}    \"o1\": \{\"type\": \"integer\", \"value\": \"0\"\}\u{a}\}\u{a}"))
}

test "valid/key/alphanum" {
    expect(reads("alpha = \"a\"\u{a}123 = \"num\"\u{a}000111 = \"leading\"\u{a}10e3 = \"false float\"\u{a}one1two2 = \"mixed\"\u{a}with-dash = \"dashed\"\u{a}under_score = \"___\"\u{a}34-11 = 23\u{a}\u{a}[2018_10]\u{a}001 = 1\u{a}\u{a}[a-a-a]\u{a}_ = false\u{a}", "\{\u{a}    \"000111\":      \{\"type\": \"string\", \"value\": \"leading\"\},\u{a}    \"10e3\":        \{\"type\": \"string\", \"value\": \"false float\"\},\u{a}    \"123\":         \{\"type\": \"string\", \"value\": \"num\"\},\u{a}    \"34-11\":       \{\"type\": \"integer\", \"value\": \"23\"\},\u{a}    \"alpha\":       \{\"type\": \"string\", \"value\": \"a\"\},\u{a}    \"one1two2\":    \{\"type\": \"string\", \"value\": \"mixed\"\},\u{a}    \"under_score\": \{\"type\": \"string\", \"value\": \"___\"\},\u{a}    \"with-dash\":   \{\"type\": \"string\", \"value\": \"dashed\"\},\u{a}    \"2018_10\": \{\u{a}        \"001\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \},\u{a}    \"a-a-a\": \{\u{a}        \"_\": \{\"type\": \"bool\", \"value\": \"false\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/case-sensitive" {
    expect(reads("sectioN = \"NN\"\u{a}\u{a}[section]\u{a}name = \"lower\"\u{a}NAME = \"upper\"\u{a}Name = \"capitalized\"\u{a}\u{a}[Section]\u{a}name = \"different section!!\"\u{a}\"\u{3bc}\" = \"greek small letter mu\"\u{a}\"\u{39c}\" = \"greek capital letter MU\"\u{a}M = \"latin letter M\"\u{a}\u{a}", "\{\u{a}    \"sectioN\": \{\"type\": \"string\", \"value\": \"NN\"\},\u{a}    \"Section\": \{\u{a}        \"M\":    \{\"type\": \"string\", \"value\": \"latin letter M\"\},\u{a}        \"name\": \{\"type\": \"string\", \"value\": \"different section!!\"\},\u{a}        \"\u{39c}\":    \{\"type\": \"string\", \"value\": \"greek capital letter MU\"\},\u{a}        \"\u{3bc}\":    \{\"type\": \"string\", \"value\": \"greek small letter mu\"\}\u{a}    \},\u{a}    \"section\": \{\u{a}        \"NAME\": \{\"type\": \"string\", \"value\": \"upper\"\},\u{a}        \"Name\": \{\"type\": \"string\", \"value\": \"capitalized\"\},\u{a}        \"name\": \{\"type\": \"string\", \"value\": \"lower\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/dotted-01" {
    expect(reads("name.first = \"Arthur\"\u{a}\"name\".'last' = \"Dent\"\u{a}\u{a}many.dots.dot.dot.dot = 42\u{a}", "\{\u{a}    \"many\": \{\u{a}        \"dots\": \{\u{a}            \"dot\": \{\u{a}                \"dot\": \{\u{a}                    \"dot\": \{\"type\": \"integer\", \"value\": \"42\"\}\u{a}                \}\u{a}            \}\u{a}        \}\u{a}    \},\u{a}    \"name\": \{\u{a}        \"first\": \{\"type\": \"string\", \"value\": \"Arthur\"\},\u{a}        \"last\":  \{\"type\": \"string\", \"value\": \"Dent\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/dotted-02" {
    expect(reads("# Note: this file contains literal tab characters.\u{a}\u{a}# Space are ignored, and key parts can be quoted.\u{a}count.a       = 1\u{a}count . b     = 2\u{a}\"count\".\"c\"   = 3\u{a}\"count\" . \"d\" = 4\u{a}'count'.'e'   = 5\u{a}'count' . 'f' = 6\u{a}\"count\".'g'   = 7\u{a}\"count\" . 'h' = 8\u{a}count.'i'     = 9\u{a}count \u{9}.\u{9} 'j'\u{9}   = 10\u{a}\"count\".k     = 11\u{a}\"count\" . l   = 12\u{a}", "\{\u{a}    \"count\": \{\u{a}        \"a\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \"b\": \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}        \"c\": \{\"type\": \"integer\", \"value\": \"3\"\},\u{a}        \"d\": \{\"type\": \"integer\", \"value\": \"4\"\},\u{a}        \"e\": \{\"type\": \"integer\", \"value\": \"5\"\},\u{a}        \"f\": \{\"type\": \"integer\", \"value\": \"6\"\},\u{a}        \"g\": \{\"type\": \"integer\", \"value\": \"7\"\},\u{a}        \"h\": \{\"type\": \"integer\", \"value\": \"8\"\},\u{a}        \"i\": \{\"type\": \"integer\", \"value\": \"9\"\},\u{a}        \"j\": \{\"type\": \"integer\", \"value\": \"10\"\},\u{a}        \"k\": \{\"type\": \"integer\", \"value\": \"11\"\},\u{a}        \"l\": \{\"type\": \"integer\", \"value\": \"12\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/dotted-03" {
    expect(reads("top.key = 1\u{a}\u{a}[tbl]\u{a}a.b.c = 42.666\u{a}\u{a}[a.few.dots]\u{a}polka.dot = \"again?\"\u{a}polka.dance-with = \"Dot\"\u{a}\u{a}", "\{\u{a}    \"a\": \{\u{a}        \"few\": \{\u{a}            \"dots\": \{\u{a}                \"polka\": \{\u{a}                    \"dance-with\": \{\"type\": \"string\", \"value\": \"Dot\"\},\u{a}                    \"dot\":        \{\"type\": \"string\", \"value\": \"again?\"\}\u{a}                \}\u{a}            \}\u{a}        \}\u{a}    \},\u{a}    \"tbl\": \{\u{a}        \"a\": \{\u{a}            \"b\": \{\u{a}                \"c\": \{\"type\": \"float\", \"value\": \"42.666\"\}\u{a}            \}\u{a}        \}\u{a}    \},\u{a}    \"top\": \{\u{a}        \"key\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/dotted-04" {
    expect(reads("top.key = 1\u{a}\u{a}[[arr]]\u{a}a.b.c=1\u{a}a.b.d=2\u{a}\u{a}[[arr]]\u{a}a.b.c=3\u{a}a.b.d=4\u{a}\u{a}", "\{\u{a}    \"arr\": [\u{a}        \{\u{a}            \"a\": \{\u{a}                \"b\": \{\u{a}                    \"c\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}                    \"d\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}                \}\u{a}            \}\u{a}        \},\u{a}        \{\u{a}            \"a\": \{\u{a}                \"b\": \{\u{a}                    \"c\": \{\"type\": \"integer\", \"value\": \"3\"\},\u{a}                    \"d\": \{\"type\": \"integer\", \"value\": \"4\"\}\u{a}                \}\u{a}            \}\u{a}        \}\u{a}    ],\u{a}    \"top\": \{\u{a}        \"key\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/dotted-empty" {
    expect(reads("''.x = \"empty.x\"\u{a}x.\"\" = \"x.empty\"\u{a}[a]\u{a}\"\".'' = \"empty.empty\"\u{a}", "\{\u{a}    \"\": \{\u{a}        \"x\": \{\"type\": \"string\", \"value\": \"empty.x\"\}\u{a}    \},\u{a}    \"a\": \{\u{a}        \"\": \{\u{a}            \"\": \{\"type\": \"string\", \"value\": \"empty.empty\"\}\u{a}        \}\u{a}    \},\u{a}    \"x\": \{\u{a}        \"\": \{\"type\": \"string\", \"value\": \"x.empty\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/empty-01" {
    expect(reads("\"\" = \"blank\"\u{a}", "\{\u{a}    \"\": \{\"type\": \"string\", \"value\": \"blank\"\}\u{a}\}\u{a}"))
}

test "valid/key/empty-02" {
    expect(reads("'' = \"blank\"\u{a}", "\{\u{a}    \"\": \{\"type\": \"string\", \"value\": \"blank\"\}\u{a}\}\u{a}"))
}

test "valid/key/empty-03" {
    expect(reads("''=0\u{a}", "\{\u{a}    \"\": \{\"type\": \"integer\", \"value\": \"0\"\}\u{a}\}\u{a}"))
}

test "valid/key/empty-04" {
    expect(reads("tbl-1     = \{\"\" = 1\}\u{a}tbl-2     = \{\"\" = \{\"\" = 1\}\}\u{a}arr-tbl-1 = [\{\"\" = 2\}]\u{a}arr-tbl-2 = [[\{\"\" = 2\}]]\u{a}", "\{\u{a}    \"arr-tbl-1\": [\{\u{a}        \"\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    \}],\u{a}    \"arr-tbl-2\": [[\{\u{a}        \"\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    \}]],\u{a}    \"tbl-1\": \{\u{a}        \"\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \},\u{a}    \"tbl-2\": \{\u{a}        \"\": \{\u{a}            \"\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/empty-05" {
    expect(reads("tbl-1     = \{\u{a}\u{9}\"\" = 1,\u{a}\}\u{a}tbl-2 = \{\u{a}\u{9}\"\" = \{\u{a}\u{9}\u{9}\"\" = 1,\u{a}\u{9}\},\u{a}\}\u{a}arr-tbl-1 = [\u{a}\u{9}\{\u{a}\u{9}\u{9}\"\" = 2,\u{a}\u{9}\},\u{a}]\u{a}arr-tbl-2 = [\u{a}\u{9}[\u{a}\u{9}\u{9}\{\u{a}\u{9}\u{9}\u{9}\"\" = 2,\u{a}\u{9}\u{9}\},\u{a}\u{9}],\u{a}]\u{a}", "\{\u{a}    \"arr-tbl-1\": [\{\u{a}        \"\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    \}],\u{a}    \"arr-tbl-2\": [[\{\u{a}        \"\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    \}]],\u{a}    \"tbl-1\": \{\u{a}        \"\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \},\u{a}    \"tbl-2\": \{\u{a}        \"\": \{\u{a}            \"\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/equals-nospace" {
    expect(reads("answer=42\u{a}", "\{\u{a}    \"answer\": \{\"type\": \"integer\", \"value\": \"42\"\}\u{a}\}\u{a}"))
}

test "valid/key/escapes" {
    expect(reads("\"\\n\" = \"newline\"\u{a}\"\\b\" = \"bell\"\u{a}\"\\u00c0\" = \"latin capital letter A with grave\"\u{a}\"\\\"\" = \"just a quote\"\u{a}\u{a}[\"backsp\\b\\b\"]\u{a}\u{a}[\"\\\"quoted\\\"\"]\u{a}quote = true\u{a}\u{a}[\"a.b\".\"\\u00c0\"]\u{a}", "\{\u{a}    \"\\b\":         \{\"type\": \"string\", \"value\": \"bell\"\},\u{a}    \"\\n\":         \{\"type\": \"string\", \"value\": \"newline\"\},\u{a}    \"\\\"\":         \{\"type\": \"string\", \"value\": \"just a quote\"\},\u{a}    \"backsp\\b\\b\": \{\},\u{a}    \"\u{c0}\":          \{\"type\": \"string\", \"value\": \"latin capital letter A with grave\"\},\u{a}    \"\\\"quoted\\\"\": \{\u{a}        \"quote\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}    \},\u{a}    \"a.b\": \{\u{a}        \"\u{c0}\": \{\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/like-date" {
    expect(reads("# '-' is a valid character in keys: make a key that looks like a date.\u{a}2001-02-03   = 1\u{a}\"2001-02-04\" = 2\u{a}'2001-02-05' = 3\u{a}\u{a}# Also include datetime and time for good measure; these need to be quoted as\u{a}# ':' isn't a valid bare key.\u{a}\"2001-02-06T15:16:17+01:00\" = 4\u{a}\"2001-02-07T15:16:17\"       = 5\u{a}\"15:16:17\"                  = 6\u{a}\u{a}# Dotted keys\u{a}a.2001-02-08 = 7\u{a}a.2001-02-09.2001-02-10 = 8\u{a}2001-02-11.a.2001-02-12 = 9\u{a}\u{a}# Table names\u{a}[2002-01-02]\u{a}k = 10\u{a}\u{a}[2002-01-02.2024-01-03]\u{a}k = 11\u{a}\u{a}[[2002-01-04]]\u{a}k = 12\u{a}", "\{\u{a}    \"15:16:17\":                  \{\"type\": \"integer\", \"value\": \"6\"\},\u{a}    \"2001-02-03\":                \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}    \"2001-02-04\":                \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}    \"2001-02-05\":                \{\"type\": \"integer\", \"value\": \"3\"\},\u{a}    \"2001-02-06T15:16:17+01:00\": \{\"type\": \"integer\", \"value\": \"4\"\},\u{a}    \"2001-02-07T15:16:17\":       \{\"type\": \"integer\", \"value\": \"5\"\},\u{a}    \"2002-01-04\":                [\{\u{a}        \"k\": \{\"type\": \"integer\", \"value\": \"12\"\}\u{a}    \}],\u{a}    \"2001-02-11\": \{\u{a}        \"a\": \{\u{a}            \"2001-02-12\": \{\"type\": \"integer\", \"value\": \"9\"\}\u{a}        \}\u{a}    \},\u{a}    \"2002-01-02\": \{\u{a}        \"k\": \{\"type\": \"integer\", \"value\": \"10\"\},\u{a}        \"2024-01-03\": \{\u{a}            \"k\": \{\"type\": \"integer\", \"value\": \"11\"\}\u{a}        \}\u{a}    \},\u{a}    \"a\": \{\u{a}        \"2001-02-08\": \{\"type\": \"integer\", \"value\": \"7\"\},\u{a}        \"2001-02-09\": \{\u{a}            \"2001-02-10\": \{\"type\": \"integer\", \"value\": \"8\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/numeric-01" {
    expect(reads("1     = true\u{a}", "\{\u{a}    \"1\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}\}\u{a}"))
}

test "valid/key/numeric-02" {
    expect(reads("1.2   = true\u{a}", "\{\u{a}    \"1\": \{\u{a}        \"2\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/numeric-03" {
    expect(reads("0123  = true\u{a}", "\{\u{a}    \"0123\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}\}\u{a}"))
}

test "valid/key/numeric-04" {
    expect(reads("01.23 = true\u{a}", "\{\u{a}    \"01\": \{\u{a}        \"23\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/numeric-05" {
    expect(reads("23.01 = true\u{a}", "\{\u{a}    \"23\": \{\u{a}        \"01\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/numeric-06" {
    expect(reads("-1    = true\u{a}", "\{\u{a}    \"-1\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}\}\u{a}"))
}

test "valid/key/numeric-07" {
    expect(reads("-01   = true\u{a}", "\{\u{a}    \"-01\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}\}\u{a}"))
}

test "valid/key/numeric-08" {
    expect(reads("1  = 'one'\u{a}01 = 'zero one'\u{a}", "\{\u{a}    \"01\": \{\"type\": \"string\", \"value\": \"zero one\"\},\u{a}    \"1\":  \{\"type\": \"string\", \"value\": \"one\"\}\u{a}\}\u{a}"))
}

test "valid/key/quoted-dots" {
    expect(reads("plain = 1\u{a}\"with.dot\" = 2\u{a}\u{a}[plain_table]\u{a}plain = 3\u{a}\"with.dot\" = 4\u{a}\u{a}[table.withdot]\u{a}plain = 5\u{a}\"key.with.dots\" = 6\u{a}\"escaped\\u002edot\" = 7\u{a}", "\{\u{a}    \"plain\":    \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}    \"with.dot\": \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}    \"plain_table\": \{\u{a}        \"plain\":    \{\"type\": \"integer\", \"value\": \"3\"\},\u{a}        \"with.dot\": \{\"type\": \"integer\", \"value\": \"4\"\}\u{a}    \},\u{a}    \"table\": \{\u{a}        \"withdot\": \{\u{a}            \"escaped.dot\":   \{\"type\": \"integer\", \"value\": \"7\"\},\u{a}            \"key.with.dots\": \{\"type\": \"integer\", \"value\": \"6\"\},\u{a}            \"plain\":         \{\"type\": \"integer\", \"value\": \"5\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/quoted-unicode" {
    expect(reads("\u{a}\"\\u0000\" = \"null\"\u{a}'\\u0000' = \"different key\"\u{a}\"\\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff\" = \"escaped key\"\u{a}\u{a}\"~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\" = \"basic key\"\u{a}'l ~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}' = \"literal key\"\u{a}", "\{\u{a}    \"\\u0000\":               \{\"type\": \"string\", \"value\": \"null\"\},\u{a}    \"\\b \\f A \u{7f} \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\": \{\"type\": \"string\", \"value\": \"escaped key\"\},\u{a}    \"\\\\u0000\":              \{\"type\": \"string\", \"value\": \"different key\"\},\u{a}    \"l ~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\":      \{\"type\": \"string\", \"value\": \"literal key\"\},\u{a}    \"~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\":        \{\"type\": \"string\", \"value\": \"basic key\"\}\u{a}\}\u{a}"))
}

test "valid/key/space" {
    expect(reads("# Keep whitespace inside quotes keys at all positions.\u{a}\"a b\"   = 1\u{a}\" c d \" = 2\u{a}\"  much \u{9}\u{9}  whitespace  \u{9}\\n  \\r\\n  \" = 3\u{a}\u{a}[ \" tbl \" ]\u{a}\"\\ttab\\ttab\\t\" = \"tab\"\u{a}", "\{\u{a}    \"  much \\t\\t  whitespace  \\t\\n  \\r\\n  \": \{\"type\": \"integer\", \"value\": \"3\"\},\u{a}    \" c d \":                             \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}    \"a b\":                               \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}    \" tbl \": \{\u{a}        \"\\ttab\\ttab\\t\": \{\"type\": \"string\", \"value\": \"tab\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/special-chars" {
    expect(reads("\"=~!@$^&*()_+-`1234567890[]|/?><.,;:'=\" = 1\u{a}", "\{\u{a}    \"=~!@$^\\u0026*()_+-`1234567890[]|/?\\u003e\\u003c.,;:'=\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}\}\u{a}"))
}

test "valid/key/special-word" {
    expect(reads("false = false\u{a}true = 1\u{a}inf = 100000000\u{a}nan = \"ceci n'est pas un nombre\"\u{a}\u{a}", "\{\u{a}    \"false\": \{\"type\": \"bool\", \"value\": \"false\"\},\u{a}    \"inf\":   \{\"type\": \"integer\", \"value\": \"100000000\"\},\u{a}    \"nan\":   \{\"type\": \"string\", \"value\": \"ceci n'est pas un nombre\"\},\u{a}    \"true\":  \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}\}\u{a}"))
}

test "valid/key/start" {
    expect(reads("# Table and keys can start with any character; there is no requirement for it to\u{a}# start with a letter.\u{a}\u{a}[-key]\u{a}-key = 1\u{a}\u{a}[_key]\u{a}_key = 2\u{a}\u{a}[1key]\u{a}1key = 3\u{a}\u{a}[-]\u{a}- = 4\u{a}\u{a}[_]\u{a}_ = 5\u{a}\u{a}[1] \u{a}1 = 6\u{a}\u{a}[---] \u{a}--- = 7\u{a}\u{a}[___]\u{a}___ = 8\u{a}\u{a}[111]\u{a}111 = 9\u{a}\u{a}[inline]\u{a}--- = \{--- = 10, ___ = 11, 111 = 12\}\u{a}", "\{\u{a}    \"-\": \{\u{a}        \"-\": \{\"type\": \"integer\", \"value\": \"4\"\}\u{a}    \},\u{a}    \"---\": \{\u{a}        \"---\": \{\"type\": \"integer\", \"value\": \"7\"\}\u{a}    \},\u{a}    \"-key\": \{\u{a}        \"-key\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \},\u{a}    \"1\": \{\u{a}        \"1\": \{\"type\": \"integer\", \"value\": \"6\"\}\u{a}    \},\u{a}    \"111\": \{\u{a}        \"111\": \{\"type\": \"integer\", \"value\": \"9\"\}\u{a}    \},\u{a}    \"1key\": \{\u{a}        \"1key\": \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}    \},\u{a}    \"_\": \{\u{a}        \"_\": \{\"type\": \"integer\", \"value\": \"5\"\}\u{a}    \},\u{a}    \"___\": \{\u{a}        \"___\": \{\"type\": \"integer\", \"value\": \"8\"\}\u{a}    \},\u{a}    \"_key\": \{\u{a}        \"_key\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    \},\u{a}    \"inline\": \{\u{a}        \"---\": \{\u{a}            \"---\": \{\"type\": \"integer\", \"value\": \"10\"\},\u{a}            \"111\": \{\"type\": \"integer\", \"value\": \"12\"\},\u{a}            \"___\": \{\"type\": \"integer\", \"value\": \"11\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/key/zero" {
    expect(reads("0=0\u{a}", "\{\u{a}    \"0\": \{\"type\": \"integer\", \"value\": \"0\"\}\u{a}\}\u{a}"))
}

test "valid/multibyte" {
    expect(reads("# Test multibyte throughout\u{a}\u{a}# T\u{e8}\u{1a8}\u{1ad} \u{192}\u{ef}\u{2113}\u{e8} \u{192}\u{f4}\u{159} T\u{d3}M\u{a3}\u{a}# \u{d3}\u{f1}\u{2113}\u{a5} \u{1ad}\u{3bb}\u{ef}\u{1a8} \u{f4}\u{f1}\u{e8} \u{1ad}\u{159}\u{ef}\u{e8}\u{1a8} \u{1ad}\u{f4} \u{e8}\u{20a5}\u{fa}\u{2113}\u{e1}\u{1ad}\u{e8} \u{e1} T\u{d3}M\u{a3} \u{192}\u{ef}\u{2113}\u{e8} \u{3c9}\u{159}\u{ef}\u{1ad}\u{1ad}\u{e8}\u{f1} \u{3b2}\u{a5} \u{e1} \u{fa}\u{1a8}\u{e8}\u{159} \u{f4}\u{192} \u{1ad}\u{3bb}\u{e8} \u{199}\u{ef}\u{f1}\u{3b4} \u{f4}\u{192} \u{1a5}\u{e1}\u{159}\u{1a8}\u{e8}\u{159} \u{3c9}\u{159}\u{ef}\u{1ad}\u{e8}\u{159}\u{1a8} \u{1a5}\u{159}\u{f4}\u{3b2}\u{e1}\u{3b2}\u{2113}\u{a5} \u{3bb}\u{e1}\u{1ad}\u{e8}\u{a}\u{a}['\u{1d42d}\u{1d41b}\u{1d425}']\u{a}string = \"\u{1d4fc}\u{1d4fd}\u{1d4fb}\u{1d4f2}\u{1d4f7}\u{1d4f0} - #\"          # \" \u{1d4fc}\u{1d4fd}\u{1d4fb}\u{1d4f2}\u{1d4f7}\u{1d4f0}\u{a}\u{9}['\u{1d42d}\u{1d41b}\u{1d425}'.sub]\u{a}\u{9}'\u{1d552}\u{1d563}\u{1d563}\u{1d552}\u{1d56a}' = [ \"] \", \" # \"]      # ] \u{1d4ea}\u{1d4fb}\u{1d4fb}\u{1d4ea}\u{1d502}\u{a}\u{9}'\u{1d552}\u{1d563}\u{1d563}\u{1d552}\u{1d56a}\u{1d7da}' = [ \"T\u{e8}\u{1a8}\u{1ad} #11 ]\u{1a5}\u{159}\u{f4}\u{1b2}\u{e8}\u{3b4} \u{1ad}\u{3bb}\u{e1}\u{1ad}\", \"\u{c9}\u{436}\u{1a5}\u{e8}\u{159}\u{ef}\u{20a5}\u{e8}\u{f1}\u{1ad} #9 \u{3c9}\u{e1}\u{1a8} \u{e1} \u{1a8}\u{fa}\u{e7}\u{e7}\u{e8}\u{1a8}\u{1a8}\" ]\u{a}\u{9}# \u{dd}\u{f4}\u{fa} \u{3b4}\u{ef}\u{3b4}\u{f1}'\u{1ad} \u{1ad}\u{3bb}\u{ef}\u{f1}\u{199} \u{ef}\u{1ad}'\u{3b4} \u{e1}\u{1a8} \u{e8}\u{e1}\u{1a8}\u{a5} \u{e1}\u{1a8} \u{e7}\u{3bb}\u{fa}\u{e7}\u{199}\u{ef}\u{f1}\u{3f1} \u{f4}\u{fa}\u{1ad} \u{1ad}\u{3bb}\u{e8} \u{2113}\u{e1}\u{1a8}\u{1ad} #, \u{3b4}\u{ef}\u{3b4} \u{a5}\u{f4}\u{fa}?\u{a}\u{9}another_test_string = \"\u{a7}\u{e1}\u{20a5}\u{e8} \u{1ad}\u{3bb}\u{ef}\u{f1}\u{3f1}, \u{3b2}\u{fa}\u{1ad} \u{3c9}\u{ef}\u{1ad}\u{3bb} \u{e1} \u{1a8}\u{1ad}\u{159}\u{ef}\u{f1}\u{3f1} #\"\u{a}\u{9}escapes = \" \u{c2}\u{f1}\u{3b4} \u{3c9}\u{3bb}\u{e8}\u{f1} \\\"'\u{1a8} \u{e1}\u{159}\u{e8} \u{ef}\u{f1} \u{1ad}\u{3bb}\u{e8} \u{1a8}\u{1ad}\u{159}\u{ef}\u{f1}\u{3f1}, \u{e1}\u{2113}\u{f4}\u{f1}\u{3f1} \u{3c9}\u{ef}\u{1ad}\u{3bb} # \\\"\"   # \"\u{e1}\u{f1}\u{3b4} \u{e7}\u{f4}\u{20a5}\u{20a5}\u{e8}\u{f1}\u{1ad}\u{1a8} \u{e1}\u{159}\u{e8} \u{1ad}\u{3bb}\u{e8}\u{159}\u{e8} \u{1ad}\u{f4}\u{f4}\"\u{a}\u{9}# T\u{3bb}\u{ef}\u{f1}\u{3f1}\u{1a8} \u{3c9}\u{ef}\u{2113}\u{2113} \u{3f1}\u{e8}\u{1ad} \u{3bb}\u{e1}\u{159}\u{3b4}\u{e8}\u{159}\u{a}\u{9}\u{9}['\u{1d42d}\u{1d41b}\u{1d425}'.sub.\"\u{3b2}\u{ef}\u{1ad}#\"]\u{a}\u{9}\u{9}\"\u{3c9}\u{3bb}\u{e1}\u{1ad}?\" = \"\u{dd}\u{f4}\u{fa} \u{3b4}\u{f4}\u{f1}'\u{1ad} \u{1ad}\u{3bb}\u{ef}\u{f1}\u{199} \u{1a8}\u{f4}\u{20a5}\u{e8} \u{fa}\u{1a8}\u{e8}\u{159} \u{3c9}\u{f4}\u{f1}'\u{1ad} \u{3b4}\u{f4} \u{1ad}\u{3bb}\u{e1}\u{1ad}?\"\u{a}\u{9}\u{9}multi_line_array = [\u{a}\u{9}\u{9}\u{9}\"]\",\u{a}\u{9}\u{9}\u{9}# ] \u{d3}\u{3bb} \u{a5}\u{e8}\u{1a8} \u{cc} \u{3b4}\u{ef}\u{3b4}\u{a}\u{9}\u{9}\u{9}]\u{a}", "\{\u{a}    \"\u{1d42d}\u{1d41b}\u{1d425}\": \{\u{a}        \"string\": \{\"type\": \"string\", \"value\": \"\u{1d4fc}\u{1d4fd}\u{1d4fb}\u{1d4f2}\u{1d4f7}\u{1d4f0} - #\"\},\u{a}        \"sub\": \{\u{a}            \"another_test_string\": \{\"type\": \"string\", \"value\": \"\u{a7}\u{e1}\u{20a5}\u{e8} \u{1ad}\u{3bb}\u{ef}\u{f1}\u{3f1}, \u{3b2}\u{fa}\u{1ad} \u{3c9}\u{ef}\u{1ad}\u{3bb} \u{e1} \u{1a8}\u{1ad}\u{159}\u{ef}\u{f1}\u{3f1} #\"\},\u{a}            \"escapes\":             \{\"type\": \"string\", \"value\": \" \u{c2}\u{f1}\u{3b4} \u{3c9}\u{3bb}\u{e8}\u{f1} \\\"'\u{1a8} \u{e1}\u{159}\u{e8} \u{ef}\u{f1} \u{1ad}\u{3bb}\u{e8} \u{1a8}\u{1ad}\u{159}\u{ef}\u{f1}\u{3f1}, \u{e1}\u{2113}\u{f4}\u{f1}\u{3f1} \u{3c9}\u{ef}\u{1ad}\u{3bb} # \\\"\"\},\u{a}            \"\u{3b2}\u{ef}\u{1ad}#\": \{\u{a}                \"multi_line_array\": [\{\"type\": \"string\", \"value\": \"]\"\}],\u{a}                \"\u{3c9}\u{3bb}\u{e1}\u{1ad}?\":            \{\"type\": \"string\", \"value\": \"\u{dd}\u{f4}\u{fa} \u{3b4}\u{f4}\u{f1}'\u{1ad} \u{1ad}\u{3bb}\u{ef}\u{f1}\u{199} \u{1a8}\u{f4}\u{20a5}\u{e8} \u{fa}\u{1a8}\u{e8}\u{159} \u{3c9}\u{f4}\u{f1}'\u{1ad} \u{3b4}\u{f4} \u{1ad}\u{3bb}\u{e1}\u{1ad}?\"\}\u{a}            \},\u{a}            \"\u{1d552}\u{1d563}\u{1d563}\u{1d552}\u{1d56a}\": [\u{a}                \{\"type\": \"string\", \"value\": \"] \"\},\u{a}                \{\"type\": \"string\", \"value\": \" # \"\}\u{a}            ],\u{a}            \"\u{1d552}\u{1d563}\u{1d563}\u{1d552}\u{1d56a}\u{1d7da}\": [\u{a}                \{\"type\": \"string\", \"value\": \"T\u{e8}\u{1a8}\u{1ad} #11 ]\u{1a5}\u{159}\u{f4}\u{1b2}\u{e8}\u{3b4} \u{1ad}\u{3bb}\u{e1}\u{1ad}\"\},\u{a}                \{\"type\": \"string\", \"value\": \"\u{c9}\u{436}\u{1a5}\u{e8}\u{159}\u{ef}\u{20a5}\u{e8}\u{f1}\u{1ad} #9 \u{3c9}\u{e1}\u{1a8} \u{e1} \u{1a8}\u{fa}\u{e7}\u{e7}\u{e8}\u{1a8}\u{1a8}\"\}\u{a}            ]\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/newline-crlf" {
    expect(reads("os = \"DOS\"\u{d}\u{a}newline = \"crlf\"\u{d}\u{a}", "\{\u{a}    \"newline\": \{\"type\": \"string\", \"value\": \"crlf\"\},\u{a}    \"os\":      \{\"type\": \"string\", \"value\": \"DOS\"\}\u{a}\}\u{a}"))
}

test "valid/newline-lf" {
    expect(reads("os = \"unix\"\u{a}newline = \"lf\"\u{a}", "\{\u{a}    \"newline\": \{\"type\": \"string\", \"value\": \"lf\"\},\u{a}    \"os\":      \{\"type\": \"string\", \"value\": \"unix\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-0" {
    expect(reads("# This is a full-line comment\u{a}key = \"value\"  # This is a comment at the end of a line\u{a}another = \"# This is not a comment\"\u{a}", "\{\u{a}    \"another\": \{\"type\": \"string\", \"value\": \"# This is not a comment\"\},\u{a}    \"key\":     \{\"type\": \"string\", \"value\": \"value\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-1" {
    expect(reads("key = \"value\"\u{a}", "\{\u{a}    \"key\": \{\"type\": \"string\", \"value\": \"value\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-10" {
    expect(reads("# RECOMMENDED\u{a}\u{a}apple.type = \"fruit\"\u{a}apple.skin = \"thin\"\u{a}apple.color = \"red\"\u{a}\u{a}orange.type = \"fruit\"\u{a}orange.skin = \"thick\"\u{a}orange.color = \"orange\"\u{a}", "\{\u{a}    \"apple\": \{\u{a}        \"color\": \{\"type\": \"string\", \"value\": \"red\"\},\u{a}        \"skin\":  \{\"type\": \"string\", \"value\": \"thin\"\},\u{a}        \"type\":  \{\"type\": \"string\", \"value\": \"fruit\"\}\u{a}    \},\u{a}    \"orange\": \{\u{a}        \"color\": \{\"type\": \"string\", \"value\": \"orange\"\},\u{a}        \"skin\":  \{\"type\": \"string\", \"value\": \"thick\"\},\u{a}        \"type\":  \{\"type\": \"string\", \"value\": \"fruit\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-11" {
    expect(reads("3.14159 = \"pi\"\u{a}", "\{\u{a}    \"3\": \{\u{a}        \"14159\": \{\"type\": \"string\", \"value\": \"pi\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-12" {
    expect(reads("str = \"I'm a string. \\\"You can quote me\\\". Name\\tJos\\xE9\\nLocation\\tSF.\"\u{a}", "\{\u{a}    \"str\": \{\"type\": \"string\", \"value\": \"I'm a string. \\\"You can quote me\\\". Name\\tJos\u{e9}\\nLocation\\tSF.\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-13" {
    expect(reads("str1 = \"\"\"\u{a}Roses are red\u{a}Violets are blue\"\"\"\u{a}", "\{\u{a}    \"str1\": \{\"type\": \"string\", \"value\": \"Roses are red\\nViolets are blue\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-14" {
    expect(reads("# On a Unix system, the above multi-line string will most likely be the same as:\u{a}str2 = \"Roses are red\\nViolets are blue\"\u{a}\u{a}# On a Windows system, it will most likely be equivalent to:\u{a}str3 = \"Roses are red\\r\\nViolets are blue\"\u{a}", "\{\u{a}    \"str2\": \{\"type\": \"string\", \"value\": \"Roses are red\\nViolets are blue\"\},\u{a}    \"str3\": \{\"type\": \"string\", \"value\": \"Roses are red\\r\\nViolets are blue\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-15" {
    expect(reads("# The following strings are byte-for-byte equivalent:\u{a}str1 = \"The quick brown fox jumps over the lazy dog.\"\u{a}\u{a}str2 = \"\"\"\u{a}The quick brown \\\u{a}\u{a}\u{a}  fox jumps over \\\u{a}    the lazy dog.\"\"\"\u{a}\u{a}str3 = \"\"\"\\\u{a}       The quick brown \\\u{a}       fox jumps over \\\u{a}       the lazy dog.\\\u{a}       \"\"\"\u{a}", "\{\u{a}    \"str1\": \{\"type\": \"string\", \"value\": \"The quick brown fox jumps over the lazy dog.\"\},\u{a}    \"str2\": \{\"type\": \"string\", \"value\": \"The quick brown fox jumps over the lazy dog.\"\},\u{a}    \"str3\": \{\"type\": \"string\", \"value\": \"The quick brown fox jumps over the lazy dog.\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-16" {
    expect(reads("str4 = \"\"\"Here are two quotation marks: \"\". Simple enough.\"\"\"\u{a}# str5 = \"\"\"Here are three quotation marks: \"\"\".\"\"\"  # INVALID\u{a}str5 = \"\"\"Here are three quotation marks: \"\"\\\".\"\"\"\u{a}str6 = \"\"\"Here are fifteen quotation marks: \"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\".\"\"\"\u{a}\u{a}# \"This,\" she said, \"is just a pointless statement.\"\u{a}str7 = \"\"\"\"This,\" she said, \"is just a pointless statement.\"\"\"\"\u{a}", "\{\u{a}    \"str4\": \{\"type\": \"string\", \"value\": \"Here are two quotation marks: \\\"\\\". Simple enough.\"\},\u{a}    \"str5\": \{\"type\": \"string\", \"value\": \"Here are three quotation marks: \\\"\\\"\\\".\"\},\u{a}    \"str6\": \{\"type\": \"string\", \"value\": \"Here are fifteen quotation marks: \\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\".\"\},\u{a}    \"str7\": \{\"type\": \"string\", \"value\": \"\\\"This,\\\" she said, \\\"is just a pointless statement.\\\"\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-17" {
    expect(reads("# What you see is what you get.\u{a}winpath  = 'C:\\Users\\nodejs\\templates'\u{a}winpath2 = '\\\\ServerX\\admin$\\system32\\'\u{a}quoted   = 'Tom \"Dubs\" Preston-Werner'\u{a}regex    = '<\\i\\c*\\s*>'\u{a}", "\{\u{a}    \"quoted\":   \{\"type\": \"string\", \"value\": \"Tom \\\"Dubs\\\" Preston-Werner\"\},\u{a}    \"regex\":    \{\"type\": \"string\", \"value\": \"<\\\\i\\\\c*\\\\s*>\"\},\u{a}    \"winpath\":  \{\"type\": \"string\", \"value\": \"C:\\\\Users\\\\nodejs\\\\templates\"\},\u{a}    \"winpath2\": \{\"type\": \"string\", \"value\": \"\\\\\\\\ServerX\\\\admin$\\\\system32\\\\\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-18" {
    expect(reads("regex2 = '''I [dw]on't need \\d\{2\} apples'''\u{a}lines  = '''\u{a}The first newline is\u{a}trimmed in literal strings.\u{a}   All other whitespace\u{a}   is preserved.\u{a}'''\u{a}", "\{\u{a}    \"lines\":  \{\"type\": \"string\", \"value\": \"The first newline is\\ntrimmed in literal strings.\\n   All other whitespace\\n   is preserved.\\n\"\},\u{a}    \"regex2\": \{\"type\": \"string\", \"value\": \"I [dw]on't need \\\\d\{2\} apples\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-19" {
    expect(reads("quot15 = '''Here are fifteen quotation marks: \"\"\"\"\"\"\"\"\"\"\"\"\"\"\"'''\u{a}\u{a}# apos15 = '''Here are fifteen apostrophes: ''''''''''''''''''  # INVALID\u{a}apos15 = \"Here are fifteen apostrophes: '''''''''''''''\"\u{a}\u{a}# 'That,' she said, 'is still pointless.'\u{a}str = ''''That,' she said, 'is still pointless.''''\u{a}", "\{\u{a}    \"apos15\": \{\"type\": \"string\", \"value\": \"Here are fifteen apostrophes: '''''''''''''''\"\},\u{a}    \"quot15\": \{\"type\": \"string\", \"value\": \"Here are fifteen quotation marks: \\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\"\},\u{a}    \"str\":    \{\"type\": \"string\", \"value\": \"'That,' she said, 'is still pointless.'\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-20" {
    expect(reads("int1 = +99\u{a}int2 = 42\u{a}int3 = 0\u{a}int4 = -17\u{a}", "\{\u{a}    \"int1\": \{\"type\": \"integer\", \"value\": \"99\"\},\u{a}    \"int2\": \{\"type\": \"integer\", \"value\": \"42\"\},\u{a}    \"int3\": \{\"type\": \"integer\", \"value\": \"0\"\},\u{a}    \"int4\": \{\"type\": \"integer\", \"value\": \"-17\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-21" {
    expect(reads("int5 = 1_000\u{a}int6 = 5_349_221\u{a}int7 = 53_49_221  # Indian number system grouping\u{a}int8 = 1_2_3_4_5  # VALID but discouraged\u{a}", "\{\u{a}    \"int5\": \{\"type\": \"integer\", \"value\": \"1000\"\},\u{a}    \"int6\": \{\"type\": \"integer\", \"value\": \"5349221\"\},\u{a}    \"int7\": \{\"type\": \"integer\", \"value\": \"5349221\"\},\u{a}    \"int8\": \{\"type\": \"integer\", \"value\": \"12345\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-22" {
    expect(reads("# hexadecimal with prefix `0x`\u{a}hex1 = 0xDEADBEEF\u{a}hex2 = 0xdeadbeef\u{a}hex3 = 0xdead_beef\u{a}\u{a}# octal with prefix `0o`\u{a}oct1 = 0o01234567\u{a}oct2 = 0o755 # useful for Unix file permissions\u{a}\u{a}# binary with prefix `0b`\u{a}bin1 = 0b11010110\u{a}", "\{\u{a}    \"bin1\": \{\"type\": \"integer\", \"value\": \"214\"\},\u{a}    \"hex1\": \{\"type\": \"integer\", \"value\": \"3735928559\"\},\u{a}    \"hex2\": \{\"type\": \"integer\", \"value\": \"3735928559\"\},\u{a}    \"hex3\": \{\"type\": \"integer\", \"value\": \"3735928559\"\},\u{a}    \"oct1\": \{\"type\": \"integer\", \"value\": \"342391\"\},\u{a}    \"oct2\": \{\"type\": \"integer\", \"value\": \"493\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-23" {
    expect(reads("# fractional\u{a}flt1 = +1.0\u{a}flt2 = 3.1415\u{a}flt3 = -0.01\u{a}\u{a}# exponent\u{a}flt4 = 5e+22\u{a}flt5 = 1e06\u{a}flt6 = -2E-2\u{a}\u{a}# both\u{a}flt7 = 6.626e-34\u{a}", "\{\u{a}    \"flt1\": \{\"type\": \"float\", \"value\": \"1\"\},\u{a}    \"flt2\": \{\"type\": \"float\", \"value\": \"3.1415\"\},\u{a}    \"flt3\": \{\"type\": \"float\", \"value\": \"-0.01\"\},\u{a}    \"flt4\": \{\"type\": \"float\", \"value\": \"5e+22\"\},\u{a}    \"flt5\": \{\"type\": \"float\", \"value\": \"1e+06\"\},\u{a}    \"flt6\": \{\"type\": \"float\", \"value\": \"-0.02\"\},\u{a}    \"flt7\": \{\"type\": \"float\", \"value\": \"6.626e-34\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-24" {
    expect(reads("flt8 = 224_617.445_991_228\u{a}", "\{\u{a}    \"flt8\": \{\"type\": \"float\", \"value\": \"224617.445991228\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-25" {
    expect(reads("# infinity\u{a}sf1 = inf  # positive infinity\u{a}sf2 = +inf # positive infinity\u{a}sf3 = -inf # negative infinity\u{a}\u{a}# not a number\u{a}sf4 = nan  # actual sNaN/qNaN encoding is implementation-specific\u{a}sf5 = +nan # same as `nan`\u{a}sf6 = -nan # valid, actual encoding is implementation-specific\u{a}", "\{\u{a}    \"sf1\": \{\"type\": \"float\", \"value\": \"inf\"\},\u{a}    \"sf2\": \{\"type\": \"float\", \"value\": \"inf\"\},\u{a}    \"sf3\": \{\"type\": \"float\", \"value\": \"-inf\"\},\u{a}    \"sf4\": \{\"type\": \"float\", \"value\": \"nan\"\},\u{a}    \"sf5\": \{\"type\": \"float\", \"value\": \"nan\"\},\u{a}    \"sf6\": \{\"type\": \"float\", \"value\": \"nan\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-26" {
    expect(reads("bool1 = true\u{a}bool2 = false\u{a}", "\{\u{a}    \"bool1\": \{\"type\": \"bool\", \"value\": \"true\"\},\u{a}    \"bool2\": \{\"type\": \"bool\", \"value\": \"false\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-27" {
    expect(reads("odt1 = 1979-05-27T07:32:00Z\u{a}odt2 = 1979-05-27T00:32:00-07:00\u{a}odt3 = 1979-05-27T00:32:00.5-07:00\u{a}odt4 = 1979-05-27T00:32:00.999-07:00\u{a}", "\{\u{a}    \"odt1\": \{\"type\": \"datetime\", \"value\": \"1979-05-27T07:32:00Z\"\},\u{a}    \"odt2\": \{\"type\": \"datetime\", \"value\": \"1979-05-27T00:32:00-07:00\"\},\u{a}    \"odt3\": \{\"type\": \"datetime\", \"value\": \"1979-05-27T00:32:00.5-07:00\"\},\u{a}    \"odt4\": \{\"type\": \"datetime\", \"value\": \"1979-05-27T00:32:00.999-07:00\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-28" {
    expect(reads("odt4 = 1979-05-27 07:32:00Z\u{a}", "\{\u{a}    \"odt4\": \{\"type\": \"datetime\", \"value\": \"1979-05-27T07:32:00Z\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-29" {
    expect(reads("odt5 = 1979-05-27 07:32Z\u{a}odt6 = 1979-05-27 07:32-07:00\u{a}", "\{\u{a}    \"odt5\": \{\"type\": \"datetime\", \"value\": \"1979-05-27T07:32:00Z\"\},\u{a}    \"odt6\": \{\"type\": \"datetime\", \"value\": \"1979-05-27T07:32:00-07:00\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-3" {
    expect(reads("key = \"value\"\u{a}bare_key = \"value\"\u{a}bare-key = \"value\"\u{a}1234 = \"value\"\u{a}", "\{\u{a}    \"1234\":     \{\"type\": \"string\", \"value\": \"value\"\},\u{a}    \"bare-key\": \{\"type\": \"string\", \"value\": \"value\"\},\u{a}    \"bare_key\": \{\"type\": \"string\", \"value\": \"value\"\},\u{a}    \"key\":      \{\"type\": \"string\", \"value\": \"value\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-30" {
    expect(reads("ldt1 = 1979-05-27T07:32:00\u{a}ldt2 = 1979-05-27T07:32:00.5\u{a}ldt3 = 1979-05-27T00:32:00.999\u{a}", "\{\u{a}    \"ldt1\": \{\"type\": \"datetime-local\", \"value\": \"1979-05-27T07:32:00\"\},\u{a}    \"ldt2\": \{\"type\": \"datetime-local\", \"value\": \"1979-05-27T07:32:00.5\"\},\u{a}    \"ldt3\": \{\"type\": \"datetime-local\", \"value\": \"1979-05-27T00:32:00.999\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-31" {
    expect(reads("ldt3 = 1979-05-27T07:32\u{a}", "\{\u{a}    \"ldt3\": \{\"type\": \"datetime-local\", \"value\": \"1979-05-27T07:32:00\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-32" {
    expect(reads("ld1 = 1979-05-27\u{a}", "\{\u{a}    \"ld1\": \{\"type\": \"date-local\", \"value\": \"1979-05-27\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-33" {
    expect(reads("lt1 = 07:32:00\u{a}lt2 = 00:32:00.5\u{a}lt3 = 00:32:00.999\u{a}", "\{\u{a}    \"lt1\": \{\"type\": \"time-local\", \"value\": \"07:32:00\"\},\u{a}    \"lt2\": \{\"type\": \"time-local\", \"value\": \"00:32:00.5\"\},\u{a}    \"lt3\": \{\"type\": \"time-local\", \"value\": \"00:32:00.999\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-34" {
    expect(reads("lt3 = 07:32\u{a}", "\{\u{a}    \"lt3\": \{\"type\": \"time-local\", \"value\": \"07:32:00\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-35" {
    expect(reads("integers = [ 1, 2, 3 ]\u{a}colors = [ \"red\", \"yellow\", \"green\" ]\u{a}nested_arrays_of_ints = [ [ 1, 2 ], [3, 4, 5] ]\u{a}nested_mixed_array = [ [ 1, 2 ], [\"a\", \"b\", \"c\"] ]\u{a}string_array = [ \"all\", 'strings', \"\"\"are the same\"\"\", '''type''' ]\u{a}\u{a}# Mixed-type arrays are allowed\u{a}numbers = [ 0.1, 0.2, 0.5, 1, 2, 5 ]\u{a}contributors = [\u{a}  \"Foo Bar <foo@example.com>\",\u{a}  \{ name = \"Baz Qux\", email = \"bazqux@example.com\", url = \"https://example.com/bazqux\" \}\u{a}]\u{a}", "\{\u{a}    \"colors\": [\u{a}        \{\"type\": \"string\", \"value\": \"red\"\},\u{a}        \{\"type\": \"string\", \"value\": \"yellow\"\},\u{a}        \{\"type\": \"string\", \"value\": \"green\"\}\u{a}    ],\u{a}    \"contributors\": [\u{a}        \{\"type\": \"string\", \"value\": \"Foo Bar <foo@example.com>\"\},\u{a}        \{\u{a}            \"email\": \{\"type\": \"string\", \"value\": \"bazqux@example.com\"\},\u{a}            \"name\":  \{\"type\": \"string\", \"value\": \"Baz Qux\"\},\u{a}            \"url\":   \{\"type\": \"string\", \"value\": \"https://example.com/bazqux\"\}\u{a}        \}\u{a}    ],\u{a}    \"integers\": [\u{a}        \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}    ],\u{a}    \"nested_arrays_of_ints\": [\u{a}        [\u{a}            \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}        ],\u{a}        [\u{a}            \{\"type\": \"integer\", \"value\": \"3\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"4\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"5\"\}\u{a}        ]\u{a}    ],\u{a}    \"nested_mixed_array\": [\u{a}        [\u{a}            \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}        ],\u{a}        [\u{a}            \{\"type\": \"string\", \"value\": \"a\"\},\u{a}            \{\"type\": \"string\", \"value\": \"b\"\},\u{a}            \{\"type\": \"string\", \"value\": \"c\"\}\u{a}        ]\u{a}    ],\u{a}    \"numbers\": [\u{a}        \{\"type\": \"float\", \"value\": \"0.1\"\},\u{a}        \{\"type\": \"float\", \"value\": \"0.2\"\},\u{a}        \{\"type\": \"float\", \"value\": \"0.5\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"5\"\}\u{a}    ],\u{a}    \"string_array\": [\u{a}        \{\"type\": \"string\", \"value\": \"all\"\},\u{a}        \{\"type\": \"string\", \"value\": \"strings\"\},\u{a}        \{\"type\": \"string\", \"value\": \"are the same\"\},\u{a}        \{\"type\": \"string\", \"value\": \"type\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-36" {
    expect(reads("integers2 = [\u{a}  1, 2, 3\u{a}]\u{a}\u{a}integers3 = [\u{a}  1,\u{a}  2, # this is ok\u{a}]\u{a}", "\{\u{a}    \"integers2\": [\u{a}        \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}    ],\u{a}    \"integers3\": [\u{a}        \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-37" {
    expect(reads("[table]\u{a}", "\{\u{a}    \"table\": \{\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-38" {
    expect(reads("[table-1]\u{a}key1 = \"some string\"\u{a}key2 = 123\u{a}\u{a}[table-2]\u{a}key1 = \"another string\"\u{a}key2 = 456\u{a}", "\{\u{a}    \"table-1\": \{\u{a}        \"key1\": \{\"type\": \"string\", \"value\": \"some string\"\},\u{a}        \"key2\": \{\"type\": \"integer\", \"value\": \"123\"\}\u{a}    \},\u{a}    \"table-2\": \{\u{a}        \"key1\": \{\"type\": \"string\", \"value\": \"another string\"\},\u{a}        \"key2\": \{\"type\": \"integer\", \"value\": \"456\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-39" {
    expect(reads("[dog.\"tater.man\"]\u{a}type.name = \"pug\"\u{a}", "\{\u{a}    \"dog\": \{\u{a}        \"tater.man\": \{\u{a}            \"type\": \{\u{a}                \"name\": \{\"type\": \"string\", \"value\": \"pug\"\}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-4" {
    expect(reads("\"127.0.0.1\" = \"value\"\u{a}\"character encoding\" = \"value\"\u{a}\"\u{28e}\u{1dd}\u{29e}\" = \"value\"\u{a}'key2' = \"value\"\u{a}'quoted \"value\"' = \"value\"\u{a}", "\{\u{a}    \"127.0.0.1\":          \{\"type\": \"string\", \"value\": \"value\"\},\u{a}    \"character encoding\": \{\"type\": \"string\", \"value\": \"value\"\},\u{a}    \"key2\":               \{\"type\": \"string\", \"value\": \"value\"\},\u{a}    \"quoted \\\"value\\\"\":   \{\"type\": \"string\", \"value\": \"value\"\},\u{a}    \"\u{28e}\u{1dd}\u{29e}\":                \{\"type\": \"string\", \"value\": \"value\"\}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-40" {
    expect(reads("[a.b.c]            # this is best practice\u{a}[ d.e.f ]          # same as [d.e.f]\u{a}[ g .  h  . i ]    # same as [g.h.i]\u{a}[ j . \"\u{29e}\" . 'l' ]  # same as [j.\"\u{29e}\".'l']\u{a}", "\{\u{a}    \"a\": \{\u{a}        \"b\": \{\u{a}            \"c\": \{\}\u{a}        \}\u{a}    \},\u{a}    \"d\": \{\u{a}        \"e\": \{\u{a}            \"f\": \{\}\u{a}        \}\u{a}    \},\u{a}    \"g\": \{\u{a}        \"h\": \{\u{a}            \"i\": \{\}\u{a}        \}\u{a}    \},\u{a}    \"j\": \{\u{a}        \"\u{29e}\": \{\u{a}            \"l\": \{\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-41" {
    expect(reads("# [x] you\u{a}# [x.y] don't\u{a}# [x.y.z] need these\u{a}[x.y.z.w] # for this to work\u{a}\u{a}[x] # defining a super-table afterward is ok\u{a}", "\{\u{a}    \"x\": \{\u{a}        \"y\": \{\u{a}            \"z\": \{\u{a}                \"w\": \{\}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-42" {
    expect(reads("# VALID BUT DISCOURAGED\u{a}[fruit.apple]\u{a}[animal]\u{a}[fruit.orange]\u{a}", "\{\u{a}    \"animal\": \{\},\u{a}    \"fruit\": \{\u{a}        \"apple\":  \{\},\u{a}        \"orange\": \{\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-43" {
    expect(reads("# RECOMMENDED\u{a}[fruit.apple]\u{a}[fruit.orange]\u{a}[animal]\u{a}", "\{\u{a}    \"animal\": \{\},\u{a}    \"fruit\": \{\u{a}        \"apple\":  \{\},\u{a}        \"orange\": \{\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-44" {
    expect(reads("# Top-level table begins.\u{a}name = \"Fido\"\u{a}breed = \"pug\"\u{a}\u{a}# Top-level table ends.\u{a}[owner]\u{a}name = \"Regina Dogman\"\u{a}member_since = 1999-08-04\u{a}", "\{\u{a}    \"breed\": \{\"type\": \"string\", \"value\": \"pug\"\},\u{a}    \"name\":  \{\"type\": \"string\", \"value\": \"Fido\"\},\u{a}    \"owner\": \{\u{a}        \"member_since\": \{\"type\": \"date-local\", \"value\": \"1999-08-04\"\},\u{a}        \"name\":         \{\"type\": \"string\", \"value\": \"Regina Dogman\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-45" {
    expect(reads("fruit.apple.color = \"red\"\u{a}# Defines a table named fruit\u{a}# Defines a table named fruit.apple\u{a}\u{a}fruit.apple.taste.sweet = true\u{a}# Defines a table named fruit.apple.taste\u{a}# fruit and fruit.apple were already created\u{a}", "\{\u{a}    \"fruit\": \{\u{a}        \"apple\": \{\u{a}            \"color\": \{\"type\": \"string\", \"value\": \"red\"\},\u{a}            \"taste\": \{\u{a}                \"sweet\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-46" {
    expect(reads("[fruit]\u{a}apple.color = \"red\"\u{a}apple.taste.sweet = true\u{a}\u{a}# [fruit.apple]  # INVALID\u{a}# [fruit.apple.taste]  # INVALID\u{a}\u{a}[fruit.apple.texture]  # you can add sub-tables\u{a}smooth = true\u{a}", "\{\u{a}    \"fruit\": \{\u{a}        \"apple\": \{\u{a}            \"color\": \{\"type\": \"string\", \"value\": \"red\"\},\u{a}            \"taste\": \{\u{a}                \"sweet\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}            \},\u{a}            \"texture\": \{\u{a}                \"smooth\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-47" {
    expect(reads("name = \{ first = \"Tom\", last = \"Preston-Werner\" \}\u{a}point = \{x=1, y=2\}\u{a}animal = \{ type.name = \"pug\" \}\u{a}contact = \{\u{a}    personal = \{\u{a}        name = \"Donald Duck\",\u{a}        email = \"donald@duckburg.com\",\u{a}    \},\u{a}    work = \{\u{a}        name = \"Coin cleaner\",\u{a}        email = \"donald@ScroogeCorp.com\",\u{a}    \},\u{a}\}\u{a}", "\{\u{a}    \"animal\": \{\u{a}        \"type\": \{\u{a}            \"name\": \{\"type\": \"string\", \"value\": \"pug\"\}\u{a}        \}\u{a}    \},\u{a}    \"contact\": \{\u{a}        \"personal\": \{\u{a}            \"email\": \{\"type\": \"string\", \"value\": \"donald@duckburg.com\"\},\u{a}            \"name\":  \{\"type\": \"string\", \"value\": \"Donald Duck\"\}\u{a}        \},\u{a}        \"work\": \{\u{a}            \"email\": \{\"type\": \"string\", \"value\": \"donald@ScroogeCorp.com\"\},\u{a}            \"name\":  \{\"type\": \"string\", \"value\": \"Coin cleaner\"\}\u{a}        \}\u{a}    \},\u{a}    \"name\": \{\u{a}        \"first\": \{\"type\": \"string\", \"value\": \"Tom\"\},\u{a}        \"last\":  \{\"type\": \"string\", \"value\": \"Preston-Werner\"\}\u{a}    \},\u{a}    \"point\": \{\u{a}        \"x\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \"y\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-48" {
    expect(reads("[name]\u{a}first = \"Tom\"\u{a}last = \"Preston-Werner\"\u{a}\u{a}[point]\u{a}x = 1\u{a}y = 2\u{a}\u{a}[animal]\u{a}type.name = \"pug\"\u{a}\u{a}[contact.personal]\u{a}name = \"Donald Duck\"\u{a}email = \"donald@duckburg.com\"\u{a}\u{a}[contact.work]\u{a}name = \"Coin cleaner\"\u{a}email = \"donald@ScroogeCorp.com\"\u{a}", "\{\u{a}    \"animal\": \{\u{a}        \"type\": \{\u{a}            \"name\": \{\"type\": \"string\", \"value\": \"pug\"\}\u{a}        \}\u{a}    \},\u{a}    \"contact\": \{\u{a}        \"personal\": \{\u{a}            \"email\": \{\"type\": \"string\", \"value\": \"donald@duckburg.com\"\},\u{a}            \"name\":  \{\"type\": \"string\", \"value\": \"Donald Duck\"\}\u{a}        \},\u{a}        \"work\": \{\u{a}            \"email\": \{\"type\": \"string\", \"value\": \"donald@ScroogeCorp.com\"\},\u{a}            \"name\":  \{\"type\": \"string\", \"value\": \"Coin cleaner\"\}\u{a}        \}\u{a}    \},\u{a}    \"name\": \{\u{a}        \"first\": \{\"type\": \"string\", \"value\": \"Tom\"\},\u{a}        \"last\":  \{\"type\": \"string\", \"value\": \"Preston-Werner\"\}\u{a}    \},\u{a}    \"point\": \{\u{a}        \"x\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \"y\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-49" {
    expect(reads("[product]\u{a}type = \{ name = \"Nail\" \}\u{a}# type.edible = false  # INVALID\u{a}", "\{\u{a}    \"product\": \{\u{a}        \"type\": \{\u{a}            \"name\": \{\"type\": \"string\", \"value\": \"Nail\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-50" {
    expect(reads("[product]\u{a}type.name = \"Nail\"\u{a}# type = \{ edible = false \}  # INVALID\u{a}", "\{\u{a}    \"product\": \{\u{a}        \"type\": \{\u{a}            \"name\": \{\"type\": \"string\", \"value\": \"Nail\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-51" {
    expect(reads("[[product]]\u{a}name = \"Hammer\"\u{a}sku = 738594937\u{a}\u{a}[[product]]  # empty table within the array\u{a}\u{a}[[product]]\u{a}name = \"Nail\"\u{a}sku = 284758393\u{a}\u{a}color = \"gray\"\u{a}", "\{\u{a}    \"product\": [\u{a}        \{\u{a}            \"name\": \{\"type\": \"string\", \"value\": \"Hammer\"\},\u{a}            \"sku\":  \{\"type\": \"integer\", \"value\": \"738594937\"\}\u{a}        \},\u{a}        \{\},\u{a}        \{\u{a}            \"color\": \{\"type\": \"string\", \"value\": \"gray\"\},\u{a}            \"name\":  \{\"type\": \"string\", \"value\": \"Nail\"\},\u{a}            \"sku\":   \{\"type\": \"integer\", \"value\": \"284758393\"\}\u{a}        \}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-52" {
    expect(reads("[[fruits]]\u{a}name = \"apple\"\u{a}\u{a}[fruits.physical]  # subtable\u{a}color = \"red\"\u{a}shape = \"round\"\u{a}\u{a}[[fruits.varieties]]  # nested array of tables\u{a}name = \"red delicious\"\u{a}\u{a}[[fruits.varieties]]\u{a}name = \"granny smith\"\u{a}\u{a}\u{a}[[fruits]]\u{a}name = \"banana\"\u{a}\u{a}[[fruits.varieties]]\u{a}name = \"plantain\"\u{a}", "\{\u{a}    \"fruits\": [\u{a}        \{\u{a}            \"name\": \{\"type\": \"string\", \"value\": \"apple\"\},\u{a}            \"physical\": \{\u{a}                \"color\": \{\"type\": \"string\", \"value\": \"red\"\},\u{a}                \"shape\": \{\"type\": \"string\", \"value\": \"round\"\}\u{a}            \},\u{a}            \"varieties\": [\u{a}                \{\u{a}                    \"name\": \{\"type\": \"string\", \"value\": \"red delicious\"\}\u{a}                \},\u{a}                \{\u{a}                    \"name\": \{\"type\": \"string\", \"value\": \"granny smith\"\}\u{a}                \}\u{a}            ]\u{a}        \},\u{a}        \{\u{a}            \"name\":      \{\"type\": \"string\", \"value\": \"banana\"\},\u{a}            \"varieties\": [\{\u{a}                \"name\": \{\"type\": \"string\", \"value\": \"plantain\"\}\u{a}            \}]\u{a}        \}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-53" {
    expect(reads("points = [ \{ x = 1, y = 2, z = 3 \},\u{a}           \{ x = 7, y = 8, z = 9 \},\u{a}           \{ x = 2, y = 4, z = 8 \} ]\u{a}", "\{\u{a}    \"points\": [\u{a}        \{\u{a}            \"x\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}            \"y\": \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}            \"z\": \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}        \},\u{a}        \{\u{a}            \"x\": \{\"type\": \"integer\", \"value\": \"7\"\},\u{a}            \"y\": \{\"type\": \"integer\", \"value\": \"8\"\},\u{a}            \"z\": \{\"type\": \"integer\", \"value\": \"9\"\}\u{a}        \},\u{a}        \{\u{a}            \"x\": \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}            \"y\": \{\"type\": \"integer\", \"value\": \"4\"\},\u{a}            \"z\": \{\"type\": \"integer\", \"value\": \"8\"\}\u{a}        \}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-6" {
    expect(reads("name = \"Orange\"\u{a}physical.color = \"orange\"\u{a}physical.shape = \"round\"\u{a}site.\"google.com\" = true\u{a}", "\{\u{a}    \"name\": \{\"type\": \"string\", \"value\": \"Orange\"\},\u{a}    \"physical\": \{\u{a}        \"color\": \{\"type\": \"string\", \"value\": \"orange\"\},\u{a}        \"shape\": \{\"type\": \"string\", \"value\": \"round\"\}\u{a}    \},\u{a}    \"site\": \{\u{a}        \"google.com\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-7" {
    expect(reads("fruit.name = \"banana\"       # this is best practice\u{a}fruit. color = \"yellow\"     # same as fruit.color\u{a}fruit . flavor = \"banana\"   # same as fruit.flavor\u{a}", "\{\u{a}    \"fruit\": \{\u{a}        \"color\":  \{\"type\": \"string\", \"value\": \"yellow\"\},\u{a}        \"flavor\": \{\"type\": \"string\", \"value\": \"banana\"\},\u{a}        \"name\":   \{\"type\": \"string\", \"value\": \"banana\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-8" {
    expect(reads("# This makes the key \"fruit\" into a table.\u{a}fruit.apple.smooth = true\u{a}\u{a}# So then you can add to the table \"fruit\" like so:\u{a}fruit.orange = 2\u{a}", "\{\u{a}    \"fruit\": \{\u{a}        \"orange\": \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}        \"apple\": \{\u{a}            \"smooth\": \{\"type\": \"bool\", \"value\": \"true\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-1.1.0/common-9" {
    expect(reads("# VALID BUT DISCOURAGED\u{a}\u{a}apple.type = \"fruit\"\u{a}orange.type = \"fruit\"\u{a}\u{a}apple.skin = \"thin\"\u{a}orange.skin = \"thick\"\u{a}\u{a}apple.color = \"red\"\u{a}orange.color = \"orange\"\u{a}", "\{\u{a}    \"apple\": \{\u{a}        \"color\": \{\"type\": \"string\", \"value\": \"red\"\},\u{a}        \"skin\":  \{\"type\": \"string\", \"value\": \"thin\"\},\u{a}        \"type\":  \{\"type\": \"string\", \"value\": \"fruit\"\}\u{a}    \},\u{a}    \"orange\": \{\u{a}        \"color\": \{\"type\": \"string\", \"value\": \"orange\"\},\u{a}        \"skin\":  \{\"type\": \"string\", \"value\": \"thick\"\},\u{a}        \"type\":  \{\"type\": \"string\", \"value\": \"fruit\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-example-1-compact" {
    expect(reads("#Useless spaces eliminated.\u{a}title=\"TOML Example\"\u{a}[owner]\u{a}name=\"Lance Uppercut\"\u{a}dob=1979-05-27T07:32:00-08:00#First class dates\u{a}[database]\u{a}server=\"192.168.1.1\"\u{a}ports=[8001,8001,8002]\u{a}connection_max=5000\u{a}enabled=true\u{a}[servers]\u{a}[servers.alpha]\u{a}ip=\"10.0.0.1\"\u{a}dc=\"eqdc10\"\u{a}[servers.beta]\u{a}ip=\"10.0.0.2\"\u{a}dc=\"eqdc10\"\u{a}[clients]\u{a}data=[[\"gamma\",\"delta\"],[1,2]]\u{a}hosts=[\u{a}\"alpha\",\u{a}\"omega\"\u{a}]\u{a}", "\{\u{a}    \"title\": \{\"type\": \"string\", \"value\": \"TOML Example\"\},\u{a}    \"clients\": \{\u{a}        \"data\": [\u{a}            [\u{a}                \{\"type\": \"string\", \"value\": \"gamma\"\},\u{a}                \{\"type\": \"string\", \"value\": \"delta\"\}\u{a}            ],\u{a}            [\u{a}                \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}                \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}            ]\u{a}        ],\u{a}        \"hosts\": [\u{a}            \{\"type\": \"string\", \"value\": \"alpha\"\},\u{a}            \{\"type\": \"string\", \"value\": \"omega\"\}\u{a}        ]\u{a}    \},\u{a}    \"database\": \{\u{a}        \"connection_max\": \{\"type\": \"integer\", \"value\": \"5000\"\},\u{a}        \"enabled\":        \{\"type\": \"bool\", \"value\": \"true\"\},\u{a}        \"server\":         \{\"type\": \"string\", \"value\": \"192.168.1.1\"\},\u{a}        \"ports\": [\u{a}            \{\"type\": \"integer\", \"value\": \"8001\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"8001\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"8002\"\}\u{a}        ]\u{a}    \},\u{a}    \"owner\": \{\u{a}        \"dob\":  \{\"type\": \"datetime\", \"value\": \"1979-05-27T07:32:00-08:00\"\},\u{a}        \"name\": \{\"type\": \"string\", \"value\": \"Lance Uppercut\"\}\u{a}    \},\u{a}    \"servers\": \{\u{a}        \"alpha\": \{\u{a}            \"dc\": \{\"type\": \"string\", \"value\": \"eqdc10\"\},\u{a}            \"ip\": \{\"type\": \"string\", \"value\": \"10.0.0.1\"\}\u{a}        \},\u{a}        \"beta\": \{\u{a}            \"dc\": \{\"type\": \"string\", \"value\": \"eqdc10\"\},\u{a}            \"ip\": \{\"type\": \"string\", \"value\": \"10.0.0.2\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/spec-example-1" {
    expect(reads("# This is a TOML document. Boom.\u{a}\u{a}title = \"TOML Example\"\u{a}\u{a}[owner]\u{a}name = \"Lance Uppercut\"\u{a}dob = 1979-05-27T07:32:00-08:00 # First class dates? Why not?\u{a}\u{a}[database]\u{a}server = \"192.168.1.1\"\u{a}ports = [ 8001, 8001, 8002 ]\u{a}connection_max = 5000\u{a}enabled = true\u{a}\u{a}[servers]\u{a}\u{a}  # You can indent as you please. Tabs or spaces. TOML don't care.\u{a}  [servers.alpha]\u{a}  ip = \"10.0.0.1\"\u{a}  dc = \"eqdc10\"\u{a}\u{a}  [servers.beta]\u{a}  ip = \"10.0.0.2\"\u{a}  dc = \"eqdc10\"\u{a}\u{a}[clients]\u{a}data = [ [\"gamma\", \"delta\"], [1, 2] ]\u{a}\u{a}# Line breaks are OK when inside arrays\u{a}hosts = [\u{a}  \"alpha\",\u{a}  \"omega\"\u{a}]\u{a}", "\{\u{a}    \"title\": \{\"type\": \"string\", \"value\": \"TOML Example\"\},\u{a}    \"clients\": \{\u{a}        \"data\": [\u{a}            [\u{a}                \{\"type\": \"string\", \"value\": \"gamma\"\},\u{a}                \{\"type\": \"string\", \"value\": \"delta\"\}\u{a}            ],\u{a}            [\u{a}                \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}                \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}            ]\u{a}        ],\u{a}        \"hosts\": [\u{a}            \{\"type\": \"string\", \"value\": \"alpha\"\},\u{a}            \{\"type\": \"string\", \"value\": \"omega\"\}\u{a}        ]\u{a}    \},\u{a}    \"database\": \{\u{a}        \"connection_max\": \{\"type\": \"integer\", \"value\": \"5000\"\},\u{a}        \"enabled\":        \{\"type\": \"bool\", \"value\": \"true\"\},\u{a}        \"server\":         \{\"type\": \"string\", \"value\": \"192.168.1.1\"\},\u{a}        \"ports\": [\u{a}            \{\"type\": \"integer\", \"value\": \"8001\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"8001\"\},\u{a}            \{\"type\": \"integer\", \"value\": \"8002\"\}\u{a}        ]\u{a}    \},\u{a}    \"owner\": \{\u{a}        \"dob\":  \{\"type\": \"datetime\", \"value\": \"1979-05-27T07:32:00-08:00\"\},\u{a}        \"name\": \{\"type\": \"string\", \"value\": \"Lance Uppercut\"\}\u{a}    \},\u{a}    \"servers\": \{\u{a}        \"alpha\": \{\u{a}            \"dc\": \{\"type\": \"string\", \"value\": \"eqdc10\"\},\u{a}            \"ip\": \{\"type\": \"string\", \"value\": \"10.0.0.1\"\}\u{a}        \},\u{a}        \"beta\": \{\u{a}            \"dc\": \{\"type\": \"string\", \"value\": \"eqdc10\"\},\u{a}            \"ip\": \{\"type\": \"string\", \"value\": \"10.0.0.2\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/string/basic-escape-01" {
    expect(reads("# Escape \"\u{a}test = \"\\\"one\\\"\"\u{a}", "\{\u{a}    \"test\": \{\"type\": \"string\", \"value\": \"\\\"one\\\"\"\}\u{a}\}\u{a}"))
}

test "valid/string/basic-escape-02" {
    expect(reads("# Escape \\ and then \"\u{a}test = \"\\\\\\\"one\"\u{a}", "\{\u{a}    \"test\": \{\"type\": \"string\", \"value\": \"\\\\\\\"one\"\}\u{a}\}\u{a}"))
}

test "valid/string/basic-escape-03" {
    expect(reads("# Escape \\ four times and then \"\u{a}test = \"\\\\\\\\\\\\\\\\\\\"one\"\u{a}", "\{\u{a}    \"test\": \{\"type\": \"string\", \"value\": \"\\\\\\\\\\\\\\\\\\\"one\"\}\u{a}\}\u{a}"))
}

test "valid/string/empty" {
    expect(reads("answer = \"\"\u{a}", "\{\u{a}    \"answer\": \{\"type\": \"string\", \"value\": \"\"\}\u{a}\}\u{a}"))
}

test "valid/string/ends-in-whitespace-escape" {
    expect(reads("beee = \"\"\"\u{a}heeee\u{a}geeee\\  \u{a}\u{a}\u{a}      \"\"\"\u{a}", "\{\u{a}    \"beee\": \{\"type\": \"string\", \"value\": \"heeee\\ngeeee\"\}\u{a}\}\u{a}"))
}

test "valid/string/escape-esc" {
    expect(reads("esc = \"\\e There is no escape! \\e\"\u{a}", "\{\u{a}    \"esc\": \{\"type\": \"string\", \"value\": \"\\u001b There is no escape! \\u001b\"\}\u{a}\}\u{a}"))
}

test "valid/string/escape-tricky" {
    expect(reads("end_esc = \"String does not end here\\\" but ends here\\\\\"\u{a}lit_end_esc = 'String ends here\\'\u{a}\u{a}multiline_unicode = \"\"\"\u{a}\\u00a0\"\"\"\u{a}\u{a}multiline_not_unicode = \"\"\"\u{a}\\\\u0041\"\"\"\u{a}\u{a}multiline_end_esc = \"\"\"When will it end? \\\"\"\"...\"\"\\\" should be here\\\"\"\"\"\u{a}\u{a}lit_multiline_not_unicode = '''\u{a}\\u007f'''\u{a}\u{a}lit_multiline_end = '''There is no escape\\'''\u{a}", "\{\u{a}    \"end_esc\":                   \{\"type\": \"string\", \"value\": \"String does not end here\\\" but ends here\\\\\"\},\u{a}    \"lit_end_esc\":               \{\"type\": \"string\", \"value\": \"String ends here\\\\\"\},\u{a}    \"lit_multiline_end\":         \{\"type\": \"string\", \"value\": \"There is no escape\\\\\"\},\u{a}    \"lit_multiline_not_unicode\": \{\"type\": \"string\", \"value\": \"\\\\u007f\"\},\u{a}    \"multiline_end_esc\":         \{\"type\": \"string\", \"value\": \"When will it end? \\\"\\\"\\\"...\\\"\\\"\\\" should be here\\\"\"\},\u{a}    \"multiline_not_unicode\":     \{\"type\": \"string\", \"value\": \"\\\\u0041\"\},\u{a}    \"multiline_unicode\":         \{\"type\": \"string\", \"value\": \"\u{a0}\"\}\u{a}\}\u{a}"))
}

test "valid/string/escaped-escape" {
    expect(reads("answer = \"\\\\x64\"\u{a}", "\{\u{a}    \"answer\": \{\"type\": \"string\", \"value\": \"\\\\x64\"\}\u{a}\}\u{a}"))
}

test "valid/string/escapes" {
    expect(reads("backspace     = \"|\\b.\"\u{a}tab           = \"|\\t.\"\u{a}newline       = \"|\\n.\"\u{a}formfeed      = \"|\\f.\"\u{a}carriage      = \"|\\r.\"\u{a}quote         = \"|\\\".\"\u{a}backslash     = \"|\\\\.\"\u{a}delete        = \"|\\u007F.\"\u{a}unitseparator = \"|\\u001F.\"\u{a}\u{a}# \\u is escaped, so should NOT be interperted as a \\u escape.\u{a}notunicode1   = \"|\\\\u.\"\u{a}notunicode2   = \"|\\u005Cu.\"\u{a}notunicode3   = \"|\\\\u0075.\"\u{a}notunicode4   = \"|\\\\\\u0075.\"\u{a}", "\{\u{a}    \"backslash\":     \{\"type\": \"string\", \"value\": \"|\\\\.\"\},\u{a}    \"backspace\":     \{\"type\": \"string\", \"value\": \"|\\b.\"\},\u{a}    \"carriage\":      \{\"type\": \"string\", \"value\": \"|\\r.\"\},\u{a}    \"delete\":        \{\"type\": \"string\", \"value\": \"|\u{7f}.\"\},\u{a}    \"formfeed\":      \{\"type\": \"string\", \"value\": \"|\\f.\"\},\u{a}    \"newline\":       \{\"type\": \"string\", \"value\": \"|\\n.\"\},\u{a}    \"notunicode1\":   \{\"type\": \"string\", \"value\": \"|\\\\u.\"\},\u{a}    \"notunicode2\":   \{\"type\": \"string\", \"value\": \"|\\\\u.\"\},\u{a}    \"notunicode3\":   \{\"type\": \"string\", \"value\": \"|\\\\u0075.\"\},\u{a}    \"notunicode4\":   \{\"type\": \"string\", \"value\": \"|\\\\u.\"\},\u{a}    \"quote\":         \{\"type\": \"string\", \"value\": \"|\\\".\"\},\u{a}    \"tab\":           \{\"type\": \"string\", \"value\": \"|\\t.\"\},\u{a}    \"unitseparator\": \{\"type\": \"string\", \"value\": \"|\\u001f.\"\}\u{a}\}\u{a}"))
}

test "valid/string/hex-escape" {
    expect(reads("# \\x for the first 255 codepoints\u{a}\u{a}whitespace      = \"\\x20 \\x09 \\x1b \\x0d\\x0a\"\u{a}bs              = \"\\x7f\"\u{a}nul             = \"\\x00\"\u{a}hello           = \"\\x68\\x65\\x6c\\x6c\\x6f\\x0a\"\u{a}higher-than-127 = \"S\\xf8rmirb\\xe6ren\"\u{a}\u{a}multiline = \"\"\"\u{a}\\x20 \\x09 \\x1b \\x0d\\x0a\u{a}\\x7f\u{a}\\x00\u{a}\\x68\\x65\\x6c\\x6c\\x6f\\x0a\u{a}\\x53\\xF8\\x72\\x6D\\x69\\x72\\x62\\xE6\\x72\\x65\\x6E\u{a}\"\"\"\u{a}\u{a}# Not inside literals.\u{a}literal = '\\x20 \\x09 \\x0d\\x0a'\u{a}multiline-literal = '''\u{a}\\x20 \\x09 \\x0d\\x0a\u{a}'''\u{a}", "\{\u{a}    \"bs\":                \{\"type\": \"string\", \"value\": \"\u{7f}\"\},\u{a}    \"hello\":             \{\"type\": \"string\", \"value\": \"hello\\n\"\},\u{a}    \"higher-than-127\":   \{\"type\": \"string\", \"value\": \"S\u{f8}rmirb\u{e6}ren\"\},\u{a}    \"literal\":           \{\"type\": \"string\", \"value\": \"\\\\x20 \\\\x09 \\\\x0d\\\\x0a\"\},\u{a}    \"multiline\":         \{\"type\": \"string\", \"value\": \"  \\t \\u001b \\r\\n\\n\u{7f}\\n\\u0000\\nhello\\n\\nS\u{f8}rmirb\u{e6}ren\\n\"\},\u{a}    \"multiline-literal\": \{\"type\": \"string\", \"value\": \"\\\\x20 \\\\x09 \\\\x0d\\\\x0a\\n\"\},\u{a}    \"nul\":               \{\"type\": \"string\", \"value\": \"\\u0000\"\},\u{a}    \"whitespace\":        \{\"type\": \"string\", \"value\": \"  \\t \\u001b \\r\\n\"\}\u{a}\}\u{a}"))
}

test "valid/string/multibyte-escape" {
    expect(reads("# Test each multibyte length: 2, 3, and 4 bytes:\u{a}# \u{251} \u{20ac} \u{10af1}\u{a}\u{a}basic-1    = \"\\u0251 \\u20ac \\U00010AF1 \\u0251\\u20ac\\U00010AF1\"\u{a}ml-basic-1 = \"\"\"\\u0251 \\u20ac \\U00010AF1 \\u0251\\u20ac\\U00010AF1\"\"\"\u{a}\u{a}# Again, but only using \\U\u{a}basic-2    = \"\\U00000251 \\U000020ac \\U00010AF1 \\U00000251\\U000020ac\\U00010AF1\"\u{a}ml-basic-2 = \"\"\"\\U00000251 \\U000020ac \\U00010AF1 \\U00000251\\U000020ac\\U00010AF1\"\"\"\u{a}", "\{\u{a}    \"basic-1\":    \{\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"\},\u{a}    \"ml-basic-1\": \{\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"\},\u{a}    \"basic-2\":    \{\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"\},\u{a}    \"ml-basic-2\": \{\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"\}\u{a}\}\u{a}"))
}

test "valid/string/multibyte" {
    expect(reads("# Test each multibyte length: 2, 3, and 4 bytes:\u{a}# \u{251} \u{20ac} \u{10af1}\u{a}\u{a}basic    = \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"\u{a}raw      = '\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}'\u{a}ml-basic = \"\"\"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"\"\"\u{a}ml-raw   = '''\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}'''\u{a}", "\{\u{a}    \"basic\":    \{\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"\},\u{a}    \"ml-basic\": \{\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"\},\u{a}    \"ml-raw\":   \{\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"\},\u{a}    \"raw\":      \{\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"\}\u{a}\}\u{a}"))
}

test "valid/string/multiline-empty" {
    expect(reads("empty-1 = \"\"\"\"\"\"\u{a}\u{a}# A newline immediately following the opening delimiter will be trimmed.\u{a}empty-2 = \"\"\"\u{a}\"\"\"\u{a}\u{a}# \\ at the end of line trims newlines as well; note that last \\ is followed by\u{a}# two spaces, which are ignored.\u{a}empty-3 = \"\"\"\\\u{a}    \"\"\"\u{a}empty-4 = \"\"\"\\\u{a}   \\\u{a}   \\  \u{a}   \"\"\"\u{a}\u{a}", "\{\u{a}    \"empty-1\": \{\"type\": \"string\", \"value\": \"\"\},\u{a}    \"empty-2\": \{\"type\": \"string\", \"value\": \"\"\},\u{a}    \"empty-3\": \{\"type\": \"string\", \"value\": \"\"\},\u{a}    \"empty-4\": \{\"type\": \"string\", \"value\": \"\"\}\u{a}\}\u{a}"))
}

test "valid/string/multiline-escaped-crlf" {
    expect(reads("# The following line should be an unescaped backslash followed by a Windows\u{d}\u{a}# newline sequence (\"\\r\\n\")\u{d}\u{a}0=\"\"\"\\\u{d}\u{a}\"\"\"\u{d}\u{a}", "\{\u{a}    \"0\": \{\"type\": \"string\", \"value\": \"\"\}\u{a}\}\u{a}"))
}

test "valid/string/multiline-quotes" {
    expect(reads("# Make sure that quotes inside multiline strings are allowed, including right\u{a}# after the opening '''/\"\"\" and before the closing '''/\"\"\"\u{a}\u{a}lit_one = ''''one quote''''\u{a}lit_two = '''''two quotes'''''\u{a}lit_one_space = ''' 'one quote' '''\u{a}lit_two_space = ''' ''two quotes'' '''\u{a}\u{a}one = \"\"\"\"one quote\"\"\"\"\u{a}two = \"\"\"\"\"two quotes\"\"\"\"\"\u{a}one_space = \"\"\" \"one quote\" \"\"\"\u{a}two_space = \"\"\" \"\"two quotes\"\" \"\"\"\u{a}\u{a}mismatch1 = \"\"\"aaa'''bbb\"\"\"\u{a}mismatch2 = '''aaa\"\"\"bbb'''\u{a}\u{a}# Three opening \"\"\", then one escaped \", then two \"\" (allowed), and then three\u{a}# closing \"\"\"\u{a}escaped = \"\"\"lol\\\"\"\"\"\"\"\u{a}\u{a}five-quotes = \"\"\"\u{a}Closing with five quotes\u{a}\"\"\"\"\"\u{a}four-quotes = \"\"\"\u{a}Closing with four quotes\u{a}\"\"\"\"\u{a}", "\{\u{a}    \"escaped\":       \{\"type\": \"string\", \"value\": \"lol\\\"\\\"\\\"\"\},\u{a}    \"five-quotes\":   \{\"type\": \"string\", \"value\": \"Closing with five quotes\\n\\\"\\\"\"\},\u{a}    \"four-quotes\":   \{\"type\": \"string\", \"value\": \"Closing with four quotes\\n\\\"\"\},\u{a}    \"lit_one\":       \{\"type\": \"string\", \"value\": \"'one quote'\"\},\u{a}    \"lit_one_space\": \{\"type\": \"string\", \"value\": \" 'one quote' \"\},\u{a}    \"lit_two\":       \{\"type\": \"string\", \"value\": \"''two quotes''\"\},\u{a}    \"lit_two_space\": \{\"type\": \"string\", \"value\": \" ''two quotes'' \"\},\u{a}    \"mismatch1\":     \{\"type\": \"string\", \"value\": \"aaa'''bbb\"\},\u{a}    \"mismatch2\":     \{\"type\": \"string\", \"value\": \"aaa\\\"\\\"\\\"bbb\"\},\u{a}    \"one\":           \{\"type\": \"string\", \"value\": \"\\\"one quote\\\"\"\},\u{a}    \"one_space\":     \{\"type\": \"string\", \"value\": \" \\\"one quote\\\" \"\},\u{a}    \"two\":           \{\"type\": \"string\", \"value\": \"\\\"\\\"two quotes\\\"\\\"\"\},\u{a}    \"two_space\":     \{\"type\": \"string\", \"value\": \" \\\"\\\"two quotes\\\"\\\" \"\}\u{a}\}\u{a}"))
}

test "valid/string/multiline" {
    expect(reads("# NOTE: this file includes some literal tab characters.\u{a}\u{a}equivalent_one = \"The quick brown fox jumps over the lazy dog.\"\u{a}equivalent_two = \"\"\"\u{a}The quick brown \\\u{a}\u{a}\u{a}  fox jumps over \\\u{a}    the lazy dog.\"\"\"\u{a}\u{a}equivalent_three = \"\"\"\\\u{a}       The quick brown \\\u{a}       fox jumps over \\\u{a}       the lazy dog.\\\u{a}       \"\"\"\u{a}\u{a}whitespace-after-bs = \"\"\"\\\u{a}       The quick brown \\\u{a}       fox jumps over \\   \u{a}       the lazy dog.\\\u{9}\u{a}       \"\"\"\u{a}\u{a}no-space = \"\"\"a\\\u{a}    b\"\"\"\u{a}\u{a}# Has tab character.\u{a}keep-ws-before = \"\"\"a   \u{9}\\\u{a}   b\"\"\"\u{a}\u{a}escape-bs-1 = \"\"\"a \\\\\u{a}b\"\"\"\u{a}\u{a}escape-bs-2 = \"\"\"a \\\\\\\u{a}b\"\"\"\u{a}\u{a}escape-bs-3 = \"\"\"a \\\\\\\\\u{a}  b\"\"\"\u{a}", "\{\u{a}    \"equivalent_one\":      \{\"type\": \"string\", \"value\": \"The quick brown fox jumps over the lazy dog.\"\},\u{a}    \"equivalent_three\":    \{\"type\": \"string\", \"value\": \"The quick brown fox jumps over the lazy dog.\"\},\u{a}    \"equivalent_two\":      \{\"type\": \"string\", \"value\": \"The quick brown fox jumps over the lazy dog.\"\},\u{a}    \"escape-bs-1\":         \{\"type\": \"string\", \"value\": \"a \\\\\\nb\"\},\u{a}    \"escape-bs-2\":         \{\"type\": \"string\", \"value\": \"a \\\\b\"\},\u{a}    \"escape-bs-3\":         \{\"type\": \"string\", \"value\": \"a \\\\\\\\\\n  b\"\},\u{a}    \"keep-ws-before\":      \{\"type\": \"string\", \"value\": \"a   \\tb\"\},\u{a}    \"no-space\":            \{\"type\": \"string\", \"value\": \"ab\"\},\u{a}    \"whitespace-after-bs\": \{\"type\": \"string\", \"value\": \"The quick brown fox jumps over the lazy dog.\"\}\u{a}\}\u{a}"))
}

test "valid/string/nl" {
    expect(reads("nl_mid = \"val\\nue\"\u{a}nl_end = \"\"\"value\\n\"\"\"\u{a}\u{a}lit_nl_end = '''value\\n'''\u{a}lit_nl_mid = 'val\\nue'\u{a}lit_nl_uni = 'val\\ue'\u{a}", "\{\u{a}    \"lit_nl_end\": \{\"type\": \"string\", \"value\": \"value\\\\n\"\},\u{a}    \"lit_nl_mid\": \{\"type\": \"string\", \"value\": \"val\\\\nue\"\},\u{a}    \"lit_nl_uni\": \{\"type\": \"string\", \"value\": \"val\\\\ue\"\},\u{a}    \"nl_end\":     \{\"type\": \"string\", \"value\": \"value\\n\"\},\u{a}    \"nl_mid\":     \{\"type\": \"string\", \"value\": \"val\\nue\"\}\u{a}\}\u{a}"))
}

test "valid/string/quoted-unicode" {
    expect(reads("\u{a}escaped_string = \"\\u0000 \\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff\"\u{a}not_escaped_string = '\\u0000 \\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff'\u{a}\u{a}basic_string = \"~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\"\u{a}literal_string = '~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}'\u{a}", "\{\u{a}    \"basic_string\":   \{\"type\": \"string\", \"value\": \"~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\"\},\u{a}    \"escaped_string\": \{\"type\": \"string\", \"value\": \"\\u0000 \\b \\f A \u{7f} \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\"\},\u{a}    \"literal_string\": \{\"type\": \"string\", \"value\": \"~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\"\},\u{a}    \"not_escaped_string\": \{\u{a}        \"type\":  \"string\",\u{a}        \"value\": \"\\\\u0000 \\\\u0008 \\\\u000c \\\\U00000041 \\\\u007f \\\\u0080 \\\\u00ff \\\\ud7ff \\\\ue000 \\\\uffff \\\\U00010000 \\\\U0010ffff\"\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/string/raw-empty" {
    expect(reads("empty = ''\u{a}", "\{\u{a}    \"empty\": \{\"type\": \"string\", \"value\": \"\"\}\u{a}\}\u{a}"))
}

test "valid/string/raw-multiline" {
    expect(reads("# Single ' should be allowed.\u{a}oneline = '''This string has a ' quote character.'''\u{a}\u{a}# A newline immediately following the opening delimiter will be trimmed.\u{a}firstnl = '''\u{a}This string has a ' quote character.'''\u{a}\u{a}# All other whitespace and newline characters remain intact.\u{a}multiline = '''\u{a}This string\u{a}has ' a quote character\u{a}and more than\u{a}one newline\u{a}in it.'''\u{a}\u{a}# Tab character in literal string does not need to be escaped\u{a}multiline_with_tab = '''First line\u{a}\u{9} Followed by a tab'''\u{a}\u{a}this-str-has-apostrophes='''' there's one already\u{a}'' two more\u{a}'''''\u{a}", "\{\u{a}    \"firstnl\":                  \{\"type\": \"string\", \"value\": \"This string has a ' quote character.\"\},\u{a}    \"multiline\":                \{\"type\": \"string\", \"value\": \"This string\\nhas ' a quote character\\nand more than\\none newline\\nin it.\"\},\u{a}    \"multiline_with_tab\":       \{\"type\": \"string\", \"value\": \"First line\\n\\t Followed by a tab\"\},\u{a}    \"oneline\":                  \{\"type\": \"string\", \"value\": \"This string has a ' quote character.\"\},\u{a}    \"this-str-has-apostrophes\": \{\"type\": \"string\", \"value\": \"' there's one already\\n'' two more\\n''\"\}\u{a}\}\u{a}"))
}

test "valid/string/raw" {
    expect(reads("backspace = 'This string has a \\b backspace character.'\u{a}tab = 'This string has a \\t tab character.'\u{a}unescaped_tab = 'This string has an \u{9} unescaped tab character.'\u{a}newline = 'This string has a \\n new line character.'\u{a}formfeed = 'This string has a \\f form feed character.'\u{a}carriage = 'This string has a \\r carriage return character.'\u{a}slash = 'This string has a \\/ slash character.'\u{a}backslash = 'This string has a \\\\ backslash character.'\u{a}", "\{\u{a}    \"backslash\":     \{\"type\": \"string\", \"value\": \"This string has a \\\\\\\\ backslash character.\"\},\u{a}    \"backspace\":     \{\"type\": \"string\", \"value\": \"This string has a \\\\b backspace character.\"\},\u{a}    \"carriage\":      \{\"type\": \"string\", \"value\": \"This string has a \\\\r carriage return character.\"\},\u{a}    \"formfeed\":      \{\"type\": \"string\", \"value\": \"This string has a \\\\f form feed character.\"\},\u{a}    \"newline\":       \{\"type\": \"string\", \"value\": \"This string has a \\\\n new line character.\"\},\u{a}    \"slash\":         \{\"type\": \"string\", \"value\": \"This string has a \\\\/ slash character.\"\},\u{a}    \"tab\":           \{\"type\": \"string\", \"value\": \"This string has a \\\\t tab character.\"\},\u{a}    \"unescaped_tab\": \{\"type\": \"string\", \"value\": \"This string has an \\t unescaped tab character.\"\}\u{a}\}\u{a}"))
}

test "valid/string/simple" {
    expect(reads("answer = \"You are not drinking enough whisky.\"\u{a}", "\{\u{a}    \"answer\": \{\"type\": \"string\", \"value\": \"You are not drinking enough whisky.\"\}\u{a}\}\u{a}"))
}

test "valid/string/start-mb" {
    expect(reads("# Start first line with a multibyte character.\u{a}#\u{a}# https://github.com/marzer/tomlplusplus/issues/190\u{a}s1 = \"\u{a7}\"\u{a}s2 = '\u{a7}'\u{a}s3 = \"\"\"\\\u{a}\u{a7}\"\"\"\u{a}s4 = \"\"\"\u{a}\u{a7}\"\"\"\u{a}s5 = \"\"\"\u{a7}\"\"\"\u{a}s6 = '''\u{a}\u{a7}'''\u{a}s7 = '''\u{a7}'''\u{a}", "\{\u{a}    \"s1\": \{\"type\": \"string\", \"value\": \"\u{a7}\"\},\u{a}    \"s2\": \{\"type\": \"string\", \"value\": \"\u{a7}\"\},\u{a}    \"s3\": \{\"type\": \"string\", \"value\": \"\u{a7}\"\},\u{a}    \"s4\": \{\"type\": \"string\", \"value\": \"\u{a7}\"\},\u{a}    \"s5\": \{\"type\": \"string\", \"value\": \"\u{a7}\"\},\u{a}    \"s6\": \{\"type\": \"string\", \"value\": \"\u{a7}\"\},\u{a}    \"s7\": \{\"type\": \"string\", \"value\": \"\u{a7}\"\}\u{a}\}\u{a}"))
}

test "valid/string/unicode-escape" {
    expect(reads("delta-1 = \"\\u03B4\"\u{a}delta-2 = \"\\U000003B4\"\u{a}a       = \"\\u0061\"\u{a}b       = \"\\u0062\"\u{a}c       = \"\\U00000063\"\u{a}null-1  = \"\\u0000\"\u{a}null-2  = \"\\U00000000\"\u{a}\u{a}ml-delta-1 = \"\"\"\\u03B4\"\"\"\u{a}ml-delta-2 = \"\"\"\\U000003B4\"\"\"\u{a}ml-a       = \"\"\"\\u0061\"\"\"\u{a}ml-b       = \"\"\"\\u0062\"\"\"\u{a}ml-c       = \"\"\"\\U00000063\"\"\"\u{a}ml-null-1  = \"\"\"\\u0000\"\"\"\u{a}ml-null-2  = \"\"\"\\U00000000\"\"\"\u{a}", "\{\u{a}    \"a\":          \{\"type\": \"string\", \"value\": \"a\"\},\u{a}    \"b\":          \{\"type\": \"string\", \"value\": \"b\"\},\u{a}    \"c\":          \{\"type\": \"string\", \"value\": \"c\"\},\u{a}    \"delta-1\":    \{\"type\": \"string\", \"value\": \"\u{3b4}\"\},\u{a}    \"delta-2\":    \{\"type\": \"string\", \"value\": \"\u{3b4}\"\},\u{a}    \"ml-a\":       \{\"type\": \"string\", \"value\": \"a\"\},\u{a}    \"ml-b\":       \{\"type\": \"string\", \"value\": \"b\"\},\u{a}    \"ml-c\":       \{\"type\": \"string\", \"value\": \"c\"\},\u{a}    \"ml-delta-1\": \{\"type\": \"string\", \"value\": \"\u{3b4}\"\},\u{a}    \"ml-delta-2\": \{\"type\": \"string\", \"value\": \"\u{3b4}\"\},\u{a}    \"ml-null-1\":  \{\"type\": \"string\", \"value\": \"\\u0000\"\},\u{a}    \"ml-null-2\":  \{\"type\": \"string\", \"value\": \"\\u0000\"\},\u{a}    \"null-1\":     \{\"type\": \"string\", \"value\": \"\\u0000\"\},\u{a}    \"null-2\":     \{\"type\": \"string\", \"value\": \"\\u0000\"\}\u{a}\}\u{a}"))
}

test "valid/string/with-pound" {
    expect(reads("pound = \"We see no # comments here.\"\u{a}poundcomment = \"But there are # some comments here.\" # Did I # mess you up?\u{a}", "\{\u{a}    \"pound\":        \{\"type\": \"string\", \"value\": \"We see no # comments here.\"\},\u{a}    \"poundcomment\": \{\"type\": \"string\", \"value\": \"But there are # some comments here.\"\}\u{a}\}\u{a}"))
}

test "valid/table/array-empty-name" {
    expect(reads("# Silly thing to do, but valid.\u{a}\u{a}[['']]\u{a}a = 1\u{a}[['']]\u{a}a = 2\u{a}", "\{\u{a}    \"\": [\u{a}        \{\"a\": \{\"type\": \"integer\", \"value\": \"1\"\}\},\u{a}        \{\"a\": \{\"type\": \"integer\", \"value\": \"2\"\}\}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/table/array-empty" {
    expect(reads("[[a]]\u{a}", "\{\u{a}    \"a\": [\{\}]\u{a}\}\u{a}"))
}

test "valid/table/array-implicit-and-explicit-after" {
    expect(reads("[[a.b]]\u{a}x = 1\u{a}\u{a}[a]\u{a}y = 2\u{a}", "\{\u{a}    \"a\": \{\u{a}        \"b\": [\{\u{a}            \"x\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}        \}],\u{a}        \"y\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/array-implicit" {
    expect(reads("[[albums.songs]]\u{a}name = \"Glory Days\"\u{a}", "\{\u{a}    \"albums\": \{\"songs\": [\{\u{a}        \"name\": \{\"type\": \"string\", \"value\": \"Glory Days\"\}\u{a}    \}]\}\u{a}\}\u{a}"))
}

test "valid/table/array-many" {
    expect(reads("[[people]]\u{a}first_name = \"Bruce\"\u{a}last_name = \"Springsteen\"\u{a}\u{a}[[people]]\u{a}first_name = \"Eric\"\u{a}last_name = \"Clapton\"\u{a}\u{a}[[people]]\u{a}first_name = \"Bob\"\u{a}last_name = \"Seger\"\u{a}", "\{\u{a}    \"people\": [\u{a}        \{\u{a}            \"first_name\": \{\"type\": \"string\", \"value\": \"Bruce\"\},\u{a}            \"last_name\":  \{\"type\": \"string\", \"value\": \"Springsteen\"\}\u{a}        \},\u{a}        \{\u{a}            \"first_name\": \{\"type\": \"string\", \"value\": \"Eric\"\},\u{a}            \"last_name\":  \{\"type\": \"string\", \"value\": \"Clapton\"\}\u{a}        \},\u{a}        \{\u{a}            \"first_name\": \{\"type\": \"string\", \"value\": \"Bob\"\},\u{a}            \"last_name\":  \{\"type\": \"string\", \"value\": \"Seger\"\}\u{a}        \}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/table/array-nest" {
    expect(reads("[[albums]]\u{a}name = \"Born to Run\"\u{a}\u{a}  [[albums.songs]]\u{a}  name = \"Jungleland\"\u{a}\u{a}  [[albums.songs]]\u{a}  name = \"Meeting Across the River\"\u{a}\u{a}[[albums]]\u{a}name = \"Born in the USA\"\u{a}  \u{a}  [[albums.songs]]\u{a}  name = \"Glory Days\"\u{a}\u{a}  [[albums.songs]]\u{a}  name = \"Dancing in the Dark\"\u{a}", "\{\u{a}    \"albums\": [\u{a}        \{\u{a}            \"name\": \{\"type\": \"string\", \"value\": \"Born to Run\"\},\u{a}            \"songs\": [\u{a}                \{\u{a}                    \"name\": \{\"type\": \"string\", \"value\": \"Jungleland\"\}\u{a}                \},\u{a}                \{\u{a}                    \"name\": \{\"type\": \"string\", \"value\": \"Meeting Across the River\"\}\u{a}                \}\u{a}            ]\u{a}        \},\u{a}        \{\u{a}            \"name\": \{\"type\": \"string\", \"value\": \"Born in the USA\"\},\u{a}            \"songs\": [\u{a}                \{\u{a}                    \"name\": \{\"type\": \"string\", \"value\": \"Glory Days\"\}\u{a}                \},\u{a}                \{\u{a}                    \"name\": \{\"type\": \"string\", \"value\": \"Dancing in the Dark\"\}\u{a}                \}\u{a}            ]\u{a}        \}\u{a}    ]\u{a}\}\u{a}"))
}

test "valid/table/array-one" {
    expect(reads("[[people]]\u{a}first_name = \"Bruce\"\u{a}last_name = \"Springsteen\"\u{a}", "\{\u{a}    \"people\": [\{\u{a}        \"first_name\": \{\"type\": \"string\", \"value\": \"Bruce\"\},\u{a}        \"last_name\":  \{\"type\": \"string\", \"value\": \"Springsteen\"\}\u{a}    \}]\u{a}\}\u{a}"))
}

test "valid/table/array-table-array" {
    expect(reads("[[a]]\u{a}    [[a.b]]\u{a}        [a.b.c]\u{a}            d = \"val0\"\u{a}    [[a.b]]\u{a}        [a.b.c]\u{a}            d = \"val1\"\u{a}", "\{\u{a}    \"a\": [\{\u{a}        \"b\": [\u{a}            \{\u{a}                \"c\": \{\u{a}                    \"d\": \{\"type\": \"string\", \"value\": \"val0\"\}\u{a}                \}\u{a}            \},\u{a}            \{\u{a}                \"c\": \{\u{a}                    \"d\": \{\"type\": \"string\", \"value\": \"val1\"\}\u{a}                \}\u{a}            \}\u{a}        ]\u{a}    \}]\u{a}\}\u{a}"))
}

test "valid/table/array-within-dotted" {
    expect(reads("[fruit]\u{a}apple.color = \"red\"\u{a}\u{a}[[fruit.apple.seeds]]\u{a}size = 2\u{a}", "\{\u{a}    \"fruit\": \{\u{a}        \"apple\": \{\u{a}            \"color\": \{\"type\": \"string\", \"value\": \"red\"\},\u{a}            \"seeds\": [\{\u{a}                \"size\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}            \}]\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/empty-name" {
    expect(reads("['']\u{a}x = 1\u{a}\u{a}[\"\".a]\u{a}x = 2\u{a}\u{a}[a.'']\u{a}x = 3\u{a}", "\{\u{a}    \"\": \{\u{a}        \"x\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \"a\": \{\u{a}            \"x\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}        \}\u{a}    \},\u{a}    \"a\": \{\u{a}        \"\": \{\u{a}            \"x\": \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/empty" {
    expect(reads("[a]\u{a}", "\{\u{a}    \"a\": \{\}\u{a}\}\u{a}"))
}

test "valid/table/keyword-with-values" {
    expect(reads("[true]\u{a}k = 1\u{a}\u{a}[false]\u{a}k = 2\u{a}\u{a}[inf]\u{a}k = 3\u{a}\u{a}[nan]\u{a}k = 4\u{a}", "\{\u{a}    \"false\": \{\u{a}        \"k\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}    \},\u{a}    \"inf\": \{\u{a}        \"k\": \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}    \},\u{a}    \"nan\": \{\u{a}        \"k\": \{\"type\": \"integer\", \"value\": \"4\"\}\u{a}    \},\u{a}    \"true\": \{\u{a}        \"k\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/keyword" {
    expect(reads("[true]\u{a}\u{a}[false]\u{a}\u{a}[inf]\u{a}\u{a}[nan]\u{a}\u{a}\u{a}", "\{\u{a}    \"false\": \{\},\u{a}    \"inf\":   \{\},\u{a}    \"nan\":   \{\},\u{a}    \"true\":  \{\}\u{a}\}\u{a}"))
}

test "valid/table/names-with-values" {
    expect(reads("[a.b.c]\u{a}key = 1\u{a}\u{a}[a.\"b.c\"]\u{a}key = 2\u{a}\u{a}[a.'d.e']\u{a}key = 3\u{a}\u{a}[a.' x ']\u{a}key = 4\u{a}\u{a}[ d.e.f ]\u{a}key = 5\u{a}\u{a}[ g . h . i ]\u{a}key = 6\u{a}\u{a}[ j . \"\u{29e}\" . 'l' ]\u{a}key = 7\u{a}\u{a}[x.1.2]\u{a}key = 8\u{a}", "\{\u{a}    \"a\": \{\u{a}        \" x \": \{\u{a}            \"key\": \{\"type\": \"integer\", \"value\": \"4\"\}\u{a}        \},\u{a}        \"b\": \{\u{a}            \"c\": \{\u{a}                \"key\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}            \}\u{a}        \},\u{a}        \"b.c\": \{\u{a}            \"key\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}        \},\u{a}        \"d.e\": \{\u{a}            \"key\": \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}        \}\u{a}    \},\u{a}    \"d\": \{\u{a}        \"e\": \{\u{a}            \"f\": \{\u{a}                \"key\": \{\"type\": \"integer\", \"value\": \"5\"\}\u{a}            \}\u{a}        \}\u{a}    \},\u{a}    \"g\": \{\u{a}        \"h\": \{\u{a}            \"i\": \{\u{a}                \"key\": \{\"type\": \"integer\", \"value\": \"6\"\}\u{a}            \}\u{a}        \}\u{a}    \},\u{a}    \"j\": \{\u{a}        \"\u{29e}\": \{\u{a}            \"l\": \{\u{a}                \"key\": \{\"type\": \"integer\", \"value\": \"7\"\}\u{a}            \}\u{a}        \}\u{a}    \},\u{a}    \"x\": \{\u{a}        \"1\": \{\u{a}            \"2\": \{\u{a}                \"key\": \{\"type\": \"integer\", \"value\": \"8\"\}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/names" {
    expect(reads("[a.b.c]\u{a}[a.\"b.c\"]\u{a}[a.'d.e']\u{a}[a.' x ']\u{a}[ d.e.f ]\u{a}[ g . h . i ]\u{a}[ j . \"\u{29e}\" . 'l' ]\u{a}\u{a}[x.1.2]\u{a}", "\{\u{a}    \"a\": \{\u{a}        \" x \": \{\},\u{a}        \"b.c\": \{\},\u{a}        \"d.e\": \{\},\u{a}        \"b\": \{\u{a}            \"c\": \{\}\u{a}        \}\u{a}    \},\u{a}    \"d\": \{\u{a}        \"e\": \{\u{a}            \"f\": \{\}\u{a}        \}\u{a}    \},\u{a}    \"g\": \{\u{a}        \"h\": \{\u{a}            \"i\": \{\}\u{a}        \}\u{a}    \},\u{a}    \"j\": \{\u{a}        \"\u{29e}\": \{\u{a}            \"l\": \{\}\u{a}        \}\u{a}    \},\u{a}    \"x\": \{\u{a}        \"1\": \{\u{a}            \"2\": \{\}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/no-eol-01" {
    expect(reads("# No newline at end of file.\u{a}[table]", "\{\u{a}    \"table\": \{\}\u{a}\}\u{a}"))
}

test "valid/table/no-eol-02" {
    expect(reads("# No newline at end of file.\u{a}[table]\u{a}a=1", "\{\u{a}    \"table\": \{\u{a}        \"a\": \{\"type\": \"integer\", \"value\": \"1\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/sub-empty" {
    expect(reads("[a]\u{a}[a.b]\u{a}", "\{\u{a}    \"a\": \{\u{a}        \"b\": \{\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/sub" {
    expect(reads("[a]\u{a}key = 1\u{a}\u{a}# a.extend is a key inside the \"a\" table.\u{a}[a.extend]\u{a}key = 2\u{a}\u{a}[a.extend.more]\u{a}key = 3\u{a}", "\{\u{a}    \"a\": \{\u{a}        \"key\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}        \"extend\": \{\u{a}            \"key\": \{\"type\": \"integer\", \"value\": \"2\"\},\u{a}            \"more\": \{\u{a}                \"key\": \{\"type\": \"integer\", \"value\": \"3\"\}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/whitespace" {
    expect(reads("[\"valid key\"]\u{a}", "\{\u{a}    \"valid key\": \{\}\u{a}\}\u{a}"))
}

test "valid/table/with-literal-string" {
    expect(reads("['a']\u{a}[a.'\"b\"']\u{a}[a.'\"b\"'.c]\u{a}answer = 42 \u{a}", "\{\u{a}    \"a\": \{\u{a}        \"\\\"b\\\"\": \{\u{a}            \"c\": \{\u{a}                \"answer\": \{\"type\": \"integer\", \"value\": \"42\"\}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/with-pound" {
    expect(reads("[\"key#group\"]\u{a}answer = 42\u{a}", "\{\u{a}    \"key#group\": \{\u{a}        \"answer\": \{\"type\": \"integer\", \"value\": \"42\"\}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/with-single-quotes" {
    expect(reads("['a']\u{a}[a.'b']\u{a}[a.'b'.c]\u{a}answer = 42 \u{a}", "\{\u{a}    \"a\": \{\u{a}        \"b\": \{\u{a}            \"c\": \{\u{a}                \"answer\": \{\"type\": \"integer\", \"value\": \"42\"\}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/without-super-with-values" {
    expect(reads("# [x] you\u{a}# [x.y] don't\u{a}# [x.y.z] need these\u{a}[x.y.z.w] # for this to work\u{a}a = 1\u{a}b = 2\u{a}[x] # defining a super-table afterwards is ok\u{a}c = 3\u{a}d = 4\u{a}", "\{\u{a}    \"x\": \{\u{a}        \"c\": \{\"type\": \"integer\", \"value\": \"3\"\},\u{a}        \"d\": \{\"type\": \"integer\", \"value\": \"4\"\},\u{a}        \"y\": \{\u{a}            \"z\": \{\u{a}                \"w\": \{\u{a}                    \"a\": \{\"type\": \"integer\", \"value\": \"1\"\},\u{a}                    \"b\": \{\"type\": \"integer\", \"value\": \"2\"\}\u{a}                \}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}

test "valid/table/without-super" {
    expect(reads("# [x] you\u{a}# [x.y] don't\u{a}# [x.y.z] need these\u{a}[x.y.z.w] # for this to work\u{a}[x] # defining a super-table afterwards is ok\u{a}", "\{\u{a}    \"x\": \{\u{a}        \"y\": \{\u{a}            \"z\": \{\u{a}                \"w\": \{\}\u{a}            \}\u{a}        \}\u{a}    \}\u{a}\}\u{a}"))
}
