}

test "invalid/table/array-implicit" {
    expect(rejects("# This test is a bit tricky. It should fail because the first use of\u{a}# `[[albums.songs]]` without first declaring `albums` implies that `albums`\u{a}# must be a table. The alternative would be quite weird. Namely, it wouldn't\u{a}# comply with the TOML spec: \"Each double-bracketed sub-table will belong to \u{a}# the most *recently* defined table element *above* it.\"\u{a}#\u{a}# This is in contrast to the *valid* test, table-array-implicit where\u{a}# `[[albums.songs]]` works by itself, so long as `[[albums]]` isn't declared\u{a}# later. (Although, `[albums]` could be.)\u{a}[[albums.songs]]\u{a}name = \"Glory Days\"\u{a}\u{a}[[albums]]\u{a}name = \"Born in the USA\"\u{a}"))
}

