test "invalid/table/append-with-dotted-keys-01" {
    expect(rejects("# First a.b.c defines a table: a.b.c = \{z=9\}\u{a}#\u{a}# Then we define a.b.c.t = \"str\" to add a str to the above table, making it:\u{a}#\u{a}#   a.b.c = \{z=9, t=\"...\"\}\u{a}#\u{a}# While this makes sense, logically, it was decided this is not valid TOML as\u{a}# it's too confusing/convoluted.\u{a}# \u{a}# See: https://github.com/toml-lang/toml/issues/846\u{a}#      https://github.com/toml-lang/toml/pull/859\u{a}\u{a}[a.b.c]\u{a}  z = 9\u{a}\u{a}[a]\u{a}  b.c.t = \"Using dotted keys to add to [a.b.c] after explicitly defining it above is not allowed\"\u{a}"))
}

test "invalid/table/append-with-dotted-keys-02" {
    expect(rejects("# This is the same issue as in injection-1.toml, except that nests one level\u{a}# deeper. See that file for a more complete description.\u{a}\u{a}[a.b.c.d]\u{a}  z = 9\u{a}\u{a}[a]\u{a}  b.c.d.k.t = \"Using dotted keys to add to [a.b.c.d] after explicitly defining it above is not allowed\"\u{a}"))
}

test "invalid/table/append-with-dotted-keys-03" {
    expect(rejects("[[a.b]]\u{a}\u{a}[a]\u{a}b.y = 2\u{a}"))
}

test "invalid/table/append-with-dotted-keys-04" {
    expect(rejects("[dependencies.foo]\u{a}version = \"0.16\"\u{a}\u{a}[dependencies]\u{a}libc = \"0.2\"\u{a}\u{a}[dependencies]\u{a}rand = \"0.3.14\"\u{a}"))
}

test "invalid/table/append-with-dotted-keys-05" {
    expect(rejects("a.b.c = 1\u{a}a.b = 2\u{a}"))
}

test "invalid/table/append-with-dotted-keys-06" {
    expect(rejects("a = 1\u{a}a.b = 2\u{a}"))
}

test "invalid/table/append-with-dotted-keys-07" {
    expect(rejects("a = \{k1 = 1, k1.name = \"joe\"\}\u{a}"))
}

test "invalid/table/append-with-dotted-keys-08" {
    expect(rejects("[a.b.c]\u{a}z = 9\u{a}\u{a}[[totally_unrelated]]\u{a}x = 123\u{a}\u{a}[a]\u{a}b.c.t = \"this should NOT be allowed\"\u{a}"))
}

