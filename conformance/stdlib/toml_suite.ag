test "invalid/inline-table/bad-key-syntax" {
    expect(rejects("tbl = \{ a = 1, [b] \}\u{a}"))
}

test "invalid/inline-table/double-comma" {
    expect(rejects("t = \{x=3,,y=4\}\u{a}"))
}

test "invalid/inline-table/duplicate-key-01" {
    expect(rejects("# Duplicate keys within an inline table are invalid\u{a}a=\{b=1, b=2\}\u{a}"))
}

test "invalid/inline-table/duplicate-key-02" {
    expect(rejects("table1 = \{ table2.dupe = 1, table2.dupe = 2 \}\u{a}"))
}

test "invalid/inline-table/duplicate-key-03" {
    expect(rejects("tbl = \{ fruit = \{ apple.color = \"red\" \}, fruit.apple.texture = \{ smooth = true \} \}\u{a}\u{a}"))
}

test "invalid/inline-table/duplicate-key-04" {
    expect(rejects("tbl = \{ a.b = \"a_b\", a.b.c = \"a_b_c\" \}\u{a}"))
}

test "invalid/inline-table/empty-01" {
    expect(rejects("t = \{,\}\u{a}"))
}

test "invalid/inline-table/empty-02" {
    expect(rejects("t = \{,\u{a}\}\u{a}"))
}

test "invalid/inline-table/empty-03" {
    expect(rejects("t = \{\u{a},\u{a}\}\u{a}"))
}

test "invalid/inline-table/no-close-01" {
    expect(rejects("a=\{\u{a}"))
}

test "invalid/inline-table/no-close-02" {
    expect(rejects("a=\{b=1\u{a}"))
}

test "invalid/inline-table/no-comma-01" {
    expect(rejects("t = \{x = 3 y = 4\}\u{a}"))
}

test "invalid/inline-table/no-comma-02" {
    expect(rejects("arrr = \{ comma-missing = true valid-toml = false \}\u{a}"))
}

test "invalid/inline-table/overwrite-01" {
    expect(rejects("a.b=0\u{a}# Since table \"a\" is already defined, it can't be replaced by an inline table.\u{a}a=\{\}\u{a}"))
}

test "invalid/inline-table/overwrite-02" {
    expect(rejects("a=\{\}\u{a}# Inline tables are immutable and can't be extended\u{a}[a.b]\u{a}"))
}

test "invalid/inline-table/overwrite-03" {
    expect(rejects("a = \{ b = 1 \}\u{a}a.b = 2\u{a}"))
}

test "invalid/inline-table/overwrite-04" {
    expect(rejects("inline-t = \{ nest = \{\} \}\u{a}\u{a}[[inline-t.nest]]\u{a}"))
}

test "invalid/inline-table/overwrite-05" {
    expect(rejects("inline-t = \{ nest = \{\} \}\u{a}\u{a}[inline-t.nest]\u{a}"))
}

test "invalid/inline-table/overwrite-06" {
    expect(rejects("a = \{ b = 1, b.c = 2 \}\u{a}"))
}

test "invalid/inline-table/overwrite-07" {
    expect(rejects("tab = \{ inner.table = [\{\}], inner.table.val = \"bad\" \}"))
}

test "invalid/inline-table/overwrite-08" {
    expect(rejects("tab = \{ inner = \{ dog = \"best\" \}, inner.cat = \"worst\" \}"))
}

test "invalid/inline-table/overwrite-09" {
    expect(rejects("[tab.nested]\u{a}inline-t = \{ nest = \{\} \}\u{a}\u{a}[tab]\u{a}nested.inline-t.nest = 2\u{a}"))
}

test "invalid/inline-table/overwrite-10" {
    expect(rejects("# Set implicit \"b\", overwrite \"b\" (illegal!) and then set another implicit.\u{a}#\u{a}# Caused panic: https://github.com/BurntSushi/toml/issues/403\u{a}a = \{b.a = 1, b = 2, b.c = 3\}\u{a}"))
}

