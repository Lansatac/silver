/// Writes conformance/stdlib/toml_suite.ag from toml-test's TOML 1.1 cases
/// (github.com/toml-lang/toml-test):
///
///     rdmd conformance/tools/toml_suite.d <toml-test checkout>
///
/// The cases are those tests/files-toml-1.1.0 lists. A valid case must parse to the value its .json
/// gives, which toml-test writes as JSON with each scalar a {"type": ..., "value": ...} object; the
/// generated file reads it with std.json and compares. An invalid case must be rejected: by parse,
/// or, when its bytes aren't UTF-8, by decode, since a String is always valid UTF-8 and parse never
/// sees them. `departures` lists the cases std.toml decides otherwise on purpose, with why.
module toml_suite;

import std.algorithm : endsWith, filter, map, sort, startsWith;
import std.array : array, split;
import std.stdio : stderr;
import std.string : strip;
import suites;

/// Cases std.toml decides otherwise on purpose, by whether it accepts them.
immutable bool[string] departures;

immutable helpers = q"SILVER

import std.json
import std.range
import std.string
import std.time
import std.toml

// The value toml-test's JSON gives, with each scalar written {"type": ..., "value": ...}.
def expected(json: Json): Toml? {
    if val members = json.asObject() {
        if length(members) == 2 {
            if val kind = json["type"].asString() {
                if val text = json["value"].asString() {
                    return scalar(kind, text)
                }
            }
        }
        mutable val table: [String: Toml] = [:]
        for (key, member) in members {
            table[key] = expected(member)?
        }
        return table
    }
    if val items = json.asArray() {
        mutable val array: [Toml] = []
        for item in items {
            array ~= [expected(item)?]
        }
        return array
    }
    None
}

def scalar(kind: String, text: String): Toml? {
    val zero = 0.0
    if kind == "string" => text
    else if kind == "integer" => parseInt(text)?
    else if kind == "float" => if text == "nan" => zero / zero else if text == "inf" => 1.0 / zero else if text == "-inf" => -1.0 / zero else parseFloat(text)?
    else if kind == "bool" => text == "true"
    else if kind == "datetime" => parseOffsetDateTime(text)?
    else if kind == "datetime-local" => parseDateTime(text)?
    else if kind == "date-local" => parseDate(text)?
    else if kind == "time-local" => parseTime(text)?
    else None
}

// Whether two values are the same, a table's keys in any order, and a Float by how it prints, so
// that NaN is the same as NaN and -0.0 isn't 0.0.
def same(a: Toml, b: Toml): Bool => match a {
    x: Float => match b {
        y: Float => String(x) == String(y)
        _ => false
    }
    items: [Toml] => match b {
        others: [Toml] => length(items) == length(others) && (0..length(items)).all((i) => same(items[i], others[i]))
        _ => false
    }
    table: [String: Toml] => match b {
        other: [String: Toml] => length(table) == length(other) && keys(table).all((k) => if val v = other[k] => same(table[k]!, v) else false)
        _ => false
    }
    _ => a == b
}

def reads(text: String, json: String): Bool {
    val want = expected(std.json.parse(json)!)!
    if val got = std.toml.parse(text) {
        return same(got, want)
    }
    false
}

def rejects(text: String): Bool => match std.toml.parse(text) {
    Ok(_) => false
    Error(_) => true
}
SILVER";

int main(string[] args)
{
    if (args.length != 2)
    {
        stderr.writeln("usage: rdmd conformance/tools/toml_suite.d <toml-test checkout>");
        return 2;
    }
    auto c = committed(args[1]);
    auto files = (cast(string) c.files["tests/files-toml-1.1.0"]).split('\n')
        .map!(line => line.strip)
        .filter!(line => line.endsWith(".toml"))
        .array
        .sort
        .array;
    string[] out_ = ["// Generated by toml_suite.d from toml-test at " ~ c.commit ~ ", its TOML 1.1 cases. Don't edit it by hand.", "//"];
    out_ ~= licenseComment(c.files["LICENSE"]);
    out_ ~= helpers.split('\n');
    foreach (path; files)
    {
        auto name = path[0 .. $ - ".toml".length];
        auto data = c.files["tests/" ~ path];
        immutable valid = name.startsWith("valid/");
        auto departure = name in departures;
        immutable accept = departure ? *departure : valid;
        auto text = utf8(data);
        out_ ~= `test "` ~ name ~ `" {`;
        if (text is null)
        {
            if (valid)
            {
                stderr.writeln(name, " must parse but isn't UTF-8");
                return 1;
            }
            out_ ~= "    expect(decode([" ~ byteList(data) ~ "]) == None)";
        }
        else if (accept)
        {
            auto json = utf8(c.files["tests/" ~ name ~ ".json"]);
            out_ ~= "    expect(reads(" ~ silverString(text) ~ ", " ~ silverString(json) ~ "))";
        }
        else
        {
            out_ ~= "    expect(rejects(" ~ silverString(text) ~ "))";
        }
        out_ ~= "}";
        out_ ~= "";
    }
    writeSuite(__FILE_FULL_PATH__, "toml_suite.ag", out_, files.length);
    return 0;
}
