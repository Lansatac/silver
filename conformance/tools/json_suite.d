/// Writes conformance/stdlib/json_suite.ag from JSONTestSuite's parsing cases
/// (github.com/nst/JSONTestSuite):
///
///     rdmd conformance/tools/json_suite.d <JSONTestSuite checkout>
///
/// A y_ case must parse, and write back to text that parses to the same value. An n_ case must be
/// rejected: by parse, or, when its bytes aren't UTF-8, by decode, since a String is always valid
/// UTF-8 and parse never sees them. An i_ case may go either way, and `undecided` below says which
/// way std.json goes and why, so a change to one is a decision rather than an accident.
/// `departures` lists the y_ cases std.json rejects on purpose.
module json_suite;

import std.algorithm : endsWith, filter, map, sort, startsWith;
import std.array : array, join;
import std.stdio : stderr;
import suites;

/// The i_ cases, by whether std.json accepts them.
immutable bool[string] undecided;

/// y_ cases std.json rejects on purpose. RFC 8259's grammar allows a key named twice and says only
/// that names SHOULD be unique; std.json rejects them, as I-JSON (RFC 7493) does, since parsers that
/// disagree about which value wins have been a security problem.
immutable bool[string] departures;

shared static this()
{
    undecided = [
        // Numbers: an Int must fit, and a Float too large for one is an error; one too small is zero.
        "i_number_double_huge_neg_exp": true,
        "i_number_huge_exp": false,
        "i_number_neg_int_huge_exp": false,
        "i_number_pos_double_huge_exp": false,
        "i_number_real_neg_overflow": false,
        "i_number_real_pos_overflow": false,
        "i_number_real_underflow": true,
        "i_number_too_big_neg_int": false,
        "i_number_too_big_pos_int": false,
        "i_number_very_big_negative_int": false,
        // Half of a surrogate pair can't be in a String.
        "i_object_key_lone_2nd_surrogate": false,
        "i_string_1st_surrogate_but_2nd_missing": false,
        "i_string_1st_valid_surrogate_2nd_invalid": false,
        "i_string_incomplete_surrogate_and_escape_valid": false,
        "i_string_incomplete_surrogate_pair": false,
        "i_string_incomplete_surrogates_escape_valid": false,
        "i_string_invalid_lonely_surrogate": false,
        "i_string_invalid_surrogate": false,
        "i_string_inverted_surrogates_U+1D11E": false,
        "i_string_lone_second_surrogate": false,
        // A byte-order mark isn't white space, so a document can't start with one.
        "i_structure_UTF-8_BOM_empty_object": false,
        // 500 is within the limit of 512.
        "i_structure_500_nested_arrays": true,
    ];
    departures = [
        "y_object_duplicated_key": false,
        "y_object_duplicated_key_and_value": false,
    ];
}

immutable helpers = q"SILVER

import std.json
import std.range
import std.string

// It parses, and what it parses to writes back as text that parses to the same value.
def accepts(text: String): Bool {
    if val value = parse(text) {
        if val written = write(value) {
            return parse(written) == Ok(value)
        }
    }
    false
}

def rejects(text: String): Bool => match parse(text) {
    Ok(_) => false
    Error(_) => true
}
SILVER";

int main(string[] args)
{
    if (args.length != 2)
    {
        stderr.writeln("usage: rdmd conformance/tools/json_suite.d <JSONTestSuite checkout>");
        return 2;
    }
    auto c = committed(args[1]);
    enum prefix = "test_parsing/", suffix = ".json";
    auto names = c.files.keys
        .filter!(p => p.startsWith(prefix) && p.endsWith(suffix))
        .map!(p => p[prefix.length .. $ - suffix.length])
        .array
        .sort
        .array;
    string[] out_ = ["// Generated by json_suite.d from JSONTestSuite at " ~ c.commit ~ ". Don't edit it by hand.", "//"];
    out_ ~= licenseComment(c.files["LICENSE"]);
    out_ ~= helpers;
    string[] unknown;
    foreach (name; names)
    {
        auto data = c.files[prefix ~ name ~ suffix];
        immutable kind = name[0 .. 2];
        auto text = utf8(data);
        out_ ~= `test "` ~ name ~ `" {`;
        if (text is null)
        {
            if (kind == "y_")
            {
                stderr.writeln(name, " must parse but isn't UTF-8");
                return 1;
            }
            out_ ~= "    expect(decode([" ~ byteList(data) ~ "]) == None)";
        }
        else
        {
            bool accept;
            if (auto d = name in departures) accept = *d;
            else if (kind == "y_") accept = true;
            else if (kind == "n_") accept = false;
            else if (auto u = name in undecided) accept = *u;
            else unknown ~= name;
            out_ ~= "    expect(" ~ (accept ? "accepts" : "rejects") ~ "(" ~ silverString(text) ~ "))";
        }
        out_ ~= "}";
        out_ ~= "";
    }
    if (unknown.length)
    {
        stderr.writeln("no decision for: ", unknown.join(", "));
        return 1;
    }
    writeSuite(__FILE_FULL_PATH__, "json_suite.ag", out_, names.length);
    return 0;
}
