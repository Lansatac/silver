def length(r: Interval<UInt>): Int => if r.from < r.to => Int(r.to - r.from) else 0
def opIndex(r: Interval<UInt>, index: Int): UInt {
    if index < 0 || index >= length(r) {
        panic("Index is out of range")
    }
    r.from + UInt(index)
}
private def holds(r: Interval<UInt>, count: Int): Bool =>
    if r.from >= r.to => count == 0 else UInt(count) <= r.to - r.from
def opIndex(r: Interval<UInt>, part: Interval<Int>): Interval<UInt> {
    if part.from < 0 || part.from > part.to || !holds(r, part.to) {
        panic("Slice is out of range")
    }
    Interval(r.from + UInt(part.from), r.from + UInt(part.to))
}
def next(r: Interval<UInt>): (UInt, Interval<UInt>)? => if r.from < r.to => (r.from, r with (from = r.from + 1)) else None
def nextBack(r: Interval<UInt>): (UInt, Interval<UInt>)? => if r.from < r.to => (r.to - 1, r with (to = r.to - 1)) else None
def contains(r: Interval<UInt>, value: UInt): Bool => value >= r.from && value < r.to
