module intrinsics.interval


// What `a..b` builds outside a slice or a `for`: the integers from `from` up to but not including
// `to`, none when `from` isn't below `to`. The compiler finds this type here by name.
type Interval<T>(from: T, to: T)
// `values[r]`, and `values[a..b]` where a function is wanted, which panics as that slice does.
def opIndex<T>(values: [T], r: Interval<Int>): [T] => values[r.from..r.to]
// An interval's functions, once for each integer type, since a bound can't ask for an integer yet.
// `holds(r, n)` says whether `r` has at least `n` integers without needing `length(r)` to fit an `Int`.
def length(r: Interval<Int>): Int => if r.from < r.to => r.to - r.from else 0
def opIndex(r: Interval<Int>, index: Int): Int {
    if index < 0 || index >= length(r) {
        panic("Index is out of range")
    }
    r.from + index
}
private def holds(r: Interval<Int>, count: Int): Bool =>
    if r.from >= r.to => count == 0 else if r.from < 0 => r.from + count <= r.to else count <= r.to - r.from
def opIndex(r: Interval<Int>, part: Interval<Int>): Interval<Int> {
    if part.from < 0 || part.from > part.to || !holds(r, part.to) {
        panic("Slice is out of range")
    }
    Interval(r.from + part.from, r.from + part.to)
}
def next(r: Interval<Int>): (Int, Interval<Int>)? => if r.from < r.to => (r.from, r with (from = r.from + 1)) else None
def nextBack(r: Interval<Int>): (Int, Interval<Int>)? => if r.from < r.to => (r.to - 1, r with (to = r.to - 1)) else None
def contains(r: Interval<Int>, value: Int): Bool => value >= r.from && value < r.to
def length(r: Interval<Int8>): Int => if r.from < r.to => Int(r.to) - Int(r.from) else 0
def opIndex(r: Interval<Int8>, index: Int): Int8 {
    if index < 0 || index >= length(r) {
        panic("Index is out of range")
    }
    Int8(Int(r.from) + index)
}
private def holds(r: Interval<Int8>, count: Int): Bool =>
    count <= length(r)
def opIndex(r: Interval<Int8>, part: Interval<Int>): Interval<Int8> {
    if part.from < 0 || part.from > part.to || !holds(r, part.to) {
        panic("Slice is out of range")
    }
    Interval(Int8(Int(r.from) + part.from), Int8(Int(r.from) + part.to))
}
def next(r: Interval<Int8>): (Int8, Interval<Int8>)? => if r.from < r.to => (r.from, r with (from = r.from + 1)) else None
def nextBack(r: Interval<Int8>): (Int8, Interval<Int8>)? => if r.from < r.to => (r.to - 1, r with (to = r.to - 1)) else None
def contains(r: Interval<Int8>, value: Int8): Bool => value >= r.from && value < r.to
