module lang.range

import lang.array
import lang.interval
import lang.string

// What `for` loops over: something that gives its first item and the rest, until it gives `None`.
interface Range<T> {
    def next(range: Self): (T, Self)?
}

// A collection that isn't a range itself, and the range that steps it, which `for` loops over.
interface Iterable<R> {
    def iterate(value: Self): R
}

conform [T]: Range<T>
conform String: Range<Char>
conform Interval<Int>: Range<Int>
conform Interval<Int8>: Range<Int8>
conform Interval<Int16>: Range<Int16>
conform Interval<Int32>: Range<Int32>
conform Interval<UInt>: Range<UInt>
conform Interval<UInt8>: Range<UInt8>
conform Interval<UInt16>: Range<UInt16>
conform Interval<UInt32>: Range<UInt32>
