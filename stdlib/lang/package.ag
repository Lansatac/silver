// The package the compiler knows. Every module sees what this one forwards without an import,
// whatever its prelude.
module lang

forward import lang.array
forward import lang.dictionary : Dictionary, contains, length, isEmpty, without, update, keys, values, dictionary,
    iterate, next, opIndex, opIndexAssign
forward import lang.interval
forward import lang.io
forward import lang.ord
forward import lang.panic
forward import lang.range
forward import lang.string : bytes, next
forward import lang.testing
