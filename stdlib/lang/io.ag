module lang.io

intrinsic def print(value: Any): Unit
intrinsic def printl(value: Any): Unit
def printl(): Unit {
    printl("")
}

// What can go wrong reading or writing outside the program. A function returns only the members
// it can produce, which `?` widens into this.
type IoError = NotUtf8 | NotFound(path: String) | ReadFailed(path: String, reason: String)
    | WriteFailed(path: String, reason: String) | InputFailed(reason: String)

// Each member prints as a message, whatever it's held as: itself, IoError, or a list of errors.
def opString(error: NotUtf8): String => "the text isn't UTF-8"
def opString(error: NotFound): String => "{error.path} wasn't found"
def opString(error: ReadFailed): String => "couldn't read {error.path}: {error.reason}"
def opString(error: WriteFailed): String => "couldn't write {error.path}: {error.reason}"
def opString(error: InputFailed): String => "couldn't read input: {error.reason}"

// Reads a line from input without its `\n` or `\r\n`, or `None` at the end of input. A line that
// isn't UTF-8 is consumed, so the next read continues after it.
def read(): String? ! NotUtf8 | InputFailed {
    val (status, text) = readLine()
    if status == 0 => Some(text)
    else if status == 1 => None
    else if status == 2 => Error(NotUtf8)
    else Error(InputFailed(text))
}

// 0 and the line, 1 at the end of input, 2 for a line that isn't UTF-8, or 3 and the OS's message.
private intrinsic def readLine(): (Int32, String)
