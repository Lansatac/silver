// Asking about a String's contents and cutting one apart. A String is cut by value, never by
// position: every piece handed back begins and ends between characters.
//
// The questions compare bytes, which for UTF-8 gives the same answer as comparing characters. The
// empty string is found in every string, at both ends.
module std.string

import std.char
// Every slice below cuts a String where another String matched or where a character ended.
import lang.string : slice
// `decode(data)`, `data` as a String, or `None` if it isn't UTF-8.
forward import lang.string : decode

def isEmpty(text: String): Bool => length(bytes(text)) == 0

// Whether `part` appears somewhere in `text`.
def contains(text: String, part: String): Bool => find(bytes(text), bytes(part)) != None

// Whether `text` begins with `prefix`.
def startsWith(text: String, prefix: String): Bool {
    val data = bytes(text)
    val part = bytes(prefix)
    length(part) <= length(data) && matchesAt(data, part, 0)
}

// Whether `text` finishes with `suffix`.
def endsWith(text: String, suffix: String): Bool {
    val data = bytes(text)
    val part = bytes(suffix)
    length(part) <= length(data) && matchesAt(data, part, length(data) - length(part))
}

// `text` without `prefix` at its beginning, or `None` if it doesn't begin with it.
def stripPrefix(text: String, prefix: String): String? {
    if !startsWith(text, prefix) {
        return None
    }
    slice(text, length(bytes(prefix)), length(bytes(text)))
}

// `text` without `suffix` at its end, or `None` if it doesn't end with it.
def stripSuffix(text: String, suffix: String): String? {
    if !endsWith(text, suffix) {
        return None
    }
    val data = bytes(text)
    slice(text, 0, length(data) - length(bytes(suffix)))
}

// What comes before and after the first `separator` in `text`, or `None` if it isn't there.
def splitOnce(text: String, separator: String): (String, String)? {
    val data = bytes(text)
    val at = find(data, bytes(separator))?
    (slice(text, 0, at), slice(text, at + length(bytes(separator)), length(data)))
}

// The characters at the beginning of `text` that `keep` accepts, and everything after them.
def splitWhile(text: String, keep: (Char) -> Bool): (String, String) {
    mutable val rest = text
    while val step = next(rest) {
        val (c, after) = step
        if !keep(c) {
            break
        }
        rest = after
    }
    val data = bytes(text)
    (slice(text, 0, length(data) - length(bytes(rest))), rest)
}

// `text` without the white space at its beginning.
def trimStart(text: String): String {
    val (_, rest) = splitWhile(text, isWhitespace)
    rest
}

// `text` without the white space at its end.
def trimEnd(text: String): String {
    val data = bytes(text)
    mutable val end = length(data)
    while end > 0 {
        // A character's first byte is the only one that isn't `10xxxxxx`.
        mutable val start = end - 1
        while start > 0 && (data[start] & 0xC0) == 0x80 {
            start -= 1
        }
        if !isBlank(slice(text, start, end)) {
            break
        }
        end = start
    }
    slice(text, 0, end)
}

// `text` without the white space at either end.
def trim(text: String): String => trimEnd(trimStart(text))

// The pieces of `text` between each `separator`, so there's one more piece than there are
// separators, and some may be empty. An empty separator gives each character as its own piece.
def split(text: String, separator: String): [String] {
    mutable val pieces: [String] = []
    if isEmpty(separator) {
        for c in text {
            pieces ~= [String(c)]
        }
        return pieces
    }
    mutable val rest = text
    while val cut = splitOnce(rest, separator) {
        val (before, after) = cut
        pieces ~= [before]
        rest = after
    }
    pieces ~ [rest]
}

// The lines of `text`, without the `\n` or `\r\n` that ends each. A final line needs no ending,
// and one after the last ending isn't a line: `"a\n"` is one line.
def lines(text: String): [String] {
    mutable val found: [String] = []
    mutable val rest = text
    while !isEmpty(rest) {
        val (line, after) = splitOnce(rest, "\n") ?? (rest, "")
        found ~= [stripSuffix(line, "\r") ?? line]
        rest = after
    }
    found
}

// The Int that `text` writes in decimal: digits `0` to `9`, with `-` before them for a negative
// number. `None` for anything else, an empty string and a number too large for an Int included.
def parseInt(text: String): Int? {
    val data = bytes(text)
    val negative = length(data) > 0 && data[0] == 45
    mutable val i = if negative => 1 else 0
    if i == length(data) {
        return None
    }
    // Counted downwards, since the most negative Int has no positive twin.
    val lowest = -9223372036854775808
    mutable val value = 0
    while i < length(data) {
        val digit = Int(data[i]) - 48
        if digit < 0 || digit > 9 || value < (lowest + digit) / 10 {
            return None
        }
        value = value * 10 - digit
        i += 1
    }
    if negative {
        return value
    }
    if value == lowest {
        return None
    }
    -value
}

// `true` for the text `true` and `false` for `false`, the two ways a Bool is written, in capitals
// or not: `True` and `FALSE` are read too. `None` for anything else.
def parseBool(text: String): Bool? {
    if isWord(text, "true") {
        return true
    }
    if isWord(text, "false") {
        return false
    }
    None
}

// Whether `text` is `word`, which is in lower case, with any of its letters `A` to `Z` in capitals.
private def isWord(text: String, word: String): Bool {
    val data = bytes(text)
    val wanted = bytes(word)
    if length(data) != length(wanted) {
        return false
    }
    mutable val i = 0
    while i < length(data) {
        val lowered = if data[i] >= 65 && data[i] <= 90 => data[i] + 32 else data[i]
        if lowered != wanted[i] {
            return false
        }
        i += 1
    }
    true
}

// The Float nearest the decimal number `text` writes: digits with an optional `.` among them,
// before them or after them, then optionally `e` or `E`, a sign and digits, with `-` before it all
// for a negative number. `None` for anything else, and for a number too large for a Float. One too
// small to tell from zero is zero.
def parseFloat(text: String): Float? {
    val data = bytes(text)
    val count = length(data)
    val negative = count > 0 && data[0] == 45
    val first = if negative => 1 else 0
    mutable val i = first
    while i < count && isDigitByte(data[i]) {
        i += 1
    }
    val wholeDigits = i - first
    mutable val fractionDigits = 0
    if i < count && data[i] == 46 {
        val fraction = i + 1
        i = fraction
        while i < count && isDigitByte(data[i]) {
            i += 1
        }
        fractionDigits = i - fraction
    }
    if wholeDigits + fractionDigits == 0 {
        return None
    }
    val digitsEnd = i
    mutable val exponent = 0
    if i < count && (data[i] == 101 || data[i] == 69) {
        i += 1
        val down = i < count && data[i] == 45
        if down || (i < count && data[i] == 43) {
            i += 1
        }
        val written = i
        while i < count && isDigitByte(data[i]) {
            // Past this the number is zero or too large whatever the digits say.
            if exponent < 100000000 {
                exponent = exponent * 10 + Int(data[i]) - 48
            }
            i += 1
        }
        if i == written {
            return None
        }
        if down {
            exponent = -exponent
        }
    }
    if i != count {
        return None
    }
    exponent -= fractionDigits

    // The digits from the first that isn't zero, as an Int while they fit one.
    mutable val significant = 0
    mutable val small = 0
    i = first
    while i < digitsEnd {
        if data[i] != 46 && (significant > 0 || data[i] != 48) {
            significant += 1
            if significant <= 18 {
                small = small * 10 + Int(data[i]) - 48
            }
        }
        i += 1
    }
    if significant == 0 || significant + exponent < -330 {
        return if negative => -0.0 else 0.0
    }
    if significant + exponent > 310 {
        return None
    }

    // Up to 15 digits and a power of ten up to 22 are each exactly a Float, so one multiplication
    // or division rounds once, which is the nearest.
    if significant <= 15 && exponent >= -22 && exponent <= 22 {
        mutable val power = 1.0
        mutable val left = if exponent < 0 => -exponent else exponent
        while left > 0 {
            power *= 10.0
            left -= 1
        }
        val value = if exponent < 0 => Float(small) / power else Float(small) * power
        return if negative => -value else value
    }

    mutable val digits: [Int] = []
    i = first
    while i < digitsEnd {
        if data[i] != 46 {
            digits = bigTimesPlus(digits, 10, Int(data[i]) - 48)
        }
        i += 1
    }
    val value = nearestFloat(digits, exponent) ?? return None
    if negative => -value else value
}

private def isDigitByte(byte: UInt8): Bool => byte >= 48 && byte <= 57

// The Float nearest `digits * 10^exponent`, ties going to the even one, for `digits` above zero.
// `None` when it's too large.
private def nearestFloat(digits: [Int], exponent: Int): Float? {
    val above = if exponent > 0 => bigTimesTenTo(digits, exponent) else digits
    val below = if exponent < 0 => bigTimesTenTo([1], -exponent) else [1]
    // The quotient of the two, scaled by 2^shift to have 55 or 56 bits: the 53 a Float keeps and
    // at least two to round by.
    val shift = 55 - (bigBits(above) - bigBits(below))
    mutable val rest = if shift > 0 => bigShiftLeft(above, shift) else above
    mutable val step = bigShiftLeft(below, 55 + (if shift < 0 => -shift else 0))
    mutable val quotient = 0
    mutable val bit = 55
    while bit >= 0 {
        if bigAtLeast(rest, step) {
            rest = bigMinus(rest, step)
            quotient |= 1 << bit
        }
        step = bigHalf(step)
        bit -= 1
    }
    val inexact = length(rest) > 0
    val bits = if (quotient >> 55) > 0 => 56 else 55
    // The power of two of the number's highest bit.
    val top = bits - 1 - shift
    if top > 1024 {
        return None
    }
    // Below 2^-1022 a Float keeps fewer bits, down to one at 2^-1074.
    val kept = if top >= -1022 => 53 else top + 1075
    if kept < 0 {
        return 0.0
    }
    val dropped = bits - kept
    mutable val mantissa = quotient >> dropped
    val half = ((quotient >> (dropped - 1)) & 1) == 1
    val more = (quotient & ((1 << (dropped - 1)) - 1)) != 0 || inexact
    if half && (more || (mantissa & 1) == 1) {
        mantissa += 1
    }
    val value = timesTwoTo(Float(mantissa), dropped - shift)
    if value > 1.7976931348623157e308 {
        return None
    }
    value
}

// `x * 2^power`, exactly when that is a Float, since each step is.
private def timesTwoTo(x: Float, power: Int): Float {
    val sixty = 1152921504606846976.0
    mutable val value = x
    mutable val left = power
    while left >= 60 {
        value *= sixty
        left -= 60
    }
    while left > 0 {
        value *= 2.0
        left -= 1
    }
    while left <= -60 {
        value /= sixty
        left += 60
    }
    while left < 0 {
        value /= 2.0
        left += 1
    }
    value
}

// A whole number of any size, for `parseFloat`: 32 bits to an element, the lowest first, and no
// zero as the last. Each of these builds its answer by appending, since assigning an element
// copies the array.

// `n * factor + add`, for a `factor` up to 2^30 and an `add` below 2^32.
private def bigTimesPlus(n: [Int], factor: Int, add: Int): [Int] {
    mutable val result: [Int] = []
    mutable val carry = add
    for part in n {
        val value = part * factor + carry
        result ~= [value & 4294967295]
        carry = value >> 32
    }
    if carry > 0 {
        result ~= [carry]
    }
    result
}

private def bigTimesTenTo(n: [Int], power: Int): [Int] {
    mutable val result = n
    mutable val left = power
    while left >= 9 {
        result = bigTimesPlus(result, 1000000000, 0)
        left -= 9
    }
    while left > 0 {
        result = bigTimesPlus(result, 10, 0)
        left -= 1
    }
    result
}

// How many bits `n` takes to write.
private def bigBits(n: [Int]): Int {
    if length(n) == 0 {
        return 0
    }
    mutable val bits = (length(n) - 1) * 32
    mutable val top = n[length(n) - 1]
    while top > 0 {
        bits += 1
        top >>= 1
    }
    bits
}

private def bigShiftLeft(n: [Int], bits: Int): [Int] {
    if length(n) == 0 {
        return n
    }
    mutable val result: [Int] = []
    mutable val whole = bits / 32
    while whole > 0 {
        result ~= [0]
        whole -= 1
    }
    val within = bits % 32
    mutable val carry = 0
    for part in n {
        val value = (part << within) | carry
        result ~= [value & 4294967295]
        carry = value >> 32
    }
    if carry > 0 {
        result ~= [carry]
    }
    result
}

private def bigHalf(n: [Int]): [Int] {
    mutable val result: [Int] = []
    val count = length(n)
    mutable val i = 0
    while i < count {
        val above = if i + 1 < count => n[i + 1] & 1 else 0
        val part = (n[i] >> 1) | (above << 31)
        if i + 1 < count || part > 0 {
            result ~= [part]
        }
        i += 1
    }
    result
}

private def bigAtLeast(a: [Int], b: [Int]): Bool {
    if length(a) != length(b) {
        return length(a) > length(b)
    }
    mutable val i = length(a) - 1
    while i >= 0 {
        if a[i] != b[i] {
            return a[i] > b[i]
        }
        i -= 1
    }
    true
}

// `a - b`, for an `a` that's at least `b`.
private def bigMinus(a: [Int], b: [Int]): [Int] {
    mutable val result: [Int] = []
    mutable val borrow = 0
    mutable val used = 0
    mutable val i = 0
    while i < length(a) {
        mutable val part = a[i] - borrow - (if i < length(b) => b[i] else 0)
        borrow = 0
        if part < 0 {
            part += 4294967296
            borrow = 1
        }
        result ~= [part]
        if part > 0 {
            used = i + 1
        }
        i += 1
    }
    result[..used]
}

// Where `part` first appears in `data`, as a count of bytes before it.
private def find(data: [UInt8], part: [UInt8]): Int? {
    mutable val start = 0
    while start + length(part) <= length(data) {
        if matchesAt(data, part, start) {
            return start
        }
        start += 1
    }
    None
}

// Whether `part` is in `data` at `start`, which leaves room for it.
private def matchesAt(data: [UInt8], part: [UInt8], start: Int): Bool {
    mutable val i = 0
    while i < length(part) {
        if data[start + i] != part[i] {
            return false
        }
        i += 1
    }
    true
}

// Whether `text`, which is one character, is white space.
private def isBlank(text: String): Bool {
    if val step = next(text) {
        val (c, _) = step
        return isWhitespace(c)
    }
    false
}

def join(parts: Range<String>, separator: String): String {
    mutable val result = ""
    mutable val first = true
    for part in parts {
        if !first { result ~= separator }
        result ~= part
        first = false
    }
    result
}

test "join joins strings with separator" {
    expect(join(["a", "b", "c"], ", ") == "a, b, c")
    expect(join(["a", "b", "c"], "") == "abc")
    val none: [String] = []
    expect(join(none, ", ") == "")
    expect([1, 2, 3].map(n => "{n}").join("+") == "1+2+3")
}

test "contains finds a part anywhere" {
    expect(contains("silver", "sil"))
    expect(contains("silver", "lve"))
    expect(contains("silver", "ver"))
    expect(contains("silver", "silver"))
    expect("silver".contains("r"))
}

test "contains rejects what isn't there" {
    expect(!contains("silver", "gold"))
    expect(!contains("silver", "silvers"))
    expect(!contains("silver", "sv"))
    expect(!contains("silver", "Silver"))
    expect(!contains("", "a"))
}

test "contains matches after a partial match" {
    expect(contains("aaab", "aab"))
    expect(contains("abababc", "ababc"))
    expect(!contains("ababab", "ababc"))
}

test "startsWith looks only at the beginning" {
    expect(startsWith("silver", "sil"))
    expect(startsWith("silver", "silver"))
    expect("silver".startsWith("s"))
    expect(!startsWith("silver", "ilv"))
    expect(!startsWith("silver", "ver"))
    expect(!startsWith("sil", "silver"))
    expect(!startsWith("", "a"))
}

test "endsWith looks only at the end" {
    expect(endsWith("silver", "ver"))
    expect(endsWith("silver", "silver"))
    expect("silver".endsWith("r"))
    expect(!endsWith("silver", "lve"))
    expect(!endsWith("silver", "sil"))
    expect(!endsWith("ver", "silver"))
    expect(!endsWith("", "a"))
}

test "the empty string is in every string" {
    expect(contains("silver", ""))
    expect(startsWith("silver", ""))
    expect(endsWith("silver", ""))
    expect(contains("", ""))
    expect(startsWith("", ""))
    expect(endsWith("", ""))
}

test "text beyond ASCII matches by whole characters" {
    val text = "caf\u{e9} cr\u{e8}me \u{1f600}"
    expect(contains(text, "\u{e9} cr"))
    expect(startsWith(text, "caf\u{e9}"))
    expect(endsWith(text, "\u{1f600}"))
    expect(!contains(text, "\u{ea}"))
    expect(!endsWith(text, "\u{1f601}"))
}

test "a NUL byte doesn't end a string" {
    val text = "left\0right"
    expect(contains(text, "\0r"))
    expect(endsWith(text, "right"))
    expect(!endsWith("left\0", "left"))
    expect(startsWith(text, "left\0"))
}

test "strings built at runtime are searched like literals" {
    val name = "report"
    val path = "docs/" ~ name ~ ".txt"
    expect(path.startsWith("docs/"))
    expect(path.endsWith(".txt"))
    expect(path.contains("/{name}."))
}

test "each question works as a function value" {
    val checks: [(String, String) -> Bool] = [contains, startsWith, endsWith]
    mutable val passed = 0
    for check in checks {
        if check("aba", "a") {
            passed += 1
        }
    }
    expect(passed == 3)
}

test "isEmpty is true only of the empty string" {
    expect(isEmpty(""))
    expect(!isEmpty(" "))
    expect(!isEmpty("\0"))
}

test "stripPrefix and stripSuffix take a matching end off" {
    expect(stripPrefix("v1.2", "v") == Some("1.2"))
    expect(stripPrefix("v1.2", "x") == None)
    expect(stripPrefix("v1.2", "") == Some("v1.2"))
    expect(stripPrefix("v", "v") == Some(""))
    expect(stripPrefix("\u{e9}t\u{e9}", "\u{e9}") == Some("t\u{e9}"))
    expect(stripSuffix("notes.txt", ".txt") == Some("notes"))
    expect(stripSuffix("notes.txt", ".md") == None)
    expect(stripSuffix("notes.txt", "") == Some("notes.txt"))
    expect(stripSuffix("\u{e9}t\u{e9}", "\u{e9}") == Some("\u{e9}t"))
}

test "splitOnce cuts at the first separator" {
    expect(splitOnce("key=value", "=") == Some(("key", "value")))
    expect(splitOnce("a=b=c", "=") == Some(("a", "b=c")))
    expect(splitOnce("=x", "=") == Some(("", "x")))
    expect(splitOnce("x=", "=") == Some(("x", "")))
    expect(splitOnce("a -> b", " -> ") == Some(("a", "b")))
    expect(splitOnce("na\u{ef}ve", "\u{ef}") == Some(("na", "ve")))
    expect(splitOnce("plain", "=") == None)
    expect(splitOnce("", "=") == None)
    expect(splitOnce("abc", "") == Some(("", "abc")))
}

test "splitWhile keeps the characters accepted at the beginning" {
    expect(splitWhile("42abc", isDigit) == ("42", "abc"))
    expect(splitWhile("abc", isDigit) == ("", "abc"))
    expect(splitWhile("123", isDigit) == ("123", ""))
    expect(splitWhile("", isDigit) == ("", ""))
    expect(splitWhile("12a34", isDigit) == ("12", "a34"))
    expect(splitWhile("\u{e9}\u{e9}x\u{e9}", c => c == '\u{e9}') == ("\u{e9}\u{e9}", "x\u{e9}"))
}

test "trimming removes white space at the ends only" {
    expect(trim("  hi  ") == "hi")
    expect(trim("\t\n hi there \r\n") == "hi there")
    expect(trim("hi") == "hi")
    expect(trim("") == "")
    expect(trim("   ") == "")
    expect(trimStart("  hi  ") == "hi  ")
    expect(trimEnd("  hi  ") == "  hi")
    expect(trimEnd("   ") == "")
}

test "trimming knows white space beyond ASCII" {
    expect(trim("\u{a0}\u{3000}caf\u{e9}\u{2003}\u{a0}") == "caf\u{e9}")
    expect(trimEnd("caf\u{e9}") == "caf\u{e9}")
    expect(trimEnd("\u{1f600} ") == "\u{1f600}")
    // A zero-width space isn't white space.
    expect(trim("\u{200b}a\u{200b}") == "\u{200b}a\u{200b}")
}

test "split gives the pieces between separators" {
    expect(split("a,b,c", ",") == ["a", "b", "c"])
    expect(split("a,,c", ",") == ["a", "", "c"])
    expect(split(",a,", ",") == ["", "a", ""])
    expect(split("abc", ",") == ["abc"])
    expect(split("", ",") == [""])
    expect(split("a, b, c", ", ") == ["a", "b", "c"])
    expect(split("aXXbXXXc", "XX") == ["a", "b", "Xc"])
}

test "split on an empty separator gives each character" {
    expect(split("a\u{e9}\u{1f600}", "") == ["a", "\u{e9}", "\u{1f600}"])
    expect(length(split("", "")) == 0)
}

test "lines ends each line at a newline" {
    expect(lines("one\ntwo\nthree") == ["one", "two", "three"])
    expect(lines("one\ntwo\n") == ["one", "two"])
    expect(lines("one\r\ntwo\r\n") == ["one", "two"])
    expect(lines("one\n\ntwo") == ["one", "", "two"])
    expect(lines("\n") == [""])
    expect(lines("one") == ["one"])
    expect(length(lines("")) == 0)
    expect(lines("a\rb\n") == ["a\rb"])
}

test "decode takes well-formed UTF-8" {
    expect(decode(bytes("caf\u{e9} \u{20ac} \u{1f600}")) == Some("caf\u{e9} \u{20ac} \u{1f600}"))
    expect(decode([104, 105]) == Some("hi"))
    expect(decode([]) == Some(""))
    expect(decode([0xC3, 0xA9]) == Some("\u{e9}"))
    expect(decode([0xED, 0x9F, 0xBF]) == Some("\u{d7ff}"))
    expect(decode([0xF4, 0x8F, 0xBF, 0xBF]) == Some("\u{10ffff}"))
    expect(decode([0]) == Some("\0"))
}

test "decode refuses bytes that aren't UTF-8" {
    // A continuation byte with nothing before it, and a first byte with nothing after.
    expect(decode([0x80]) == None)
    expect(decode([0xC3]) == None)
    expect(decode([0xE2, 0x82]) == None)
    expect(decode([0xC3, 0x41]) == None)
    // Encodings longer than they need to be.
    expect(decode([0xC0, 0xAF]) == None)
    expect(decode([0xE0, 0x80, 0xAF]) == None)
    expect(decode([0xF0, 0x80, 0x80, 0xAF]) == None)
    // A surrogate, and a value past 10FFFF.
    expect(decode([0xED, 0xA0, 0x80]) == None)
    expect(decode([0xF4, 0x90, 0x80, 0x80]) == None)
    expect(decode([0xF5, 0x80, 0x80, 0x80]) == None)
    expect(decode([0xFF]) == None)
    expect(decode([104, 0xFF, 105]) == None)
}

test "parseInt reads decimal digits with an optional minus" {
    expect(parseInt("0") == Some(0))
    expect(parseInt("42") == Some(42))
    expect(parseInt("-42") == Some(-42))
    expect(parseInt("007") == Some(7))
    expect(parseInt("-0") == Some(0))
    expect(parseInt("9223372036854775807") == Some(9223372036854775807))
    expect(parseInt("-9223372036854775808") == Some(-9223372036854775808))
}

test "parseInt refuses anything else" {
    expect(parseInt("") == None)
    expect(parseInt("-") == None)
    expect(parseInt("+1") == None)
    expect(parseInt(" 1") == None)
    expect(parseInt("1 ") == None)
    expect(parseInt("1_000") == None)
    expect(parseInt("1.5") == None)
    expect(parseInt("12a") == None)
    expect(parseInt("--1") == None)
    expect(parseInt("\u{661}") == None)
    expect(parseInt("9223372036854775808") == None)
    expect(parseInt("-9223372036854775809") == None)
    expect(parseInt("99999999999999999999999") == None)
}

test "parseBool reads true and false in any case" {
    expect(parseBool("true") == Some(true))
    expect(parseBool("false") == Some(false))
    expect(parseBool("True") == Some(true))
    expect(parseBool("TRUE") == Some(true))
    expect(parseBool("fAlSe") == Some(false))
    expect(parseBool("") == None)
    expect(parseBool("yes") == None)
    expect(parseBool("t") == None)
    expect(parseBool("truer") == None)
    expect(parseBool("TR\u{dc}E") == None)
    expect(parseBool("true ") == None)
    expect(parseBool("1") == None)
}

test "parseFloat reads digits, a fraction and an exponent" {
    expect(parseFloat("0") == Some(0.0))
    expect(parseFloat("42") == Some(42.0))
    expect(parseFloat("-42") == Some(-42.0))
    expect(parseFloat("007.50") == Some(7.5))
    expect(parseFloat("3.141592653589793") == Some(3.141592653589793))
    expect(parseFloat("0.1") == Some(0.1))
    expect(parseFloat("-0.000001") == Some(-0.000001))
    expect(parseFloat("1e3") == Some(1000.0))
    expect(parseFloat("1E3") == Some(1000.0))
    expect(parseFloat("1.5e+3") == Some(1500.0))
    expect(parseFloat("1.5e-3") == Some(0.0015))
    expect(parseFloat(".5") == Some(0.5))
    expect(parseFloat("-.5") == Some(-0.5))
    expect(parseFloat("5.") == Some(5.0))
    expect(parseFloat("1.e3") == Some(1000.0))
    expect(parseFloat(".5e1") == Some(5.0))
    expect(parseFloat("123456789012345e22") == Some(123456789012345e22))
    expect(parseFloat("0.000e999999999999999999999") == Some(0.0))
    expect(String(parseFloat("-0")!) == String(-0.0))
}

test "parseFloat refuses anything else" {
    expect(parseFloat("") == None)
    expect(parseFloat("-") == None)
    expect(parseFloat("+1") == None)
    expect(parseFloat(" 1") == None)
    expect(parseFloat("1 ") == None)
    expect(parseFloat(".") == None)
    expect(parseFloat("-.") == None)
    expect(parseFloat(".e3") == None)
    expect(parseFloat("e3") == None)
    expect(parseFloat("1e") == None)
    expect(parseFloat("1e+") == None)
    expect(parseFloat("1e1.5") == None)
    expect(parseFloat("1_000.0") == None)
    expect(parseFloat("1.2.3") == None)
    expect(parseFloat("0x10") == None)
    expect(parseFloat("inf") == None)
    expect(parseFloat("NaN") == None)
    expect(parseFloat("\u{661}") == None)
}

test "parseFloat gives the nearest Float, ties to even" {
    expect(parseFloat("0.30000000000000004") == Some(0.1 + 0.2))
    expect(parseFloat("9007199254740993") == Some(9007199254740992.0))
    expect(parseFloat("9007199254740993.0000000000000000000000001") == Some(9007199254740994.0))
    expect(parseFloat("9007199254740995") == Some(9007199254740996.0))
    expect(parseFloat("8.41e21") == Some(8.41e21))
    expect(parseFloat("1e23") == Some(1e23))
    expect(parseFloat("123456789012345678901234567890") == Some(123456789012345678901234567890.0))
    expect(parseFloat("0.000000000000000000000000000001234567890123456789") == Some(1.234567890123456789e-30))
    expect(parseFloat("1.7976931348623157e308") == Some(1.7976931348623157e308))
    expect(parseFloat("2.2250738585072014e-308") == Some(2.2250738585072014e-308))
    // 2^-1074, the smallest Float above zero, and the numbers either side of half of it.
    val smallest = 2.2250738585072014e-308 / 4503599627370496.0
    expect(smallest > 0.0)
    expect(parseFloat("5e-324") == Some(smallest))
    expect(parseFloat("2.4703282292062328e-324") == Some(smallest))
    expect(parseFloat("2.4703282292062327e-324") == Some(0.0))
    expect(parseFloat("7.4109846876186982e-324") == Some(smallest * 2.0))
    // The largest Float below 2^-1022, where fewer bits are kept.
    expect(parseFloat("2.2250738585072011e-308") == Some(2.2250738585072014e-308 - smallest))
}

test "parseFloat is None past the largest Float and zero below the smallest" {
    expect(parseFloat("1.7976931348623158e308") == Some(1.7976931348623157e308))
    expect(parseFloat("1.7976931348623159e308") == None)
    expect(parseFloat("-1.7976931348623159e308") == None)
    expect(parseFloat("1e309") == None)
    expect(parseFloat("1e999999999999999999999") == None)
    expect(parseFloat("1e-400") == Some(0.0))
    expect(parseFloat("1e-999999999999999999999") == Some(0.0))
    mutable val zeros = ""
    for n in 0..400 {
        zeros ~= "0"
    }
    expect(parseFloat("0.{zeros}1e400") == Some(0.1))
    expect(parseFloat("1{zeros}e-400") == Some(1.0))
}
