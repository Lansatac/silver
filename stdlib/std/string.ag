// Asking about a String's contents and cutting one apart. A String is cut by value, never by
// position: every piece handed back begins and ends between characters.
//
// The questions compare bytes, which for UTF-8 gives the same answer as comparing characters. The
// empty string is found in every string, at both ends.
module std.string

import std.char
// Every slice below cuts a String where another String matched or where a character ended.
import lang.string : slice
// `decode(data)`, `data` as a String, or `None` if it isn't UTF-8.
forward import lang.string : decode

def isEmpty(text: String): Bool => length(bytes(text)) == 0

// Whether `part` appears somewhere in `text`.
def contains(text: String, part: String): Bool => find(bytes(text), bytes(part)) != None

// Whether `text` begins with `prefix`.
def startsWith(text: String, prefix: String): Bool {
    val data = bytes(text)
    val part = bytes(prefix)
    length(part) <= length(data) && matchesAt(data, part, 0)
}

// Whether `text` finishes with `suffix`.
def endsWith(text: String, suffix: String): Bool {
    val data = bytes(text)
    val part = bytes(suffix)
    length(part) <= length(data) && matchesAt(data, part, length(data) - length(part))
}

// `text` without `prefix` at its beginning, or `None` if it doesn't begin with it.
def stripPrefix(text: String, prefix: String): String? {
    if !startsWith(text, prefix) {
        return None
    }
    slice(text, length(bytes(prefix)), length(bytes(text)))
}

// `text` without `suffix` at its end, or `None` if it doesn't end with it.
def stripSuffix(text: String, suffix: String): String? {
    if !endsWith(text, suffix) {
        return None
    }
    val data = bytes(text)
    slice(text, 0, length(data) - length(bytes(suffix)))
}

// What comes before and after the first `separator` in `text`, or `None` if it isn't there.
def splitOnce(text: String, separator: String): (String, String)? {
    val data = bytes(text)
    val at = find(data, bytes(separator))?
    (slice(text, 0, at), slice(text, at + length(bytes(separator)), length(data)))
}

// The characters at the beginning of `text` that `keep` accepts, and everything after them.
def splitWhile(text: String, keep: (Char) -> Bool): (String, String) {
    mutable val rest = text
    while val step = next(rest) {
        val (c, after) = step
        if !keep(c) {
            break
        }
        rest = after
    }
    val data = bytes(text)
    (slice(text, 0, length(data) - length(bytes(rest))), rest)
}

// `text` without the white space at its beginning.
def trimStart(text: String): String {
    val (_, rest) = splitWhile(text, isWhitespace)
    rest
}

// `text` without the white space at its end.
def trimEnd(text: String): String {
    val data = bytes(text)
    mutable val end = length(data)
    while end > 0 {
        // A character's first byte is the only one that isn't `10xxxxxx`.
        mutable val start = end - 1
        while start > 0 && (data[start] & 0xC0) == 0x80 {
            start -= 1
        }
        if !isBlank(slice(text, start, end)) {
            break
        }
        end = start
    }
    slice(text, 0, end)
}

// `text` without the white space at either end.
def trim(text: String): String => trimEnd(trimStart(text))

// The pieces of `text` between each `separator`, so there's one more piece than there are
// separators, and some may be empty. An empty separator gives each character as its own piece.
def split(text: String, separator: String): [String] {
    mutable val pieces: [String] = []
    if isEmpty(separator) {
        for c in text {
            pieces ~= [String(c)]
        }
        return pieces
    }
    mutable val rest = text
    while val cut = splitOnce(rest, separator) {
        val (before, after) = cut
        pieces ~= [before]
        rest = after
    }
    pieces ~ [rest]
}

// The lines of `text`, without the `\n` or `\r\n` that ends each. A final line needs no ending,
// and one after the last ending isn't a line: `"a\n"` is one line.
def lines(text: String): [String] {
    mutable val found: [String] = []
    mutable val rest = text
    while !isEmpty(rest) {
        val (line, after) = splitOnce(rest, "\n") ?? (rest, "")
        found ~= [stripSuffix(line, "\r") ?? line]
        rest = after
    }
    found
}

// The Int that `text` writes in decimal: digits `0` to `9`, with `-` before them for a negative
// number. `None` for anything else, an empty string and a number too large for an Int included.
def parseInt(text: String): Int? {
    val data = bytes(text)
    val negative = length(data) > 0 && data[0] == 45
    mutable val i = if negative => 1 else 0
    if i == length(data) {
        return None
    }
    // Counted downwards, since the most negative Int has no positive twin.
    val lowest = -9223372036854775808
    mutable val value = 0
    while i < length(data) {
        val digit = Int(data[i]) - 48
        if digit < 0 || digit > 9 || value < (lowest + digit) / 10 {
            return None
        }
        value = value * 10 - digit
        i += 1
    }
    if negative {
        return value
    }
    if value == lowest {
        return None
    }
    -value
}

// `true` for the text `true` and `false` for `false`, the two ways a Bool is written, in capitals
// or not: `True` and `FALSE` are read too. `None` for anything else.
def parseBool(text: String): Bool? {
    if isWord(text, "true") {
        return true
    }
    if isWord(text, "false") {
        return false
    }
    None
}

// Whether `text` is `word`, which is in lower case, with any of its letters `A` to `Z` in capitals.
private def isWord(text: String, word: String): Bool {
    val data = bytes(text)
    val wanted = bytes(word)
    if length(data) != length(wanted) {
        return false
    }
    mutable val i = 0
    while i < length(data) {
        val lowered = if data[i] >= 65 && data[i] <= 90 => data[i] + 32 else data[i]
        if lowered != wanted[i] {
            return false
        }
        i += 1
    }
    true
}

// The Float nearest the decimal number `text` writes: digits with an optional `.` among them,
// before them or after them, then optionally `e` or `E`, a sign and digits, with `-` before it all
// for a negative number. `None` for anything else, and for a number too large for a Float. One too
// small to tell from zero is zero.
def parseFloat(text: String): Float? {
    val data = bytes(text)
    val count = length(data)
    val negative = count > 0 && data[0] == 45
    val first = if negative => 1 else 0
    mutable val i = first
    while i < count && isDigitByte(data[i]) {
        i += 1
    }
    val wholeDigits = i - first
    mutable val fractionDigits = 0
    if i < count && data[i] == 46 {
        val fraction = i + 1
        i = fraction
        while i < count && isDigitByte(data[i]) {
            i += 1
        }
        fractionDigits = i - fraction
    }
    if wholeDigits + fractionDigits == 0 {
        return None
    }
    val digitsEnd = i
    mutable val exponent = 0
    if i < count && (data[i] == 101 || data[i] == 69) {
        i += 1
        val down = i < count && data[i] == 45
        if down || (i < count && data[i] == 43) {
            i += 1
        }
        val written = i
        while i < count && isDigitByte(data[i]) {
            // Past this the number is zero or too large whatever the digits say.
            if exponent < 100000000 {
                exponent = exponent * 10 + Int(data[i]) - 48
            }
            i += 1
        }
        if i == written {
            return None
        }
        if down {
            exponent = -exponent
        }
    }
    if i != count {
        return None
    }
    exponent -= fractionDigits

    // The digits from the first that isn't zero, as a UInt64 while they fit one.
    mutable val significant = 0
    mutable val small: UInt64 = 0
    i = first
    while i < digitsEnd {
        if data[i] != 46 && (significant > 0 || data[i] != 48) {
            significant += 1
            if significant <= 19 {
                small = small * 10 + UInt64(data[i] - 48)
            }
        }
        i += 1
    }
    if significant == 0 || significant + exponent < -330 {
        return if negative => -0.0 else 0.0
    }
    if significant + exponent > 310 {
        return None
    }

    // Up to 15 digits and a power of ten up to 22 are each exactly a Float, so one multiplication
    // or division rounds once, which is the nearest.
    if significant <= 15 && exponent >= -22 && exponent <= 22 {
        mutable val power = 1.0
        mutable val left = if exponent < 0 => -exponent else exponent
        while left > 0 {
            power *= 10.0
            left -= 1
        }
        val value = if exponent < 0 => Float(small) / power else Float(small) * power
        return if negative => -value else value
    }
    if significant <= 19 {
        if val value = eiselLemire(small, exponent) {
            return if negative => -value else value
        }
    }

    mutable val digits: [Int] = []
    i = first
    while i < digitsEnd {
        if data[i] != 46 {
            digits = bigTimesPlus(digits, 10, Int(data[i]) - 48)
        }
        i += 1
    }
    val value = nearestFloat(digits, exponent) ?? return None
    if negative => -value else value
}

private def isDigitByte(byte: UInt8): Bool => byte >= 48 && byte <= 57

// The Float nearest `digits * 10^power` by the Eisel-Lemire algorithm, for `digits` above zero:
// multiplying `digits` by a 128-bit approximation of 10^power gives enough of the product's bits
// to round by in all but a few cases, which are `None`, as is a result that's subnormal or too
// large. This follows Go's `eiselLemire64`, with the table of fast_float.
private def eiselLemire(digits: UInt64, power: Int): Float? {
    if power < -342 || power > 308 {
        return None
    }
    val zeros = leadingZeros(digits)
    val scaled = digits << zeros
    // The biased exponent, with 217706 / 2^16 a little above log2(10).
    mutable val exponent = ((217706 * power) >> 16) + 1087 - zeros
    val at = (power + 342) * 32
    val tableData = bytes(powersOfFive)
    mutable val (high, low) = multiply(scaled, hexWord(tableData, at))

    // When the bits below the 55 that matter are all ones, the low half of the power can carry
    // into them.
    if (high & 0x1ff) == 0x1ff && low +% scaled < scaled {
        val (carryHigh, carryLow) = multiply(scaled, hexWord(tableData, at + 16))
        val mergedLow = low +% carryHigh
        val mergedHigh = if mergedLow < low => high + 1 else high
        if (mergedHigh & 0x1ff) == 0x1ff && mergedLow +% 1 == 0 && carryLow +% scaled < scaled {
            return None
        }
        high = mergedHigh
        low = mergedLow
    }

    // 54 bits, one more than a Float keeps, to round by.
    val top = Int(high >> 63)
    mutable val mantissa = high >> (top + 9)
    exponent -= 1 - top
    // Exactly halfway between two Floats, or too close to tell.
    if low == 0 && (high & 0x1ff) == 0 && (mantissa & 3) == 1 {
        return None
    }
    mantissa += mantissa & 1
    mantissa >>= 1
    if (mantissa >> 53) > 0 {
        mantissa >>= 1
        exponent += 1
    }
    if exponent <= 0 || exponent >= 2047 {
        return None
    }
    Float(mantissa) * twoTo(exponent - 1075)
}

private def leadingZeros(x: UInt64): Int {
    mutable val value = x
    mutable val zeros = 0
    mutable val width = 32
    while width > 0 {
        if (value >> (64 - width)) == 0 {
            zeros += width
            value <<= width
        }
        width >>= 1
    }
    zeros
}

// The 128-bit product `a * b`, as its high and low halves, from the products of 32-bit halves.
private def multiply(a: UInt64, b: UInt64): (UInt64, UInt64) {
    val aLow = a & 0xffffffff
    val aHigh = a >> 32
    val bLow = b & 0xffffffff
    val bHigh = b >> 32
    val lowLow = aLow * bLow
    val lowHigh = aLow * bHigh
    val highLow = aHigh * bLow
    val middle = (lowLow >> 32) + (lowHigh & 0xffffffff) + (highLow & 0xffffffff)
    val high = aHigh * bHigh + (lowHigh >> 32) + (highLow >> 32) + (middle >> 32)
    (high, (middle << 32) | (lowLow & 0xffffffff))
}

// The 16 hexadecimal digits in `data` from `at`, in lower case.
private def hexWord(data: [UInt8], at: Int): UInt64 {
    mutable val value: UInt64 = 0
    mutable val i = at
    while i < at + 16 {
        val c = data[i]
        value = (value << 4) | UInt64(if c >= 97 => c - 87 else c - 48)
        i += 1
    }
    value
}

// 2^power, for a power from -1074 to 1023, which is exactly a Float, as is each step to it.
private def twoTo(power: Int): Float {
    mutable val base = if power < 0 => 0.5 else 2.0
    mutable val left = if power < 0 => -power else power
    mutable val result = 1.0
    while left > 0 {
        if (left & 1) == 1 {
            result *= base
        }
        left >>= 1
        if left > 0 {
            base *= base
        }
    }
    result
}

// The Float nearest `digits * 10^exponent`, ties going to the even one, for `digits` above zero.
// `None` when it's too large.
private def nearestFloat(digits: [Int], exponent: Int): Float? {
    val above = if exponent > 0 => bigTimesTenTo(digits, exponent) else digits
    val below = if exponent < 0 => bigTimesTenTo([1], -exponent) else [1]
    // The quotient of the two, scaled by 2^shift to have 55 or 56 bits: the 53 a Float keeps and
    // at least two to round by.
    val shift = 55 - (bigBits(above) - bigBits(below))
    mutable val rest = if shift > 0 => bigShiftLeft(above, shift) else above
    mutable val step = bigShiftLeft(below, 55 + (if shift < 0 => -shift else 0))
    mutable val quotient = 0
    mutable val bit = 55
    while bit >= 0 {
        if bigAtLeast(rest, step) {
            rest = bigMinus(rest, step)
            quotient |= 1 << bit
        }
        step = bigHalf(step)
        bit -= 1
    }
    val inexact = length(rest) > 0
    val bits = if (quotient >> 55) > 0 => 56 else 55
    // The power of two of the number's highest bit.
    val top = bits - 1 - shift
    if top > 1024 {
        return None
    }
    // Below 2^-1022 a Float keeps fewer bits, down to one at 2^-1074.
    val kept = if top >= -1022 => 53 else top + 1075
    if kept < 0 {
        return 0.0
    }
    val dropped = bits - kept
    mutable val mantissa = quotient >> dropped
    val half = ((quotient >> (dropped - 1)) & 1) == 1
    val more = (quotient & ((1 << (dropped - 1)) - 1)) != 0 || inexact
    if half && (more || (mantissa & 1) == 1) {
        mantissa += 1
    }
    val value = timesTwoTo(Float(mantissa), dropped - shift)
    if value > 1.7976931348623157e308 {
        return None
    }
    value
}

// `x * 2^power`, exactly when that is a Float, since each step is.
private def timesTwoTo(x: Float, power: Int): Float {
    val sixty = 1152921504606846976.0
    mutable val value = x
    mutable val left = power
    while left >= 60 {
        value *= sixty
        left -= 60
    }
    while left > 0 {
        value *= 2.0
        left -= 1
    }
    while left <= -60 {
        value /= sixty
        left += 60
    }
    while left < 0 {
        value /= 2.0
        left += 1
    }
    value
}

// A whole number of any size, for `parseFloat`: 32 bits to an element, the lowest first, and no
// zero as the last. Each of these builds its answer by appending, since assigning an element
// copies the array.

// `n * factor + add`, for a `factor` up to 2^30 and an `add` below 2^32.
private def bigTimesPlus(n: [Int], factor: Int, add: Int): [Int] {
    mutable val result: [Int] = []
    mutable val carry = add
    for part in n {
        val value = part * factor + carry
        result ~= [value & 4294967295]
        carry = value >> 32
    }
    if carry > 0 {
        result ~= [carry]
    }
    result
}

private def bigTimesTenTo(n: [Int], power: Int): [Int] {
    mutable val result = n
    mutable val left = power
    while left >= 9 {
        result = bigTimesPlus(result, 1000000000, 0)
        left -= 9
    }
    while left > 0 {
        result = bigTimesPlus(result, 10, 0)
        left -= 1
    }
    result
}

// How many bits `n` takes to write.
private def bigBits(n: [Int]): Int {
    if length(n) == 0 {
        return 0
    }
    mutable val bits = (length(n) - 1) * 32
    mutable val top = n[length(n) - 1]
    while top > 0 {
        bits += 1
        top >>= 1
    }
    bits
}

private def bigShiftLeft(n: [Int], bits: Int): [Int] {
    if length(n) == 0 {
        return n
    }
    mutable val result: [Int] = []
    mutable val whole = bits / 32
    while whole > 0 {
        result ~= [0]
        whole -= 1
    }
    val within = bits % 32
    mutable val carry = 0
    for part in n {
        val value = (part << within) | carry
        result ~= [value & 4294967295]
        carry = value >> 32
    }
    if carry > 0 {
        result ~= [carry]
    }
    result
}

private def bigHalf(n: [Int]): [Int] {
    mutable val result: [Int] = []
    val count = length(n)
    mutable val i = 0
    while i < count {
        val above = if i + 1 < count => n[i + 1] & 1 else 0
        val part = (n[i] >> 1) | (above << 31)
        if i + 1 < count || part > 0 {
            result ~= [part]
        }
        i += 1
    }
    result
}

private def bigAtLeast(a: [Int], b: [Int]): Bool {
    if length(a) != length(b) {
        return length(a) > length(b)
    }
    mutable val i = length(a) - 1
    while i >= 0 {
        if a[i] != b[i] {
            return a[i] > b[i]
        }
        i -= 1
    }
    true
}

// `a - b`, for an `a` that's at least `b`.
private def bigMinus(a: [Int], b: [Int]): [Int] {
    mutable val result: [Int] = []
    mutable val borrow = 0
    mutable val used = 0
    mutable val i = 0
    while i < length(a) {
        mutable val part = a[i] - borrow - (if i < length(b) => b[i] else 0)
        borrow = 0
        if part < 0 {
            part += 4294967296
            borrow = 1
        }
        result ~= [part]
        if part > 0 {
            used = i + 1
        }
        i += 1
    }
    result[..used]
}

// Where `part` first appears in `data`, as a count of bytes before it.
private def find(data: [UInt8], part: [UInt8]): Int? {
    mutable val start = 0
    while start + length(part) <= length(data) {
        if matchesAt(data, part, start) {
            return start
        }
        start += 1
    }
    None
}

// Whether `part` is in `data` at `start`, which leaves room for it.
private def matchesAt(data: [UInt8], part: [UInt8], start: Int): Bool {
    mutable val i = 0
    while i < length(part) {
        if data[start + i] != part[i] {
            return false
        }
        i += 1
    }
    true
}

// Whether `text`, which is one character, is white space.
private def isBlank(text: String): Bool {
    if val step = next(text) {
        val (c, _) = step
        return isWhitespace(c)
    }
    false
}

def join(parts: Range<String>, separator: String): String {
    mutable val result = ""
    mutable val first = true
    for part in parts {
        if !first { result ~= separator }
        result ~= part
        first = false
    }
    result
}

// For `eiselLemire`, 5^q for each q from -342 to 308 as 32 hexadecimal digits: its 128 highest
// bits, which are 10^q's too. A positive q's is truncated. For a negative q, with z the bits in
// 5^-q, it's floor(2^b / 5^-q) + 1 truncated, with b = z + 127 from q = -27 up and 2z + 128 below,
// as fast_float computes it. A test in string.test.ag checks every one.
private val powersOfFive: String =
    "eef453d6923bd65a113faa2906a13b3f" ~
    "9558b4661b6565f84ac7ca59a424c507" ~
    "baaee17fa23ebf765d79bcf00d2df649" ~
    "e95a99df8ace6f53f4d82c2c107973dc" ~
    "91d8a02bb6c1059479071b9b8a4be869" ~
    "b64ec836a47146f99748e2826cdee284" ~
    "e3e27a444d8d98b7fd1b1b2308169b25" ~
    "8e6d8c6ab0787f72fe30f0f5e50e20f7" ~
    "b208ef855c969f4fbdbd2d335e51a935" ~
    "de8b2b66b3bc4723ad2c788035e61382" ~
    "8b16fb203055ac764c3bcb5021afcc31" ~
    "addcb9e83c6b1793df4abe242a1bbf3d" ~
    "d953e8624b85dd78d71d6dad34a2af0d" ~
    "87d4713d6f33aa6b8672648c40e5ad68" ~
    "a9c98d8ccb009506680efdaf511f18c2" ~
    "d43bf0effdc0ba480212bd1b2566def2" ~
    "84a57695fe98746d014bb630f7604b57" ~
    "a5ced43b7e3e9188419ea3bd35385e2d" ~
    "cf42894a5dce35ea52064cac828675b9" ~
    "818995ce7aa0e1b27343efebd1940993" ~
    "a1ebfb4219491a1f1014ebe6c5f90bf8" ~
    "ca66fa129f9b60a6d41a26e077774ef6" ~
    "fd00b897478238d08920b098955522b4" ~
    "9e20735e8cb1638255b46e5f5d5535b0" ~
    "c5a890362fddbc62eb2189f734aa831d" ~
    "f712b443bbd52b7ba5e9ec7501d523e4" ~
    "9a6bb0aa55653b2d47b233c92125366e" ~
    "c1069cd4eabe89f8999ec0bb696e840a" ~
    "f148440a256e2c76c00670ea43ca250d" ~
    "96cd2a865764dbca380406926a5e5728" ~
    "bc807527ed3e12bcc605083704f5ecf2" ~
    "eba09271e88d976bf7864a44c633682e" ~
    "93445b8731587ea37ab3ee6afbe0211d" ~
    "b8157268fdae9e4c5960ea05bad82964" ~
    "e61acf033d1a45df6fb92487298e33bd" ~
    "8fd0c16206306baba5d3b6d479f8e056" ~
    "b3c4f1ba87bc86968f48a4899877186c" ~
    "e0b62e2929aba83c331acdabfe94de87" ~
    "8c71dcd9ba0b49259ff0c08b7f1d0b14" ~
    "af8e5410288e1b6f07ecf0ae5ee44dd9" ~
    "db71e91432b1a24ac9e82cd9f69d6150" ~
    "892731ac9faf056ebe311c083a225cd2" ~
    "ab70fe17c79ac6ca6dbd630a48aaf406" ~
    "d64d3d9db981787d092cbbccdad5b108" ~
    "85f0468293f0eb4e25bbf56008c58ea5" ~
    "a76c582338ed2621af2af2b80af6f24e" ~
    "d1476e2c07286faa1af5af660db4aee1" ~
    "82cca4db847945ca50d98d9fc890ed4d" ~
    "a37fce126597973ce50ff107bab528a0" ~
    "cc5fc196fefd7d0c1e53ed49a96272c8" ~
    "ff77b1fcbebcdc4f25e8e89c13bb0f7a" ~
    "9faacf3df73609b177b191618c54e9ac" ~
    "c795830d75038c1dd59df5b9ef6a2417" ~
    "f97ae3d0d2446f254b0573286b44ad1d" ~
    "9becce62836ac5774ee367f9430aec32" ~
    "c2e801fb244576d5229c41f793cda73f" ~
    "f3a20279ed56d48a6b43527578c1110f" ~
