// What every module sees without an import, beside what `lang` provides. It declares nothing
// itself, so each name here can also be imported from the module that declares it.
module std.prelude

forward import std.of

// std.range's functions, and the types written in bounds, conformances and fields. The adapters'
// types are left to `import std.range`, since a chain's type is inferred.
forward import std.range : Sized, Indexed, Seq, Descending,
    next, length, opIndex, compare,
    map, take, drop, zip, enumerate, step, filter, takeWhile, dropWhile, flatMap, append,
    iterate, unfold, repeat, seq,
    first, rest, last, array, fold, count, isEmpty, any, all, find, contains, splitAt,
    min, max, sorted, sortedBy
