module std.random

type Rng(state: UInt64)

val golden: UInt64 = 0x9E3779B97F4A7C15

def seeded(seed: UInt64): Rng => Rng(seed)
def fromClock(): Rng => seeded(UInt64(nowNanos()))

def next(rng: Rng): Rng => Rng(rng.state &+ golden)

def value(rng: Rng): UInt64 {
    val a = rng.state
    val b = (a ^ (a >> 30)) &* 0xBF58476D1CE4E5B9
    val c = (b ^ (b >> 27)) &* 0x94D049BB133111EB
    c ^ (c >> 31)
}