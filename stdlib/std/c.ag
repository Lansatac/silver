// C's numeric types, as the Silver type of the same width on the platform being compiled for, and C's strings.
module std.c

// `CLong` and `CULong`, whose width depends on the platform, and `CString` with its conversions.
forward import lang.c

// Every supported platform has a signed `char`.
alias CChar = Int8
alias CUChar = UInt8
alias CShort = Int16
alias CUShort = UInt16
alias CInt = Int32
alias CUInt = UInt32
alias CLongLong = Int64
alias CULongLong = UInt64
alias CSize = UInt64

// `float` and `double`, the same on every platform.
alias CFloat = Float32
alias CDouble = Float
