module std.math

val pi: Float = 3.141592653589793

native def sqrt(x: Float): Float
native def exp(x: Float): Float
native def log(x: Float): Float

// Angles are in radians.
native def sin(x: Float): Float
native def cos(x: Float): Float
native def atan(x: Float): Float

def tan(x: Float): Float => sin(x) / cos(x)

def asin(x: Float): Float => atan2(x, sqrt((1 - x) * (1 + x)))
def acos(x: Float): Float => atan2(sqrt((1 - x) * (1 + x)), x)

def atan2(y: Float, x: Float): Float {
    if x != x || y != y {
        return x + y
    }
    val rise = magnitude(y)
    val angle = if x == 0 {
        if rise != 0 => pi / 2 else if isNegative(x) => pi else 0.0
    } else if rise / x != rise / x {
        // Only two infinities get here: NaN and a zero x are already handled.
        if x > 0 => pi / 4 else 3 * pi / 4
    } else if x > 0 => atan(rise / x) else pi + atan(rise / x)
    if isNegative(y) => -angle else angle
}

def floor(x: Float): Float {
    val whole = truncate(x)
    if whole > x => whole - 1 else whole
}

def ceil(x: Float): Float {
    val whole = truncate(x)
    if whole < x => whole + 1 else whole
}

// Halfway cases round away from zero.
def round(x: Float): Float {
    val whole = truncate(x)
    val rest = x - whole
    if rest >= 0.5 => whole + 1 else if rest <= -0.5 => whole - 1 else whole
}

native def pow(base: Float, exponent: Float): Float

// Arithmetic, so it panics as `*` and `/` do: on overflow, and for 0 to a negative power. A negative
// exponent truncates like division, so only 1 and -1 give anything but 0.
def powInt(base: Int, exponent: Int): Int {
    if exponent < 0 {
        if base == 1 || base == -1 {
            return powInt(base, -(exponent % 2))
        }
        return 1 / base
    }
    mutable val result = 1
    mutable val square = base
    mutable val remaining = exponent
    while remaining > 0 {
        if remaining % 2 == 1 {
            result *= square
        }
        remaining /= 2
        // Not on the last pass: this square isn't used, and could overflow when the result doesn't.
        if remaining > 0 {
            square *= square
        }
    }
    result
}

type Negative
type Overflow

// 20! is the largest that fits an Int.
def factorial(n: Int): Int ! Negative | Overflow {
    if n < 0 {
        return Error(Negative)
    }
    if n > 20 {
        return Error(Overflow)
    }
    mutable val result = 1
    mutable val i = 2
    while i <= n {
        result *= i
        i += 1
    }
    result
}

test "factorial" {
    expect(factorial(0) == 1, "0 is 1")
    expect(factorial(1) == 1)
    expect(factorial(2) == 2)
    expect(factorial(3) == 6)
    expect(factorial(4) == 24)
    expect(factorial(20) == 2432902008176640000)
}

test "factorial fails outside 0 to 20" {
    expect(factorial(-1) == Error(Negative))
    expect(factorial(21) == Error(Overflow))
}

// Unlike `x < 0`, this is true of -0.0.
private def isNegative(x: Float): Bool => x < 0 || (x == 0 && 1 / x < 0)

private def magnitude(x: Float): Float => if isNegative(x) => -x else x

// Rounds toward zero, keeping the sign of a zero result as IEEE requires.
private def truncate(x: Float): Float {
    // From 2^52 up every Float is whole, and Int() would panic on NaN or the infinities.
    if x != x || x == 0 || magnitude(x) >= 4503599627370496.0 {
        return x
    }
    val whole = Float(Int(x))
    if whole == 0 && x < 0 => -0.0 else whole
}
