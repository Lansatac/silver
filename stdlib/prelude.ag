// Everything here is visible in every module without an import.
module prelude

native def print(value: Any): Unit
native def printl(value: Any): Unit
// Reads a line from input, including its newline.
native def read(): String

native def toFloat(value: Int): Float
// Truncates toward zero. Panics on NaN or a value outside Int's range.
native def toInt(value: Float): Int
