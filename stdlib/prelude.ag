// Everything here is visible in every module without an import.
module prelude

intrinsic def print(value: Any): Unit
intrinsic def printl(value: Any): Unit
// Reads a line from input, including its newline, or `None` at the end of input.
intrinsic def read(): String?
// How many elements an array has. Sema requires an array here, until generics can say so.
intrinsic def length(values: Any): Int
// Stops the program with `message`, for what can't happen.
intrinsic def panic(message: String): Never
