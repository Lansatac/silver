{
  "name": "Silver Development",
  "build": { "dockerfile": "Dockerfile", "target": "dev" },
  // The source is a clone on a volume, made from the Windows clone by setup.sh. Working on the
  // Windows drive directly goes through WSL's 9p file sharing, which was about 5x slower to build
  // and test on. The Windows clone is mounted for setup.sh, the files it links, and as a remote.
  "workspaceMount": "source=silver-code,target=/code,type=volume",
  "workspaceFolder": "/code",
  "postCreateCommand": "bash /mnt/windows-silver/.devcontainer/setup.sh",
  // Conformance writes thousands of IR files, objects and executables to /tmp per run, and runs
  // the executables from there, so it needs exec.
  "runArgs": ["--tmpfs", "/tmp:rw,exec,mode=1777,size=8g"],
  "mounts": [
    // Keeps ~/.dub (fetched packages) and shell history across container rebuilds.
    "source=silver-dev-home,target=/home/dev,type=volume",
    "source=${localWorkspaceFolder},target=/mnt/windows-silver,type=bind"
  ],
  "customizations": {
    "vscode": {
      // Remote settings override the synced Windows user settings, whose D paths are Windows paths.
      "settings": {
        "d.stdlibPath": [
          "/opt/dlang/dmd-2.113.0/src/druntime/import",
          "/opt/dlang/dmd-2.113.0/src/phobos"
        ],
        "d.dmdPath": "/usr/local/bin/dmd",
        "d.dubPath": "/usr/local/bin/dub",
        "d.dubCompiler": "dmd",
        "d.dubArchType": ""
      },
      "extensions": [
        "webfreak.code-d",
        "vadimcn.vscode-lldb",
        "anthropic.claude-code"
      ]
    }
  },
  "remoteUser": "dev"
}
