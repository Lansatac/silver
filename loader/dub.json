{
	"name": "loader",
	"targetType": "library",
	"dependencies": {
		"silver:ast": "*",
		"silver:syntax": "*"
	},
	"preGenerateCommands-posix": ["mkdir -p \"$PACKAGE_DIR../out\" \"$PACKAGE_DIR../build\" && ln -sfn ../stdlib \"$PACKAGE_DIR../out/stdlib\" && ln -sfn ../stdlib \"$PACKAGE_DIR../build/stdlib\""],
	"preGenerateCommands-windows": ["for %D in (out build) do @(if not exist \"$PACKAGE_DIR..\\%D\\stdlib\" (mkdir \"$PACKAGE_DIR..\\%D\" 2>nul & mklink /J \"$PACKAGE_DIR..\\%D\\stdlib\" \"$PACKAGE_DIR..\\stdlib\" >nul))"],
	"configurations": [
		{ "name": "library" },
		{
			"name": "unittest",
			"targetPath": "../build",
			"dependencies": {
				"silver:testrunner": "*",
				"fluent-asserts": "~>2.1"
			},
			"libs-windows": ["psapi"],
			"lflags-windows": ["/STACK:67108864"]
		}
	]
}
