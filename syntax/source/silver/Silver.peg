Silver:
    Module               < StatementBlock? eoi
    StatementBlock       < Sep? TopLevelStatement (Sep TopLevelStatement)* Sep?
    Sep                  <: ((eol / ';') Spacing)+

    TopLevelStatement    < ImportStatement / Statement

    # ExpressionStatement is last: anything that isn't another kind of statement is an expression
    Statement            < (
                            / VariableDeclaration
                            / ValueDeclaration
                            / FunctionDeclaration
                            / NativeFunctionDeclaration
                            / ReturnStatement
                            / AssignmentStatement
                            / ExpressionStatement
                           )

    QualifiedName        <- ValueName ('.' ValueName)*

    ImportStatement      < :IMPORT QualifiedName

    ValueDeclaration     < :VAL Variable TypeAnnotation? '=' Expression
    VariableDeclaration  < :MUTABLE :VAL Variable (TypeAnnotation ('=' Expression)? / '=' Expression)

    AssignmentStatement  < AssignTarget AssignOp Expression
    AssignOp             < "+=" / "-=" / "*=" / "/=" / "^=" / "=" !"="

    AssignTarget         < Postfix

    FunctionDeclaration  < :DEF Variable :'(' FunctionParamDefs :')' TypeAnnotation (:'=>' Sep? Expression / Block)

    NativeFunctionDeclaration < :NATIVE :DEF Variable :'(' FunctionParamDefs :')' TypeAnnotation
    FunctionParamDefs    < (FunctionParamDef (',' FunctionParamDef)*)?
    FunctionParamDef     < Variable TypeAnnotation

    Block                < '{' Sep? (Statement (Sep Statement)* Sep?)? '}'

    # The value is optional so `return` alone returns ()
    ReturnStatement      < RETURN Expression?

    ExpressionStatement  < Expression

    TypeAnnotation       < :':' Type

    Type                 < BaseType OptionMark*
    OptionMark           <- "?"
    BaseType             < FunctionType / UnitType / :'(' Type :')' / NamedType
    FunctionType         < :'(' (Type (:',' Type)*)? :')' :"->" Type
    UnitType             < '(' ')'
    NamedType            < TypePath TypeArguments?
    TypePath             <- (ValueName '.')* TypeName
    TypeArguments        < :'<' Type (:',' Type)* :'>'

    Expression           < WhileExpression / IfExpression / OrExpression

    WhileExpression      < :WHILE Expression WhileBody
    WhileBody            < :'=>' Sep? Expression / Block

    IfExpression         < :IF Expression IfBranch (Sep? :ELSE ElseBranch)?
    IfBranch             < :'=>' Sep? Expression / Block
    ElseBranch           < Block / Expression

    OrExpression         < AndExpression (OrOperator AndExpression)*
    AndExpression        < EqExpression (AndOperator EqExpression)*
    EqExpression         < RelationalExpression ((EqOperator) RelationalExpression)*
    RelationalExpression < CoalesceExpression (RelationalOperator CoalesceExpression)?
    CoalesceExpression   < AdditionExpression (CoalesceOperator CoalesceExpression)?
    AdditionExpression   < MultiplyExpression (AdditionOperator MultiplyExpression)*
    MultiplyExpression   < Unary (MultiplyOperator Unary)*
    Unary                < UnaryOperator? PowerExpression
    UnaryOperator        < "-" / "!"
    PowerExpression      < Postfix (PowerOperator Unary)?

    ReadExpression       < READ

    Postfix              < Eval PostfixOp*
    PostfixOp            < CallArgs / IndexArgs / SafeMemberAccess / MemberAccess / PropagateNone
    MemberAccess         < :'.' identifier
    SafeMemberAccess     < :"?." identifier
    PropagateNone        <- "?" !("?" / ".")
    IndexArgs            < :'[' Expression :']'
    CallArgs             < '(' (FunctionParam (:',' FunctionParam)*)? ')'
    FunctionParam        < Expression

    Eval                 < UnitLiteral
                         / :'(' Expression :')'
                         / Block
                         / ReadExpression
                         / Literal
                         / CollectionLiteral
                         / Variable
                         / TypeName

    Literal              <  BooleanLiteral
                          / NumberLiteral

    UnitLiteral          < '(' ')'

    # Map is tried first so `[:]` and `[k: v]` aren't read as lists
    CollectionLiteral   < MapLiteral / ListLiteral
    # Brackets are kept so empty literals still match text; decimateTree drops nodes that match nothing
    ListLiteral         < '[' (Expression (:',' Expression)* :','?)? ']'
    MapLiteral          < '[' ':' ']'
                         / '[' MapEntry (:',' MapEntry)* :','? ']'
    MapEntry            < Expression :':' Expression

    OrOperator          <  "||"
    AndOperator         < "&&"
    EqOperator          <  "==" / "!="
    RelationalOperator  < "<=" / ">=" / "<" / ">"
    CoalesceOperator    < "??"
    AdditionOperator    <  "+" / "-"
    MultiplyOperator    <  "*" / "/" / "%"
    PowerOperator       <  "^"


    BooleanLiteral      <- TRUE / FALSE

    NumberLiteral       <-  ScientificLiteral
                          / HexaLiteral
                          / BinaryLiteral
                          / FloatingLiteral
                          / UnsignedLiteral
                          / IntegerLiteral

    ScientificLiteral   <~ (FloatingLiteral / IntegerLiteral) ( ('e' / 'E' ) IntegerLiteral )
    FloatingLiteral     <~ IntegerLiteral ('.' UnsignedLiteral )
    UnsignedLiteral     <~ [0-9]+
    IntegerLiteral      <~ SignLiteral? UnsignedLiteral
    HexaLiteral         <~ "0x" [0-9a-fA-F]+
    BinaryLiteral       <~ "0b" [01] [01_]*
    SignLiteral         <- '-' / '+'

    Kword(K)            <- K !IdentChar

    VAL                 <- Kword("val")
    MUTABLE             <- Kword("mutable")
    DEF                 <- Kword("def")
    NATIVE              <- Kword("native")
    WHILE               <- Kword("while")
    IF                  <- Kword("if")
    ELSE                <- Kword("else")
    TRUE                <- Kword("true")
    FALSE               <- Kword("false")
    READ                <- Kword("read")
    RETURN              <- Kword("return")
    IMPORT              <- Kword("import")

    Keyword             <- VAL / MUTABLE / DEF / NATIVE / IF / ELSE / TRUE / FALSE / READ / RETURN / IMPORT
    IdentChar           <- [a-zA-Z0-9_]
    Variable            <- !Keyword ValueName

    # Case is significant: uppercase names are types and constructors, lowercase are values
    ValueName           <~ [a-z_] IdentChar*
    TypeName            <~ [A-Z] IdentChar*

    Spacing             <- :(' ' / '\t' / Comment)*

    # Line comments stop before the newline so it still acts as a separator.
    # Block comments nest, and any newlines inside them are not separators.
    Comment             <- LineComment / BlockComment
    LineComment         <- "//" (!eol .)*
    BlockComment        <- "/*" (BlockComment / !"*/" .)* "*/"
