Silver:
    Module               < Sep? (ModuleDeclaration (Sep Declarations?)? / Declarations?) eoi
    Declarations         < Sep? Declaration (Sep Declaration)* Sep?
    Sep                  <: ((eol / ';') Spacing)+
    # A newline is whitespace wherever the token before it can't end a statement or the one after
    # it can't begin one. Spacing never holds one, so Nl is written at each of those places.
    Nl                   <: (eol Spacing)+
    # `-`, `~`, `!`, `(` and `[` can also begin a statement, so a leading one does.
    LeadingNl            <: Nl &LeadingOperator
    LeadingOperator      <- "&" / "|" / "==" / "!=" / "<" / ">" / "??" / ".." / "+" / "-%" / "*" / "/" / "%" / "^"

    Declaration          <  (
                            / ImportStatement
                            / NativeLibrary
                            / IntrinsicAlias
                            / IntrinsicType
                            / PrivateDeclaration
                            / FunctionDeclaration
                            / NativeFunctionDeclaration
                            / IntrinsicFunctionDeclaration
                            / TypeDeclaration
                            / AliasDeclaration
                            / ConstantDeclaration
                            / TestDeclaration
                            )

    # ExpressionStatement is last: anything that isn't another kind of statement is an expression
    Statement            <  (
                            / PatternDeclaration
                            / VariableDeclaration
                            / ValueDeclaration
                            / FunctionDeclaration
                            / NativeFunctionDeclaration
                            / IntrinsicFunctionDeclaration
                            / ReturnStatement
                            / BreakStatement
                            / ContinueStatement
                            / DiscardStatement
                            / AssignmentStatement
                            / ExpressionStatement
                            )

    PrivateDeclaration   < :PRIVATE Nl? (FunctionDeclaration / NativeFunctionDeclaration / IntrinsicFunctionDeclaration / IntrinsicAlias / IntrinsicType / TypeDeclaration / AliasDeclaration / ConstantDeclaration)

    QualifiedName        <- ValueName ('.' ValueName)*

    ModuleDeclaration    < :MODULE Nl? QualifiedName
    ImportStatement      < :IMPORT Nl? QualifiedName

    # The annotation is required, but sema can say so better than a parse error could
    ConstantDeclaration  < :VAL Nl? Identifier TypeAnnotation? Nl? '=' Nl? Expression
    ValueDeclaration     < :VAL Nl? BindingName TypeAnnotation? Nl? '=' Nl? Expression
    # `_ = x`, shorthand for `val _ = x`
    DiscardStatement     < :UNDERSCORE Nl? :"=" !"=" Nl? Expression
    BindingName          <- UNDERSCORE / Identifier
    VariableDeclaration  < :MUTABLE Nl? :VAL Nl? Identifier (TypeAnnotation (Nl? '=' Nl? Expression)? / Nl? '=' Nl? Expression)
    # `mutable` is kept, so lowering can tell whether it was there
    PatternDeclaration   < (MUTABLE Nl?)? :VAL Nl? TuplePattern Nl? :'=' Nl? Expression
    TuplePattern         < :'(' Nl? PatternElement (Nl? :',' Nl? PatternElement)+ Nl? :')'
    PatternElement       < TuplePattern / BindingName TypeAnnotation?

    AssignmentStatement  < AssignTarget Nl? AssignOp Nl? Expression
    AssignOp             < "+=" / "-=" / "*=" / "/=" / "^=" / "~=" / "+%=" / "-%=" / "*%=" / "&=" / "|=" / "<<=" / ">>=" / "=" !"="

    AssignTarget         < AssignTuple &(Nl? AssignOp) / Postfix
    AssignTuple          < :'(' Nl? AssignElement (Nl? :',' Nl? AssignElement)+ Nl? :')'
    AssignElement        < AssignTuple / UNDERSCORE / Postfix

    FunctionDeclaration  < :DEF Nl? Identifier (Nl? TypeParameters)? Nl? :'(' Nl? Params Nl? :')' TypeAnnotation Nl? (:'=>' Nl? Expression / Block)
    TestDeclaration      < :TEST Nl? StringLiteral Nl? (:'=>' Nl? Expression / Block)

    NativeFunctionDeclaration < :NATIVE Nl? NativeSymbol? :DEF Nl? Identifier (Nl? TypeParameters)? Nl? :'(' Nl? Params Nl? :')' TypeAnnotation
    NativeSymbol         < :'(' Nl? StringLiteral Nl? :')'
    IntrinsicFunctionDeclaration < :INTRINSIC Nl? :DEF Nl? Identifier (Nl? TypeParameters)? Nl? :'(' Nl? Params Nl? :')' TypeAnnotation
    NativeLibrary        < :NATIVE Nl? :LIBRARY Nl? StringLiteral
    IntrinsicAlias       < :INTRINSIC Nl? :ALIAS Nl? TypeName
    IntrinsicType        < :INTRINSIC Nl? :TYPE Nl? TypeName (Nl? TypeParameters)? Nl? Fields
    TypeParameters       < :'<' Nl? TypeParameter (Nl? :',' Nl? TypeParameter)* Nl? :'>'
    TypeParameter        < TypeName
    Params               < (Param (Nl? ',' Nl? Param)*)?
    Param                < (MUTABLE Nl?)? BindingName TypeAnnotation

    Block                < '{' Sep? (Statement (Sep Statement)* Sep?)? '}'

    # The value is optional so `return` alone returns ()
    ReturnStatement      < RETURN Expression?
    BreakStatement       < BREAK
    ContinueStatement    < CONTINUE

    TypeDeclaration      < :TYPE Nl? TypeName (Nl? TypeParameters)? (Fields Invariant? / Nl? :'=' !'=' Nl? SumMembers)?
    Invariant            < Nl? :INVARIANT Nl? Expression
    AliasDeclaration     < :ALIAS Nl? TypeName (Nl? TypeParameters)? Nl? :'=' !'=' Nl? Type
    SumMembers           < SumMember (LeadingNl? :BitOrOperator Nl? SumMember)*
    SumMember            < InlineMember / Type
    InlineMember         < TypeName Fields InlineInvariant?
    InlineInvariant      < Nl? :INVARIANT Nl? :'(' Nl? Expression Nl? :')'
    # The parens are kept so `type M()` still has a node, which sema rejects in favor of `type M`
    Fields               < '(' Nl? FieldList Nl? ')'
    FieldList            < (Field (Nl? ',' Nl? Field)*)?
    Field                < Identifier TypeAnnotation

    ExpressionStatement  < Expression

    TypeAnnotation       < Nl? :':' Nl? Type

    Type                 <- BaseType OptionMark?
    OptionMark           <- "?"
    BaseType             < FunctionType / UnitType / ArrayType / ParenType / NamedType
    # One element is grouping and more are a tuple, so the two share a parse
    ParenType            < :'(' Nl? Type (Nl? :',' Nl? Type)* Nl? :')'
    ArrayType            < :'[' Nl? Type Nl? :']'
    FunctionType         < :'(' Nl? (FunctionTypeParam (Nl? :',' Nl? FunctionTypeParam)*)? Nl? :')' Nl? :"->" Nl? Type
    FunctionTypeParam    < (MUTABLE Nl?)? Type
    UnitType             < '(' Nl? ')'
    NamedType            < TypePath TypeArguments?
    TypePath             <- (ValueName '.')* TypeName
    TypeArguments        < :'<' Nl? Type (Nl? :',' Nl? Type)* Nl? :'>'

    Expression           < MatchExpression / ForExpression / WhileExpression / IfExpression / Lambda / OrExpression
    # No lambda, or `if done => 1 else 2` would read the condition as one
    Condition            < MatchExpression / ForExpression / WhileExpression / IfExpression / OrExpression

    Lambda               < (LambdaParams TypeAnnotation? / BindingName) Nl? :'=>' Nl? Expression
    # The parens are kept so `()` still has a node
    LambdaParams         < '(' Nl? (LambdaParam (Nl? :',' Nl? LambdaParam)*)? Nl? ')'
    LambdaParam          < (MUTABLE Nl?)? BindingName TypeAnnotation?

    MatchExpression      < :MATCH Nl? Condition Nl? '{' Sep? (MatchArm (Sep MatchArm)* Sep?)? '}'
    MatchArm             < MatchPattern Nl? :'=>' Nl? Expression
    MatchPattern         < MatchTuplePattern / ConstructorPattern / Literal / TypedBinding / BindingName
    MatchTuplePattern    < :'(' Nl? MatchPattern (Nl? :',' Nl? MatchPattern)+ Nl? :')'
    ConstructorPattern   < TypePath (:'(' Nl? MatchPattern (Nl? :',' Nl? MatchPattern)* Nl? :')')?
    TypedBinding         < BindingName TypeAnnotation

    ForExpression        < :FOR Nl? (TuplePattern / BindingName) Nl? :IN Nl? Condition Nl? Block
    WhileExpression      < :WHILE Nl? (OptionBinding / Condition) Nl? Block

    IfExpression         < :IF Nl? (PatternBinding / OptionBinding / Condition) Nl? IfBranch (Nl? :ELSE Nl? ElseBranch)?
    PatternBinding       < :VAL Nl? ConstructorPattern Nl? :'=' Nl? Condition
    OptionBinding        < :VAL Nl? BindingName Nl? :'=' Nl? Condition
    IfBranch             < :'=>' Nl? Expression / Block
    ElseBranch           < Block / Expression

    OrExpression         < AndExpression (LeadingNl? OrOperator Nl? AndExpression)*
    AndExpression        < EqExpression (LeadingNl? AndOperator Nl? EqExpression)*
    EqExpression         < RelationalExpression (LeadingNl? EqOperator Nl? RelationalExpression)?
    RelationalExpression < RangeExpression (LeadingNl? RelationalOperator Nl? RangeExpression)?
    RangeExpression      < CoalesceExpression (LeadingNl? :".." Nl? CoalesceExpression)?
    CoalesceExpression   < BitOrExpression (LeadingNl? CoalesceOperator Nl? CoalesceExpression)?
    BitOrExpression      < BitXorExpression (LeadingNl? BitOrOperator Nl? BitXorExpression)*
    BitXorExpression     < BitAndExpression (LeadingNl? BitXorOperator Nl? BitAndExpression)*
    BitAndExpression     < ShiftExpression (LeadingNl? BitAndOperator Nl? ShiftExpression)*
    ShiftExpression      < AdditionExpression (LeadingNl? ShiftOperator Nl? AdditionExpression)*
    AdditionExpression   < MultiplyExpression (LeadingNl? AdditionOperator Nl? MultiplyExpression)*
    MultiplyExpression   < Unary (LeadingNl? MultiplyOperator Nl? Unary)*
    Unary                < (UnaryOperator Nl?)? Postfix
    UnaryOperator        < "-" / "!" / "~"

    Postfix              < Eval PostfixOp*
    PostfixOp            < CallArgs / IndexArgs / Nl? (SafeMemberAccess / MemberAccess / PropagateNone / WithUpdate / TypeArguments)
    MemberAccess         < :'.' Nl? identifier
    SafeMemberAccess     < :"?." Nl? identifier
    PropagateNone        <- "?" !("?" / "." !".")
    IndexArgs            < :'[' Nl? (SliceFrom / SliceTo / Expression) Nl? :']'
    SliceFrom            < CoalesceExpression LeadingNl? :".." &(Nl? ']')
    SliceTo              < :".." Nl? CoalesceExpression
    CallArgs             < '(' Nl? (Argument (Nl? :',' Nl? Argument)* Nl?)? ')'
    Argument             < (MUTABLE Nl?)? Expression
    WithUpdate           < :WITH Nl? :'(' Nl? FieldUpdate (Nl? :',' Nl? FieldUpdate)* Nl? :')'
    FieldUpdate          < FieldPath Nl? :'=' !'=' Nl? Expression
    FieldPath            < identifier (:'.' Nl? identifier)*

    Eval                 < UnitLiteral
                         / ParenExpression
                         / Block
                         / Literal
                         / CollectionLiteral
                         / Identifier
                         / TypeName

    Literal              <  BooleanLiteral
                          / NumberLiteral
                          / StringLiteral

    UnitLiteral          < '(' Nl? ')'
    # One element is grouping and more are a tuple, so the two share a parse
    ParenExpression      < :'(' Nl? Expression (Nl? :',' Nl? Expression)* Nl? :')'

    # Map is tried first so `[:]` and `[k: v]` aren't read as lists
    CollectionLiteral   < MapLiteral / ListLiteral
    # Brackets are kept so empty literals still match text; decimateTree drops nodes that match nothing
    ListLiteral         < '[' Nl? (Expression (Nl? :',' Nl? Expression)* (Nl? :',')? Nl?)? ']'
    MapLiteral          < '[' Nl? ':' Nl? ']'
                         / '[' Nl? MapEntry (Nl? :',' Nl? MapEntry)* (Nl? :',')? Nl? ']'
    MapEntry            < Expression Nl? :':' Nl? Expression

    OrOperator          <  "||"
    AndOperator         < "&&"
    EqOperator          <  "==" / "!="
    RelationalOperator  < "<=" / ">=" / "<" / ">"
    CoalesceOperator    < "??"
    BitOrOperator       <- "|" !("|" / ">")
    BitXorOperator      <- "^"
    BitAndOperator      <- "&" !"&"
    ShiftOperator       <- "<<" / ">>"
    AdditionOperator    <  "+%" / "-%" / "+" / "-" / "~"
    MultiplyOperator    <  "*%" / "*" / "/" / "%"


    BooleanLiteral      <- TRUE / FALSE

    # Single line only. Unknown escapes are rejected, so they stay free for later.
    StringLiteral       <- doublequote StringPart* doublequote
    StringPart          <- StringText / EscapeSequence / StringHole
    StringText          <~ (!doublequote !backslash !eol !'{' .)+
    EscapeSequence      <~ backslash (doublequote / backslash / [nrt0{}] / "u{" HexDigit HexDigit? HexDigit? HexDigit? HexDigit? HexDigit? "}")
    HexDigit            <- [0-9a-fA-F]
    # Not `<`, which would also skip the text's own spaces around the hole. The expression is
    # required, but lowering can say so better than a parse error could; the braces are kept
    # so an empty hole still matches text, as in ListLiteral.
    StringHole          <- '{' :Spacing Expression? :Spacing '}'

    NumberLiteral       <-  ScientificLiteral
                          / HexaLiteral
                          / BinaryLiteral
                          / FloatingLiteral
                          / UnsignedLiteral
                          / IntegerLiteral

    ScientificLiteral   <~ (FloatingLiteral / IntegerLiteral) ( ('e' / 'E' ) IntegerLiteral )
    FloatingLiteral     <~ IntegerLiteral ('.' UnsignedLiteral )
    UnsignedLiteral     <~ [0-9]+
    IntegerLiteral      <~ SignLiteral? UnsignedLiteral
    HexaLiteral         <~ "0x" [0-9a-fA-F]+
    BinaryLiteral       <~ "0b" [01] [01_]*
    SignLiteral         <- '-' / '+'

    Kword(K)            <- K !IdentChar

    VAL                 <- Kword("val")
    MUTABLE             <- Kword("mutable")
    DEF                 <- Kword("def")
    TYPE                <- Kword("type")
    NATIVE              <- Kword("native")
    INTRINSIC           <- Kword("intrinsic")
    LIBRARY             <- Kword("library")
    PRIVATE             <- Kword("private")
    WHILE               <- Kword("while")
    FOR                 <- Kword("for")
    IN                  <- Kword("in")
    BREAK               <- Kword("break")
    CONTINUE            <- Kword("continue")
    IF                  <- Kword("if")
    ELSE                <- Kword("else")
    TRUE                <- Kword("true")
    FALSE               <- Kword("false")
    RETURN              <- Kword("return")
    IMPORT              <- Kword("import")
    MODULE              <- Kword("module")
    WITH                <- Kword("with")
    MATCH               <- Kword("match")
    ALIAS               <- Kword("alias")
    INVARIANT           <- Kword("invariant")
    TEST                <- Kword("test")
    UNDERSCORE          <- Kword("_")

    Keyword             <- VAL / MUTABLE / DEF / TYPE / NATIVE / INTRINSIC / PRIVATE / WHILE / FOR / BREAK / CONTINUE / IF / ELSE / TRUE / FALSE / RETURN / IMPORT / MODULE / IN / MATCH / ALIAS / WITH / INVARIANT / UNDERSCORE
    IdentChar           <- [a-zA-Z0-9_]
    Identifier          <- !Keyword ValueName

    # Case is significant: uppercase names are types and constructors, lowercase are values
    ValueName           <~ [a-z_] IdentChar*
    TypeName            <~ [A-Z] IdentChar*

    Spacing             <- :(' ' / '\t' / Comment)*

    # Line comments stop before the newline so it still acts as a separator.
    # Block comments nest, and any newlines inside them are not separators.
    Comment             <- LineComment / BlockComment
    LineComment         <- "//" (!eol .)*
    BlockComment        <- "/*" (BlockComment / !"*/" .)* "*/"
