Silver:
    Module               < Sep? (ModuleDeclaration (Sep Declarations?)? / Declarations?) eoi
    Declarations         < Sep? Declaration (Sep Declaration)* Sep?
    Sep                  <: ((eol / ';') Spacing)+

    Declaration          <  (
                            / ImportStatement
                            / FunctionDeclaration
                            / NativeFunctionDeclaration
                            / TypeDeclaration
                            / ConstantDeclaration
                            )

    # ExpressionStatement is last: anything that isn't another kind of statement is an expression
    Statement            <  (
                            / VariableDeclaration
                            / ValueDeclaration
                            / FunctionDeclaration
                            / NativeFunctionDeclaration
                            / ReturnStatement
                            / AssignmentStatement
                            / ExpressionStatement
                            )

    QualifiedName        <- ValueName ('.' ValueName)*

    ModuleDeclaration    < :MODULE QualifiedName
    ImportStatement      < :IMPORT QualifiedName

    # The annotation is required, but sema can say so better than a parse error could
    ConstantDeclaration  < :VAL Identifier TypeAnnotation? '=' Expression
    ValueDeclaration     < :VAL Identifier TypeAnnotation? '=' Expression
    VariableDeclaration  < :MUTABLE :VAL Identifier (TypeAnnotation ('=' Expression)? / '=' Expression)

    AssignmentStatement  < AssignTarget AssignOp Expression
    AssignOp             < "+=" / "-=" / "*=" / "/=" / "^=" / "&+=" / "&-=" / "&*=" / "&=" / "|=" / "<<=" / ">>=" / "=" !"="

    AssignTarget         < Postfix

    FunctionDeclaration  < :DEF Identifier :'(' Params :')' TypeAnnotation (:'=>' Sep? Expression / Block)

    NativeFunctionDeclaration < :NATIVE :DEF Identifier :'(' Params :')' TypeAnnotation
    Params               < (Param (',' Param)*)?
    Param                < Identifier TypeAnnotation

    Block                < '{' Sep? (Statement (Sep Statement)* Sep?)? '}'

    # The value is optional so `return` alone returns ()
    ReturnStatement      < RETURN Expression?

    TypeDeclaration      < :TYPE TypeName Fields?
    # The parens are kept so `type M()` still has a node, which sema rejects in favor of `type M`
    Fields               < '(' Params ')'

    ExpressionStatement  < Expression

    TypeAnnotation       < :':' Type

    Type                 <- BaseType OptionMark?
    OptionMark           <- "?"
    BaseType             < FunctionType / UnitType / :'(' Type :')' / NamedType
    FunctionType         < :'(' (Type (:',' Type)*)? :')' :"->" Type
    UnitType             < '(' ')'
    NamedType            < TypePath TypeArguments?
    TypePath             <- (ValueName '.')* TypeName
    TypeArguments        < :'<' Type (:',' Type)* :'>'

    Expression           < WhileExpression / IfExpression / OrExpression

    WhileExpression      < :WHILE Expression Block

    IfExpression         < :IF (IfBinding / Expression) IfBranch (Sep? :ELSE ElseBranch)?
    IfBinding            < :VAL Identifier :'=' Expression
    IfBranch             < :'=>' Sep? Expression / Block
    ElseBranch           < Block / Expression

    OrExpression         < AndExpression (OrOperator AndExpression)*
    AndExpression        < EqExpression (AndOperator EqExpression)*
    EqExpression         < RelationalExpression (EqOperator RelationalExpression)?
    RelationalExpression < CoalesceExpression (RelationalOperator CoalesceExpression)?
    CoalesceExpression   < BitOrExpression (CoalesceOperator CoalesceExpression)?
    BitOrExpression      < BitXorExpression (BitOrOperator BitXorExpression)*
    BitXorExpression     < BitAndExpression (BitXorOperator BitAndExpression)*
    BitAndExpression     < ShiftExpression (BitAndOperator ShiftExpression)*
    ShiftExpression      < AdditionExpression (ShiftOperator AdditionExpression)*
    AdditionExpression   < MultiplyExpression (AdditionOperator MultiplyExpression)*
    MultiplyExpression   < Unary (MultiplyOperator Unary)*
    Unary                < UnaryOperator? Postfix
    UnaryOperator        < "-" / "!" / "~"

    Postfix              < Eval PostfixOp*
    PostfixOp            < CallArgs / IndexArgs / SafeMemberAccess / MemberAccess / PropagateNone
    MemberAccess         < :'.' identifier
    SafeMemberAccess     < :"?." identifier
    PropagateNone        <- "?" !("?" / ".")
    IndexArgs            < :'[' Expression :']'
    CallArgs             < '(' (Argument (:',' Argument)*)? ')'
    Argument             < Expression

    Eval                 < UnitLiteral
                         / :'(' Expression :')'
                         / Block
                         / Literal
                         / CollectionLiteral
                         / Identifier
                         / TypeName

    Literal              <  BooleanLiteral
                          / NumberLiteral
                          / StringLiteral

    UnitLiteral          < '(' ')'

    # Map is tried first so `[:]` and `[k: v]` aren't read as lists
    CollectionLiteral   < MapLiteral / ListLiteral
    # Brackets are kept so empty literals still match text; decimateTree drops nodes that match nothing
    ListLiteral         < '[' (Expression (:',' Expression)* :','?)? ']'
    MapLiteral          < '[' ':' ']'
                         / '[' MapEntry (:',' MapEntry)* :','? ']'
    MapEntry            < Expression :':' Expression

    OrOperator          <  "||"
    AndOperator         < "&&"
    EqOperator          <  "==" / "!="
    RelationalOperator  < "<=" / ">=" / "<" / ">"
    CoalesceOperator    < "??"
    BitOrOperator       <- "|" !("|" / ">")
    BitXorOperator      <- "^"
    BitAndOperator      <- "&" !("&" / "+" / "-" / "*")
    ShiftOperator       <- "<<" / ">>"
    AdditionOperator    <  "&+" / "&-" / "+" / "-" / "~"
    MultiplyOperator    <  "&*" / "*" / "/" / "%"


    BooleanLiteral      <- TRUE / FALSE

    # Single line only. Unknown escapes are rejected, so they stay free for later.
    StringLiteral       <- doublequote StringPart* doublequote
    StringPart          <- StringText / EscapeSequence / StringHole
    StringText          <~ (!doublequote !backslash !eol !'{' .)+
    EscapeSequence      <~ backslash (doublequote / backslash / [nrt0{}])
    # Not `<`, which would also skip the text's own spaces around the hole. The expression is
    # required, but lowering can say so better than a parse error could; the braces are kept
    # so an empty hole still matches text, as in ListLiteral.
    StringHole          <- '{' :Spacing Expression? :Spacing '}'

    NumberLiteral       <-  ScientificLiteral
                          / HexaLiteral
                          / BinaryLiteral
                          / FloatingLiteral
                          / UnsignedLiteral
                          / IntegerLiteral

    ScientificLiteral   <~ (FloatingLiteral / IntegerLiteral) ( ('e' / 'E' ) IntegerLiteral )
    FloatingLiteral     <~ IntegerLiteral ('.' UnsignedLiteral )
    UnsignedLiteral     <~ [0-9]+
    IntegerLiteral      <~ SignLiteral? UnsignedLiteral
    HexaLiteral         <~ "0x" [0-9a-fA-F]+
    BinaryLiteral       <~ "0b" [01] [01_]*
    SignLiteral         <- '-' / '+'

    Kword(K)            <- K !IdentChar

    VAL                 <- Kword("val")
    MUTABLE             <- Kword("mutable")
    DEF                 <- Kword("def")
    TYPE                <- Kword("type")
    NATIVE              <- Kword("native")
    WHILE               <- Kword("while")
    IF                  <- Kword("if")
    ELSE                <- Kword("else")
    TRUE                <- Kword("true")
    FALSE               <- Kword("false")
    RETURN              <- Kword("return")
    IMPORT              <- Kword("import")
    MODULE              <- Kword("module")

    Keyword             <- VAL / MUTABLE / DEF / TYPE / NATIVE / WHILE / IF / ELSE / TRUE / FALSE / RETURN / IMPORT / MODULE
    IdentChar           <- [a-zA-Z0-9_]
    Identifier          <- !Keyword ValueName

    # Case is significant: uppercase names are types and constructors, lowercase are values
    ValueName           <~ [a-z_] IdentChar*
    TypeName            <~ [A-Z] IdentChar*

    Spacing             <- :(' ' / '\t' / Comment)*

    # Line comments stop before the newline so it still acts as a separator.
    # Block comments nest, and any newlines inside them are not separators.
    Comment             <- LineComment / BlockComment
    LineComment         <- "//" (!eol .)*
    BlockComment        <- "/*" (BlockComment / !"*/" .)* "*/"
