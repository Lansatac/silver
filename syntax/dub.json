{
	"name": "syntax",
	"description": "Silver's parser.",
	"dependencies": {
		"pegged": "0.4.9",
		"silver:ast": "*"
	},
	"targetType": "library",
	"preGenerateCommands": [
		"dub run --single --quiet \"$PACKAGE_DIR/tools/generate_grammar.d\" -- \"$PACKAGE_DIR/source/silver/syntax/Silver.peg\" \"$PACKAGE_DIR/generated/silver/syntax/grammar.d\""
	],
	"importPaths": ["source", "generated"],
	"sourceFiles": ["generated/silver/syntax/grammar.d"],
	"configurations": [
		{
			"targetType": "library",
			"name": "library"
		},
		{
			"dependencies": {
				"silly": "~>1.2.0-dev.2",
				"fluent-asserts": "~>2.1"
			},
			"targetType": "library",
			"libs-windows": [
				"psapi"
			],
			"name": "unittest"
		}
	],
	"stringImportPaths": [
		"source/silver/syntax"
	]
}
